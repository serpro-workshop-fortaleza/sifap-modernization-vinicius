---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/model";

interface Props { locale: Locale }
const words = t(Astro.props.locale);
---
<figure class="hero-art">
  <div class="legacy-terminal" role="group" aria-label={words.terminalLabel}>
    <div class="legacy-terminal__bar">
      <span class="legacy-terminal__identity"><i aria-hidden="true"></i> SIFAP / 3270</span>
      <span>{words.terminalSimulation}</span>
    </div>
    <div class="legacy-terminal__screen">
      <div class="legacy-terminal__session"><span>NATURAL / ADABAS</span><span>SIFAPPRD</span></div>
      <p class="legacy-terminal__command"><span aria-hidden="true">&gt;</span> LOGON SIFAPPRD<br /><span aria-hidden="true">&gt;</span> CONSBENF</p>
      <div class="legacy-terminal__title">
        <strong>SIFAP</strong>
        <p>{words.terminalTitle}</p>
      </div>
      <dl class="legacy-terminal__fields">
        <div>
          <dt>{words.terminalSearchType}<small>C=CPF / N=NIS</small></dt>
          <dd>C</dd>
        </div>
        <div>
          <dt>CPF</dt>
          <dd><span aria-hidden="true"><span class="legacy-terminal__cursor"></span>__________</span><span class="sr-only">{words.terminalEmpty}</span></dd>
        </div>
        <div>
          <dt>NIS</dt>
          <dd><span aria-hidden="true">___________</span><span class="sr-only">{words.terminalEmpty}</span></dd>
        </div>
      </dl>
      <p class="legacy-terminal__message"><span aria-hidden="true">&gt;</span> {words.terminalReady}</p>
      <div class="legacy-terminal__keys">
        <span><kbd>ENTER</kbd> {words.terminalSubmit}</span>
        <span><kbd>PF3</kbd> {words.terminalExit}</span>
      </div>
    </div>
  </div>
  <figcaption class="hero-caption">
    <span>{words.terminalCaption}</span>
    <small>{words.terminalNotice}</small>
  </figcaption>
</figure>

<style>
  .legacy-terminal {
    overflow: hidden;
    border: 1px solid #3f5045;
    border-radius: 12px;
    background: #000;
    color: #a3f7ad;
    font: 12px/1.7 var(--he-font-mono);
    box-shadow: 0 24px 60px #0002, 0 2px 8px #0002;
    text-align: left;
  }
  .legacy-terminal__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 6px 12px;
    padding: 12px 18px;
    border-bottom: 1px solid #2e3b32;
    background: #111813;
    color: #b1c6b6;
    font-size: 10px;
  }
  .legacy-terminal__identity { display: inline-flex; align-items: center; gap: 9px; color: #e2eee5; }
  .legacy-terminal__identity i { width: 6px; height: 6px; background: #a3f7ad; box-shadow: 0 0 8px #a3f7ad66; }
  .legacy-terminal__screen { position: relative; isolation: isolate; padding: 22px; background: #000; }
  .legacy-terminal__screen::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, transparent 0 3px, #86efac08 3px 4px);
  }
  .legacy-terminal__session { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 14px; color: #8cae94; font-size: 10px; }
  .legacy-terminal__command { margin-block: 22px; color: #8cae94; }
  .legacy-terminal__command span { color: #a3f7ad; }
  .legacy-terminal__title { padding-bottom: 20px; border-bottom: 1px dashed #46654e; text-align: center; text-transform: uppercase; }
  .legacy-terminal__title strong { font-size: 26px; font-weight: 500; letter-spacing: .3em; text-shadow: 0 0 16px #a3f7ad44; }
  .legacy-terminal__title p { margin-top: 8px; letter-spacing: .05em; }
  .legacy-terminal__fields { display: grid; gap: 18px; margin-block: 24px 30px; }
  .legacy-terminal__fields > div { display: grid; grid-template-columns: minmax(0, 1fr) 12ch; align-items: baseline; gap: 12px; }
  .legacy-terminal__fields dt { text-transform: uppercase; }
  .legacy-terminal__fields small { display: block; color: #8cae94; font-size: 10px; white-space: nowrap; }
  .legacy-terminal__fields dd { margin: 0; color: #d3fbd9; white-space: nowrap; }
  .legacy-terminal__cursor { display: inline-block; width: 1ch; height: 1.1em; vertical-align: -.15em; background: currentColor; animation: terminal-cursor 1s step-end 4; }
  .legacy-terminal__message { margin-bottom: 18px; font-size: 11px; text-transform: uppercase; }
  .legacy-terminal__keys { display: flex; flex-wrap: wrap; gap: 12px 22px; padding-top: 14px; border-top: 1px dashed #46654e; color: #8cae94; font-size: 10px; text-transform: uppercase; }
  .legacy-terminal__keys kbd { color: #d3fbd9; font: inherit; }
  .hero-caption { display: grid; gap: 8px; margin-top: 22px; line-height: 1.7; letter-spacing: .02em; }
  .hero-caption small { font-size: 10px; letter-spacing: 0; }
  @keyframes terminal-cursor { 50% { opacity: 0; } }
  @media (max-width: 600px) {
    .legacy-terminal { font-size: 11px; }
    .legacy-terminal__screen { padding: 18px 16px; }
    .legacy-terminal__fields > div { gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .legacy-terminal__cursor { animation: none; }
  }
</style>
