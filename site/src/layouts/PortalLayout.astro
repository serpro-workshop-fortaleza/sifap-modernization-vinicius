---
import HeaderTools from "../components/HeaderTools";
import { counterpartHref, getCatalog, siteHref } from "../lib/catalog";
import { t } from "../lib/i18n";
import { localeCodes, type Locale } from "../lib/model";
import "../styles/tokens.css";
import "../styles/hub-editorial.css";
import "../styles/portal.css";
interface Props { locale: Locale; title: string; description?: string; path?: string; pageRoute?: string }
const { locale, title, description, path, pageRoute } = Astro.props;
const catalog = getCatalog();
const words = t(locale);
const languageLabels = { en: "EN", es: "ES", "pt-br": "PT-BR" };
const languageNames = { en: "English", es: "Español", "pt-br": "Português do Brasil" };
const alternate = (code: Locale) => path ? counterpartHref(code, path) : siteHref(code, pageRoute);
const currentUrl = new URL(Astro.url.pathname, catalog.siteUrl).href;
---
<!doctype html>
<html lang={locale === "pt-br" ? "pt-BR" : locale} data-he-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || words.heroLead} />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="no-referrer" />
    {catalog.audience === "instructor" && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} · SIFAP</title>
    <link rel="icon" type="image/svg+xml" href={`${catalog.basePath}favicon.svg`} />
    <link rel="canonical" href={currentUrl} />
    {localeCodes.map((code) => <link rel="alternate" hreflang={code} href={new URL(alternate(code), catalog.siteUrl).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternate("en"), catalog.siteUrl).href} />
  </head>
  <body class="he">
    <a class="he-skip" href="#main">{words.skip}</a>
    <header class="he-header portal-header" data-pagefind-ignore>
      <a class="he-brand" href={siteHref(locale)} aria-label={`SIFAP · ${words.home}`}>
        <span class="he-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="portal-brand-copy"><strong>SIFAP</strong><small>{catalog.audience === "instructor" ? words.privateKit : words.kit}</small></span>
      </a>
      <nav class="portal-nav" aria-label={words.navigation}>
        <a href={`${siteHref(locale)}#journey`}>{words.journey}</a>
        <a href={siteHref(locale, "library")}>{words.library}</a>
        <a href={`${siteHref(locale)}#personas`}>{words.personas}</a>
        <a href={`https://github.com/${catalog.repository}`}>GitHub ↗</a>
      </nav>
      <div class="portal-tools">
        <nav class="language-picker" aria-label={words.language}>
          {localeCodes.map((code) => <a href={alternate(code)} hreflang={code} lang={code} aria-current={code === locale ? "true" : undefined} aria-label={languageNames[code]}>{languageLabels[code]}</a>)}
        </nav>
        <HeaderTools locale={locale} basePath={catalog.basePath} client:load />
      </div>
      <details class="portal-mobile-nav"><summary>{words.menu}</summary><nav aria-label={words.navigation}>
        <a href={`${siteHref(locale)}#journey`}>{words.journey}</a><a href={siteHref(locale, "library")}>{words.library}</a>
        <a href={`${siteHref(locale)}#personas`}>{words.personas}</a><a href={`https://github.com/${catalog.repository}`}>{words.repository}</a>
      </nav></details>
    </header>
    {catalog.audience === "instructor" && <p class="privacy-note">{words.privateNotice}</p>}
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="he-footer" data-pagefind-ignore><div class="he-container">
      <h2>{words.footerTitle}</h2><p>{words.footerLead}</p>
      <div class="portal-footer-links">
        <a href={siteHref(locale, "library")}>{words.allFiles}</a>
        <a href={`https://github.com/${catalog.repository}`}>GitHub ↗</a>
        <a href="#main">{words.top} ↑</a>
        <a href={`${siteHref(locale, "library")}?path=site%2Fpublic%2Flicenses%2F`}>{words.licenses}</a>
      </div>
      <div class="he-footer__meta"><span>{words.builtWith}</span><span>{words.generated} · {catalog.generatedAt.slice(0, 10)}</span></div>
    </div></footer>
  </body>
</html>
