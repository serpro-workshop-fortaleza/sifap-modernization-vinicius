---
import { getCatalog, siteHref } from "../lib/catalog";
import PortalLayout from "../layouts/PortalLayout.astro";
const catalog = getCatalog();
---
<PortalLayout locale="en" title="Choose your language">
  <section class="he-section"><div class="he-container">
    <p class="he-label">SIFAP / Documentation</p>
    <h1 class="he-section__title">Choose your language.</h1>
    <p class="he-section__lead">Elige tu idioma. Escolha seu idioma.</p>
    <nav class="collection-grid" aria-label="Choose a complete edition">
      {catalog.editions.map((edition) => <a class="collection-card" href={siteHref(edition.code)} lang={edition.code}>
        <span class="card-type">{edition.code.toUpperCase()}</span>
        <h2>{edition.label} →</h2>
        <code>{edition.branch}</code>
      </a>)}
    </nav>
  </div></section>
</PortalLayout>
