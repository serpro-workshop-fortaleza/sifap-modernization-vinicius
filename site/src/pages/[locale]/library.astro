---
import PortalLayout from "../../layouts/PortalLayout.astro";
import Collection from "../../components/Collection";
import { getCatalogItems, getEdition } from "../../lib/catalog";
import { localeCodes, type Locale } from "../../lib/model";
import { t } from "../../lib/i18n";
export function getStaticPaths() { return localeCodes.map((locale) => ({ params: { locale }, props: { locale } })); }
interface Props { locale: Locale }
const { locale } = Astro.props;
const edition = getEdition(locale);
const words = t(locale);
const items = getCatalogItems(locale);
---
<PortalLayout locale={locale} title={words.library} pageRoute="library">
  <section class="he-section"><div class="he-container">
    <p class="he-label">{words.libraryLabel}</p><h1 class="he-section__title balanced">{words.libraryTitle}</h1><p class="he-section__lead">{words.libraryLead}</p>
    <Collection locale={locale} items={items} client:load />
    <noscript><ul>{edition.entries.map((entry) => <li><a href={entry.href}>{entry.title} · {entry.path}</a></li>)}</ul></noscript>
  </div></section>
</PortalLayout>
