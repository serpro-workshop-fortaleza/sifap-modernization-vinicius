---
import PortalLayout from "../../layouts/PortalLayout.astro";
import ReadingControls from "../../components/ReadingControls";
import { getCatalog, getEdition, siteHref } from "../../lib/catalog";
import { categories, t } from "../../lib/i18n";
import { categoryCodes, type Entry, type Locale } from "../../lib/model";
export function getStaticPaths() {
  return getCatalog().editions.flatMap((edition) => edition.entries.map((entry) => ({
    params: { locale: edition.code, route: decodeURIComponent(entry.route) },
    props: { locale: edition.code, entry },
  })));
}
interface Props { locale: Locale; entry: Entry }
const { locale, entry } = Astro.props;
const catalog = getCatalog();
const edition = getEdition(locale);
const words = t(locale);
const minuteCount = Math.max(1, Math.ceil((entry.text?.split(/\s+/).length ?? 0) / 220));
const kindLabel = { document: words.document, source: words.source, image: words.image, binary: words.binary }[entry.kind];
---
<PortalLayout locale={locale} title={entry.title} description={entry.description} path={entry.path}>
  <div class="document-shell">
    <aside class="doc-sidebar" aria-label={words.navigation} data-pagefind-ignore>
      <a href={siteHref(locale, "library")}>{words.allFiles} →</a>
      {categoryCodes.map((category) => {
        const group = edition.entries.filter((item) => item.kind === "document" && item.category === category);
        return group.length > 0 && <details open={category === entry.category}>
          <summary>{categories[locale][category]} <small>({group.length})</small></summary>
          {group.map((item) => <a href={item.href} aria-current={item.id === entry.id ? "page" : undefined}>{item.title}</a>)}
        </details>;
      })}
    </aside>
    <article class="doc-main" data-pagefind-body data-pagefind-filter={`language:${locale}`}>
      <nav class="breadcrumbs" aria-label={words.navigation} data-pagefind-ignore><a href={siteHref(locale)}>{words.home}</a><span>/</span><a href={siteHref(locale, "library")}>{categories[locale][entry.category]}</a><span>/</span><span>{entry.path}</span></nav>
      <h1 class="doc-title" data-pagefind-meta="title">{entry.title}</h1>
      <div class="doc-meta" data-pagefind-ignore><span>{kindLabel}</span><span>{entry.bytes.toLocaleString(locale)} {words.bytes}</span>{entry.kind === "document" && <span>{minuteCount} {words.minutes}</span>}<span>{edition.branch} · {edition.commit.slice(0, 8)}</span></div>
      <div class="doc-actions" data-pagefind-ignore>
        <a class="he-button" href={entry.sourceHref}>{words.original} ↗</a>
        <a class="he-button" href={entry.downloadHref} download={entry.path.split("/").at(-1)}>{words.download} ↓</a>
        {(entry.kind === "document" || entry.kind === "source") && <ReadingControls locale={locale} repository={catalog.repository} path={entry.path} downloadHref={entry.downloadHref} client:load />}
      </div>
      {entry.kind === "document" ? <div>
        <div class="doc-content" data-locale={locale} set:html={entry.html} />
        <details class="he-details" data-original-markdown data-pagefind-ignore><summary>{words.markdownSource}</summary><pre class="source-code"><code>{entry.text}</code></pre></details>
      </div> : <div class="doc-content">
        <p class="he-feedback">{words.technicalNote}</p>
        {entry.mediaHref && <img class="source-image" src={entry.mediaHref} alt={entry.title} />}
        {entry.text !== undefined && <pre class="source-code source-lines"><code set:html={entry.html} /></pre>}
        {entry.kind === "binary" && <p><a href={entry.downloadHref} download={entry.path.split("/").at(-1)}>{words.download} · {entry.bytes.toLocaleString(locale)} {words.bytes}</a></p>}
      </div>}
    </article>
    <aside class="doc-toc" aria-label={words.contents} data-pagefind-ignore><strong>{words.contents}</strong>
      {entry.headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
      <a href="#main">{words.top} ↑</a>
    </aside>
  </div>
  <script>
    import { renderDiagrams } from "../../scripts/diagrams";
    renderDiagrams();
  </script>
</PortalLayout>
