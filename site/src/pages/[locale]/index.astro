---
import PortalLayout from "../../layouts/PortalLayout.astro";
import HeroArt from "../../components/HeroArt.astro";
import StageExplorer from "../../components/StageExplorer";
import Collection from "../../components/Collection";
import { getCatalog, getCatalogItems, getEdition, siteHref } from "../../lib/catalog";
import { categories, t } from "../../lib/i18n";
import { localeCodes } from "../../lib/model";
export function getStaticPaths() { return localeCodes.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props;
const catalog = getCatalog();
const edition = getEdition(locale);
const words = t(locale);
function required(path: string) {
  const entry = edition.entries.find((item) => item.path === path);
  if (!entry) throw new Error(`Missing required home-page document ${locale}:${path}`);
  return entry;
}
const start = required("00-START-HERE.md");
const stagePaths = ["01-archaeology", "02-modern-spec", "03-implementation", "04-evolution"];
const stageCategories = ["archaeology", "specification", "implementation", "evolution"] as const;
const agentNames = ["@archaeologist", "@architect", "@builder", "@evolution"];
const stages = stagePaths.map((path, index) => {
  const entry = required(`${path}/GUIDE.md`);
  return { title: categories[locale][stageCategories[index]], description: entry.description, href: entry.href, agent: agentNames[index] };
});
const people = edition.entries.filter((entry) => /^05-personas\/[^/]+\/PERSONA\.md$/.test(entry.path));
const items = getCatalogItems(locale);
const terminalText = `$ git clone --branch ${edition.branch}\n  https://github.com/${catalog.repository}.git\n\n✓ ${edition.entries.length} ${words.files.toLowerCase()}\n✓ EN / ES / PT-BR\n↳ ${words.sourceCommit}: ${edition.commit.slice(0, 12)}`;
---
<PortalLayout locale={locale} title={catalog.audience === "instructor" ? words.privateKit : words.kit}>
  <section class="he-hero portal-hero"><div class="he-container">
    <div class="he-hero__layout">
      <div class="reveal"><p class="he-eyebrow">{words.heroEyebrow}</p><h1 class="he-hero__title balanced">{words.heroTitle}</h1>
        <p class="he-hero__lead">{words.heroLead}</p>
        <div class="he-actions"><a class="he-button he-button--primary" href={start.href}>{words.start} <span aria-hidden="true">↗</span></a><a class="he-button" href={siteHref(locale, "library")}>{words.explore} <span aria-hidden="true">→</span></a></div>
      </div>
      <HeroArt locale={locale} />
    </div>
    <div class="he-index"><div class="he-index__item"><strong>04</strong><span>{words.stages}</span></div>
      <div class="he-index__item"><strong>{edition.entries.length}</strong><span>{words.files}</span></div>
      <div class="he-index__item"><strong>03</strong><span>{words.languages}</span></div>
      <div class="he-index__item"><strong>29</strong><span>{words.years}</span></div></div>
  </div></section>
  <section class="he-section" id="journey"><div class="he-container">
    <p class="he-label">{words.journeyLabel}</p><h2 class="he-section__title balanced">{words.journeyTitle}</h2><p class="he-section__lead">{words.journeyLead}</p>
    <StageExplorer locale={locale} stages={stages} client:load />
    <noscript><ul>{stages.map((stage) => <li><a href={stage.href}>{stage.title}</a></li>)}</ul></noscript>
  </div></section>
  <section class="he-section he-section--alt" id="library"><div class="he-container">
    <p class="he-label">{words.libraryLabel}</p><h2 class="he-section__title balanced">{words.libraryTitle}</h2><p class="he-section__lead">{words.libraryLead}</p>
    <Collection locale={locale} items={items} initialLimit={9} client:visible />
    <div class="he-actions"><a class="he-button" href={siteHref(locale, "library")}>{words.allFiles} →</a></div>
  </div></section>
  <section class="he-section" id="personas"><div class="he-container">
    <p class="he-label">{words.personasLabel}</p><h2 class="he-section__title balanced">{words.personasTitle}</h2><p class="he-section__lead">{words.personasLead}</p>
    <div class="persona-grid">{people.map((person, index) => <a href={person.href}><small>{String(index + 1).padStart(2, "0")} / {words.personas}</small><strong>{person.title.replace(/^.*?[—:]\s*/, "")}</strong></a>)}</div>
  </div></section>
  <section class="he-section he-section--alt"><div class="he-container source-section">
    <div><p class="he-label">{words.sourceLabel}</p><h2 class="he-section__title balanced">{words.sourceTitle}</h2><p class="he-section__lead">{words.sourceLead}</p><a class="he-button" href={`https://github.com/${catalog.repository}/tree/${edition.branch}`}>{words.repository} ↗</a></div>
    <div class="terminal"><div class="terminal-bar"><i></i><i></i><i></i><span>git / {edition.branch}</span></div><pre><code>{terminalText}</code></pre></div>
  </div></section>
</PortalLayout>
