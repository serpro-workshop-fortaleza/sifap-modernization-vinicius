 T L DB Name                     F Leng  S D Remark
 - - -- ------------------------ - ----  - - ---------------------------
*
* --- EVENT IDENTIFICATION ---
*
   1 AA NUM-AUDIT                N   15    U UNIQUE SEQUENCE
   1 AB DT-EVENT                 N    8    D YYYYMMDD
   1 AC HR-EVENT                 N    6      HHMMSS
   1 AD TS-EVENT                 N   14  N   YYYYMMDDHHMMSS (PRECISION)
   1 AE NUM-TRANSACTION          A    8  N D CICS TRANSACTION (2003)
*
* --- ACTION ---
*
   1 BA COD-ACTION               A    2  F D ACTION TYPE
*                                             IN=INSERTION
*                                             AL=CHANGE
*                                             EX=DELETION
*                                             CO=QUERY
*                                             LG=LOGIN
*                                             LO=LOGOUT
*                                             BT=BATCH
*                                             ER=ERROR
*                                             AU=AUTHORIZATION
*                                             RE=REJECTION
   1 BB COD-MODULE               A    8  N   NATURAL PROGRAM NAME
   1 BC DESCR-ACTION             A   80  N   FREE-FORM ACTION DESCRIPTION
*
* --- AFFECTED ENTITY ---
*
   1 CA TYPE-ENTITY              A    4    D BENF/PGTO/PROG/ADMN/SIST
   1 CB ID-ENTITY                A   15    D ENTITY KEY
   1 CC NUM-CPF-AFFECTED         A   11  N D CPF (IF APPLICABLE)
*
* --- BEFORE/AFTER DATA (ADDED 2005) ---
*
 G 1 DA GRP-BEFORE                            PREVIOUS STATE GROUP
 M 2 DB FIELD-UPDATED-PREV       A   30  N   (1:20) FIELD NAME
 M 2 DC VALUE-PREV           A   80  N   (1:20) PREVIOUS VALUE
 G 1 DD GRP-AFTER                           SUBSEQUENT STATE GROUP
 M 2 DE FIELD-UPDATED-AFTER       A   30  N   (1:20) FIELD NAME
 M 2 DF VALUE-AFTER          A   80  N   (1:20) SUBSEQUENT VALUE
   1 DG AMT-PREV                 A   60  N   SCALAR - COEXISTS WITH DC
*                                             (ADDED 2014)
   1 DH AMT-NEW                  A   60  N   SCALAR - COEXISTS WITH DF
*                                             (ADDED 2014)
*
* --- USER AND SOURCE ---
*
   1 EA USR-EVENT                A    8    D LOGIN NATURAL
   1 EB NAME-USER                A   40  N   FULL NAME
   1 EC COD-PROFILE              A    3  N   ADM/OPR/CON/AUD/SUP
   1 ED COD-ASSIGNMENT           A   10  N   ORGANIZATIONAL UNIT CODE
   1 EE IP-ORIGIN                A   15  N   TERMINAL IP (ADDED 2012)
   1 EF ID-SESSION               A   20  N   SESSION IDENTIFIER
   1 EG COD-TERMINAL             A    8  N D TERMINAL 3270 (1998)
   1 EH COD-LU                   A    8  N   VTAM LU NAME (1998)
*
* --- BATCH CONTEXT (IF BT) ---
*
   1 FA NUM-CYCLE-BATCH          N    6  N   PROCESSING CYCLE
   1 FB NUM-SEQ-BATCH            N   10  N   SEQUENCE WITHIN CYCLE
   1 FC NAME-JOB-BATCH           A   16  N   JES2/JCL JOB NAME
   1 FD STAT-BATCH               A    1  F   S=SUCCESS E=ERROR W=WARNING
   1 FE DESCR-ERR-BATCH          A  120  N   ERROR MSG (IF APPLICABLE)
*
* --- CORRELATION (TO TRACK COMPOSITE OPERATIONS) ---
*
   1 GA ID-CORRELATION           A   36  N   COMPOSITE OPERATION UUID
   1 GB NUM-SEQ-CORRELATION      N    3  N   SEQUENCE WITHIN OPERATION
*
* --- DERIVED DESCRIPTORS ---
*
 S   SA YEAR-MONTH-EVENT           N    6    D SUBDESCRIPTOR (2010)
        /* AB(1-6)
 S   S1 SUPER-DATE-ACTION          A   10    S
        /* AB(1-8), BA(1-2)
 S   S2 SUPER-ENTITY-DATE         A   27    S
        /* CA(1-4), CB(1-15), AB(1-8)
 S   S3 SUPER-USR-DATE           A   16    S
        /* EA(1-8), AB(1-8)
*
* COLUMN LEGEND
*   T  = TYPE      (BLANK)=ELEMENTARY  G=GROUP  M=MULTIPLE-VALUE
