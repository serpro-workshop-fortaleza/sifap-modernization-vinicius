* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM:  CALCCORR
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   PATRICIA GOMES DE SOUZA
* DATE:     12/07/2001
* CHANGED:  20/01/2006 - PATRICIA GOMES - NEW IPCA INDICES
* CHANGED:  15/08/2014 - ANDERSON LIMA  - ADJUSTED PERIOD
* CHANGED:  14/06/2016 - SUPDE TEAM - TICKET 7210 DDM STANDARD
* PURPOSE:  CALCULATE RETROACTIVE PAYMENT CORRECTIONS
*           RECALCULATE BY IPCA INDEX VARIATION - FILE 160
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING PDAVALID
LOCAL USING LDASIFAP
LOCAL
  1 PAYMENT-V VIEW OF PAYMENT
    2 NUM-PAYMENT         (N15)
    2 NUM-CPF             (A11)
    2 YEAR-MONTH-REF      (N6)
    2 AMT-GROSS           (P9.2)
    2 AMT-DISC-TOTAL      (P7.2)
    2 AMT-NET             (P9.2)
    2 DT-GENERATION       (N8)
    2 STAT-PAYMENT        (A1)
    2 AMT-CORR            (P9.2)
    2 DT-CORR             (N8)
    2 IND-CORR            (A1)
*
* VIEW REQUIRED BY COPYCODE CCAUDIT - FILE 153
  1 AUDIT-V VIEW OF AUDIT
    2 NUM-AUDIT           (N15)
    2 DT-EVENT            (N8)
    2 HR-EVENT            (N6)
    2 TS-EVENT            (N14)
    2 COD-ACTION          (A2)
    2 COD-MODULE          (A8)
    2 DESCR-ACTION        (A80)
    2 TYPE-ENTITY         (A4)
    2 ID-ENTITY           (A15)
    2 NUM-CPF-AFFECTED    (A11)
    2 USR-EVENT           (A8)
    2 NAME-JOB-BATCH      (A16)
    2 STAT-BATCH          (A1)
*
  1 #CPF                  (N11)
  1 #CPF-STR              (A11)
  1 #PERIOD-START         (N6)
  1 #PERIOD-END           (N6)
  1 #DT-TODAY             (N8)
  1 #AMT-ORIG             (P9.2)
  1 #AMT-CORR             (P9.2)
  1 #AMT-DIFF             (P9.2)
  1 #AMT-TOTAL-CORRECTION (P11.2)
  1 #AMT-TEMP             (N11)
  1 #INDEX-ACCUM          (N5.6)
  1 #INDEX-MONTH          (N3.6)
  1 #MONTH-REF            (N2)
  1 #YEAR-REF             (N4)
  1 #PERIOD-CURRENT       (N6)
  1 #QTY-REC              (N5)
  1 #MSG                  (A60)
  1 #K                    (N2)
  1 #YEAR-C               (N4)
  1 #MONTH-C              (N2)
*
* FIELDS REQUIRED BY COPYCODE CCAUDIT
  1 #AUD-ACTION           (A2)
  1 #AUD-ENTITY           (A4)
  1 #AUD-ID               (A15)
  1 #AUD-CPF              (A11)
  1 #AUD-DESCR            (A80)
  1 #AUD-SEQ              (N15)
  1 #AUD-TIMN             (N7)
*
* IPCA TABLE - MONTHLY INDICES (BASE: JAN-DEC)
* LAST LOAD: 2014
  1 #IPCA-TAB             (N3.6/1:12)
*
* AVAILABLE YEARS TABLE
  1 #YEAR-TAB             (N4/1:10)
  1 #IPCA-YEAR            (N3.6/1:10,1:12)
END-DEFINE
*
MOVE *DATN TO #DT-TODAY
*
* LOAD IPCA TABLE - MONTHLY VALUES BY YEAR
* YEAR 2010
MOVE 2010 TO #YEAR-TAB(1)
MOVE 0.0075 TO #IPCA-YEAR(1,1)   /* JAN */
MOVE 0.0078 TO #IPCA-YEAR(1,2)   /* FEB */
MOVE 0.0052 TO #IPCA-YEAR(1,3)   /* MAR */
MOVE 0.0057 TO #IPCA-YEAR(1,4)   /* APR */
MOVE 0.0043 TO #IPCA-YEAR(1,5)   /* MAY */
MOVE 0.0000 TO #IPCA-YEAR(1,6)   /* JUN */
MOVE 0.0001 TO #IPCA-YEAR(1,7)   /* JUL */
MOVE 0.0004 TO #IPCA-YEAR(1,8)   /* AUG */
MOVE 0.0045 TO #IPCA-YEAR(1,9)   /* SEP */
MOVE 0.0075 TO #IPCA-YEAR(1,10)  /* OCT */
MOVE 0.0083 TO #IPCA-YEAR(1,11)  /* NOV */
MOVE 0.0063 TO #IPCA-YEAR(1,12)  /* DEC */
* YEAR 2011
MOVE 2011 TO #YEAR-TAB(2)
MOVE 0.0083 TO #IPCA-YEAR(2,1)
MOVE 0.0080 TO #IPCA-YEAR(2,2)
MOVE 0.0079 TO #IPCA-YEAR(2,3)
MOVE 0.0077 TO #IPCA-YEAR(2,4)
MOVE 0.0047 TO #IPCA-YEAR(2,5)
MOVE 0.0015 TO #IPCA-YEAR(2,6)
MOVE 0.0016 TO #IPCA-YEAR(2,7)
MOVE 0.0037 TO #IPCA-YEAR(2,8)
MOVE 0.0053 TO #IPCA-YEAR(2,9)
MOVE 0.0043 TO #IPCA-YEAR(2,10)
MOVE 0.0052 TO #IPCA-YEAR(2,11)
MOVE 0.0050 TO #IPCA-YEAR(2,12)
* YEAR 2012
MOVE 2012 TO #YEAR-TAB(3)
MOVE 0.0056 TO #IPCA-YEAR(3,1)
MOVE 0.0045 TO #IPCA-YEAR(3,2)
MOVE 0.0021 TO #IPCA-YEAR(3,3)
MOVE 0.0064 TO #IPCA-YEAR(3,4)
MOVE 0.0036 TO #IPCA-YEAR(3,5)
MOVE 0.0008 TO #IPCA-YEAR(3,6)
MOVE 0.0043 TO #IPCA-YEAR(3,7)
MOVE 0.0041 TO #IPCA-YEAR(3,8)
MOVE 0.0054 TO #IPCA-YEAR(3,9)
MOVE 0.0059 TO #IPCA-YEAR(3,10)
MOVE 0.0060 TO #IPCA-YEAR(3,11)
MOVE 0.0079 TO #IPCA-YEAR(3,12)
*
* --------------------------------------------------------
* COMMENTED BLOCK - DO NOT REMOVE (HISTORICAL)
* VERAO PLAN CORRECTION - PERIOD 01/1989 TO 01/1991
* USED DURING CRUZADO->CRUZEIRO CURRENCY TRANSITION
* OWNER: JOAO BATISTA - 15/03/2003
* --------------------------------------------------------
*  IF #PERIOD-START >= 198901 AND #PERIOD-START <= 199101
*    COMPUTE #INDEX-ACCUM = #INDEX-ACCUM * 2.7500
*    IF #PERIOD-START < 198907
*      COMPUTE #INDEX-ACCUM = #INDEX-ACCUM * 1.4289
*    END-IF
*    MOVE 'V' TO PAYMENT-V.IND-CORR
*  END-IF
* --------------------------------------------------------
*
INPUT 'SIFAP - RETROACTIVE CORRECTION' /
      '==============================' /
      'BENEFICIARY CPF.:' #CPF /
      'START PERIOD....:' #PERIOD-START /
      'END PERIOD......:' #PERIOD-END
*
IF #PERIOD-START > #PERIOD-END
  WRITE 'INVALID PERIOD - START PERIOD > END PERIOD'
  ESCAPE ROUTINE
END-IF
*
* CPF VALIDATION - CORPORATE ROUTINE (TICKET 7210)
MOVE 'C' TO #PV-TYPE-DOC
MOVE EDITED #CPF (EM=99999999999) TO #PV-CPF
RESET #PV-NIS
CALLNAT 'SUBVALCP' #PV-TYPE-DOC #PV-CPF #PV-NIS
                   #PV-COD-RETURN #PV-MSG
                   #PV-IND-SPECIAL
IF #PV-COD-RETURN NE 0
  MOVE #PV-MSG TO #MSG
  WRITE 'INVALID CPF -' #MSG
  ESCAPE ROUTINE
END-IF
MOVE #PV-CPF TO #CPF-STR
*
MOVE 0 TO #AMT-TOTAL-CORRECTION
MOVE 0 TO #QTY-REC
*
* PROCESS PAYMENTS FOR THE PERIOD
READ PAYMENT-V BY NUM-CPF = #CPF-STR
  IF PAYMENT-V.NUM-CPF NE #CPF-STR
    ESCAPE BOTTOM
  END-IF
*
  IF PAYMENT-V.YEAR-MONTH-REF < #PERIOD-START
    ESCAPE TOP
  END-IF
  IF PAYMENT-V.YEAR-MONTH-REF > #PERIOD-END
    ESCAPE BOTTOM
  END-IF
*
  IF PAYMENT-V.IND-CORR = 'S'
    ESCAPE TOP
  END-IF
*
* CALCULATE ACCUMULATED INDEX FOR THE PERIOD
  MOVE PAYMENT-V.AMT-GROSS TO #AMT-ORIG
  MOVE 1.000000 TO #INDEX-ACCUM
  MOVE PAYMENT-V.YEAR-MONTH-REF TO #PERIOD-CURRENT
*
  PERFORM CALC-INDEX-ACCUM
*
* APPLY CORRECTION
  COMPUTE #AMT-CORR = #AMT-ORIG * #INDEX-ACCUM
* TRUNCATE
  COMPUTE #AMT-TEMP = #AMT-CORR * 100
  COMPUTE #AMT-CORR = #AMT-TEMP / 100
  COMPUTE #AMT-DIFF = #AMT-CORR - #AMT-ORIG
*
  IF #AMT-DIFF > 0
    MOVE #AMT-CORR   TO PAYMENT-V.AMT-CORR
    MOVE #DT-TODAY     TO PAYMENT-V.DT-CORR
    MOVE 'S'          TO PAYMENT-V.IND-CORR
    UPDATE PAYMENT-V
    END TRANSACTION
* AUDIT TRAIL - TICKET 7210
    MOVE 'AL'                  TO #AUD-ACTION
    MOVE 'PGTO'                TO #AUD-ENTITY
    MOVE #CPF-STR              TO #AUD-ID
    MOVE #CPF-STR              TO #AUD-CPF
    MOVE 'RETROACTIVE IPCA CORRECTION' TO #AUD-DESCR
    PERFORM WRITE-AUDIT
    ADD #AMT-DIFF TO #AMT-TOTAL-CORRECTION
    ADD 1 TO #QTY-REC
  END-IF
*
END-READ
*
WRITE 'RETROACTIVE CORRECTION COMPLETED' /
      '================================' /
      'RECORDS CORRECTED.:' #QTY-REC /
      'TOTAL CORRECTION..:' #AMT-TOTAL-CORRECTION
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE CALC-INDEX-ACCUM
  COMPUTE #YEAR-C = #PERIOD-CURRENT / 100
  COMPUTE #MONTH-C = #PERIOD-CURRENT - (#YEAR-C * 100)
* FIND INDEX IN TABLE
  FOR #K = 1 TO 10
    IF #YEAR-TAB(#K) = #YEAR-C
      COMPUTE #INDEX-ACCUM = #INDEX-ACCUM * (1 + #IPCA-YEAR(#K,#MONTH-C))
      ESCAPE BOTTOM
    END-IF
  END-FOR
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* CORPORATE AUDIT TRAIL ROUTINE - FILE 153
INCLUDE CCAUDIT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* NATURAL ERROR HANDLING - TICKET 7210
ON ERROR
  WRITE 'NATURAL ERROR' *ERROR-NR
        'LINE'          *ERROR-LINE
        'PGM'          *PROGRAM
  BACKOUT TRANSACTION
  TERMINATE 12
END-ERROR
*
END
