* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM:  CADBENEF
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   CARLOS ROBERTO DA SILVA
* DATE:     15/03/1997
* CHANGED:  22/08/2005 - MARCIA HELENA - ADDED CPF VALIDATION
* CHANGED:  10/01/2011 - JOSE FERREIRA - ADJUSTED ELDERLY STATUS
* CHANGED:  07/06/2011 - ROBERTO MENDES - ADDED VALIDATION CALLNAT
* CHANGED:  12/09/2012 - ANDERSON LIMA  - ADDED AUDIT TRAIL
* PURPOSE:  BENEFICIARY REGISTRATION - ADD/UPDATE
*           MAINTAIN REGISTRATION DATA IN FILE 150
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING PDAVALID
LOCAL
  1 BENEFICIARY-V VIEW OF BENEFIC
    2 NUM-CPF                (A11)
    2 FULL-NAME              (A60)
    2 DT-BIRTH               (N8)
    2 SEX                    (A1)
    2 GRP-ADDRESS
      3 STREET-ADDRESS         (A60)
      3 DISTRICT               (A40)
      3 CITY                   (A40)
      3 UF                     (A2)
      3 CEP                    (N8)
    2 PHONE-MOBILE           (A15)
    2 RG-NUMBER              (A15)
    2 STAT-BENEFICIARY       (A1)
    2 COD-PROGRAM            (A4)
    2 AMT-FAMILY-INCOME      (P9.2)
    2 QTY-DEPEND             (N2)
    2 DT-REGISTRATION        (N8)
    2 DT-LAST-UPDATE         (N8)
    2 COD-REGION             (A2)
    2 NUM-NIS                (N11)
*
* AUDIT TRAIL - FILE 153 - IN-TCU 63/2010
  1 AUDIT-V VIEW OF AUDIT
    2 NUM-AUDIT              (N15)
    2 DT-EVENT               (N8)
    2 HR-EVENT               (N6)
    2 TS-EVENT               (N14)
    2 COD-ACTION             (A2)
    2 COD-MODULE             (A8)
    2 DESCR-ACTION           (A80)
    2 TYPE-ENTITY            (A4)
    2 ID-ENTITY              (A15)
    2 NUM-CPF-AFFECTED       (A11)
    2 USR-EVENT              (A8)
    2 NAME-JOB-BATCH         (A16)
    2 STAT-BATCH             (A1)
*
  1 #CPF                   (N11)
  1 #NAME                  (A60)
  1 #DT-BIRTH              (N8)
  1 #SEX                   (A1)
  1 #ADDRESS               (A80)
  1 #CITY                  (A40)
  1 #UF                    (A2)
  1 #CEP                   (N8)
  1 #PHONE                 (A15)
  1 #RG                    (A15)
  1 #STATUS                (A1)
  1 #COD-PROG              (N4)
  1 #FAMILY-INCOME         (P9.2)
  1 #NUM-DEPEND            (N2)
  1 #COD-REGION            (N2)
  1 #NIS                   (N11)
*
  1 #OPER                  (A1)    /* I=ADD A=UPDATE */
  1 #DT-TODAY              (N8)
  1 #YEAR-CURRENT          (N4)
  1 #YEAR-BIRTH            (N4)
  1 #AGE                   (N3)
  1 #MSG                   (A60)
  1 #ERR                   (L)
  1 #CPF-VALID             (L)
  1 #FOUND                 (L)
*
* CORPORATE VALIDATION RESULT - CALLNAT VALBENEF
  1 #RESULT                (A1)
  1 #QTY-ERRS              (N2)
  1 #MSG-ERR               (A60/1:10)
*
* AUDIT TRAIL FIELDS - CCAUDIT
  1 #AUD-ACTION            (A2)
  1 #AUD-ENTITY            (A4)
  1 #AUD-ID                (A15)
  1 #AUD-CPF               (A11)
  1 #AUD-DESCR             (A80)
  1 #AUD-SEQ               (N15)
  1 #AUD-TIMN              (N7)
*
* VARIABLES FOR CPF VALIDATION
  1 #CPF-STR               (A11)
  1 #DIG                   (N1/1:11)
  1 #SUM                   (N5)
  1 #REMAIN                (N3)
  1 #DV1                   (N1)
  1 #DV2                   (N1)
  1 #WEIGHT                (N2)
  1 #I                     (N2)
END-DEFINE
*
* GET CURRENT DATE
MOVE *DATN TO #DT-TODAY
* TICKET 6622/2011 - YEAR EXTRACTION CORRECTED
* (USED DIVIDE WITH REMAINDER IN THE SAME VARIABLE)
COMPUTE #YEAR-CURRENT = #DT-TODAY / 10000
*
* FLOW CONTROL - TICKET 6622/2011
* OUTER REPEAT ENABLES EARLY EXIT FROM VALIDATIONS
* (ESCAPE BOTTOM) WITHOUT REWRITING THE RULES
REPEAT
*
INPUT 'SIFAP - BENEFICIARY REGISTRATION' /
      '=================================' /
      'OPERATION (I/A):' #OPER /
      'CPF...........:' #CPF /
      'NAME..........:' #NAME /
      'BIRTH DATE....:' #DT-BIRTH '(YYYYMMDD)' /
      'SEX...........:' #SEX '(M/F)' /
      'ADDRESS.......:' #ADDRESS (AL=60) /
      'CITY..........:' #CITY /
      'STATE.........:' #UF /
      'ZIP CODE......:' #CEP /
      'PHONE.........:' #PHONE /
      'RG............:' #RG /
      'PROGRAM CODE..:' #COD-PROG /
      'FAMILY INCOME.:' #FAMILY-INCOME /
      'DEPENDENT COUNT:' #NUM-DEPEND /
      'REGION CODE...:' #COD-REGION /
      'NIS...........:' #NIS
*
* BASIC VALIDATION
MOVE FALSE TO #ERR
*
IF #OPER NE 'I' AND #OPER NE 'A'
  MOVE 'INVALID OPERATION - ENTER I OR A' TO #MSG
  MOVE TRUE TO #ERR
  ESCAPE BOTTOM
END-IF
*
IF #CPF = 0
  MOVE 'CPF IS REQUIRED' TO #MSG
  MOVE TRUE TO #ERR
  ESCAPE BOTTOM
END-IF
*
* CPF VALIDATION - MOD 11 ALGORITHM
PERFORM VALID-CPF
* ============================================
* CPF VALIDATION BY CORPORATE ROUTINE
* TICKET 6620/2011 - INTERNAL ROUTINE ABOVE
* RETAINED PENDING BENEFITS DEPARTMENT REVIEW
* ============================================
MOVE 'C' TO #PV-TYPE-DOC
MOVE EDITED #CPF (EM=99999999999) TO #PV-CPF
RESET #PV-NIS
CALLNAT 'SUBVALCP' #PV-TYPE-DOC #PV-CPF #PV-NIS
                   #PV-COD-RETURN #PV-MSG
                   #PV-IND-SPECIAL
IF NOT #CPF-VALID
  MOVE 'INVALID CPF - INCORRECT CHECK DIGIT' TO #MSG
  MOVE TRUE TO #ERR
  ESCAPE BOTTOM
END-IF
*
IF #NAME = ' '
  MOVE 'NAME IS REQUIRED' TO #MSG
  MOVE TRUE TO #ERR
  ESCAPE BOTTOM
END-IF
*
IF #DT-BIRTH = 0
  MOVE 'BIRTH DATE IS REQUIRED' TO #MSG
  MOVE TRUE TO #ERR
  ESCAPE BOTTOM
END-IF
*
IF #SEX NE 'M' AND #SEX NE 'F'
  MOVE 'INVALID SEX' TO #MSG
  MOVE TRUE TO #ERR
  ESCAPE BOTTOM
END-IF
*
* ============================================
* NIS/PIS VALIDATION - TICKET 6621/2011
* WARNING MODE - DOES NOT BLOCK SAVING PENDING
* BENEFITS DEPARTMENT REVIEW
* ============================================
MOVE 'N' TO #PV-TYPE-DOC
RESET #PV-CPF
MOVE EDITED #NIS (EM=99999999999) TO #PV-NIS
CALLNAT 'SUBVALNI' #PV-TYPE-DOC #PV-CPF #PV-NIS
                   #PV-COD-RETURN #PV-MSG
                   #PV-IND-SPECIAL
IF #PV-COD-RETURN NE 0
  WRITE 'WARNING -' #PV-MSG
END-IF
*
* CHECK WHETHER BENEFICIARY EXISTS - READ FILE 150
* CPF IS ALPHANUMERIC IN FILE 150 (AB NUM-CPF A11)
MOVE EDITED #CPF (EM=99999999999) TO #CPF-STR
FIND BENEFICIARY-V WITH NUM-CPF = #CPF-STR
  IF NO RECORDS FOUND
    MOVE FALSE TO #FOUND
  END-NOREC
  MOVE TRUE TO #FOUND
END-FIND
*
IF #OPER = 'I' AND #FOUND
  MOVE 'BENEFICIARY ALREADY REGISTERED' TO #MSG
  MOVE TRUE TO #ERR
  ESCAPE BOTTOM
END-IF
*
IF #OPER = 'A' AND NOT #FOUND
  MOVE 'BENEFICIARY NOT FOUND FOR UPDATE' TO #MSG
  MOVE TRUE TO #ERR
  ESCAPE BOTTOM
END-IF
*
* CALCULATE BENEFICIARY AGE
* ============================================
* Y2K - REMEDIATION 08/1998 - BUG2000 PROJECT
* TEAM: R.SOUZA - TICKET 1998/0442
* UNTIL 07/1998 THE DATE ARRIVED AS YYMMDD AND THE YEAR
* WAS EXPANDED USING THE CENTURY WINDOW BELOW:
*    MOVE #DT-BIRTH TO #AA-SHORT
*    IF #AA-SHORT < 50
*      COMPUTE #YEAR-BIRTH = 2000 + #AA-SHORT
*    ELSE
*      COMPUTE #YEAR-BIRTH = 1900 + #AA-SHORT
*    END-IF
* FIELD CONVERTED TO YYYYMMDD IN 08/1998
* WINDOW RETAINED IN LDASIFAP FOR HISTORICAL FILES
* ============================================
* TICKET 6622/2011 - YEAR EXTRACTION CORRECTED
COMPUTE #YEAR-BIRTH = #DT-BIRTH / 10000
COMPUTE #AGE = #YEAR-CURRENT - #YEAR-BIRTH
*
* SET INITIAL STATUS
IF #OPER = 'I'
  MOVE 'A' TO #STATUS
END-IF
*
* ADJUST FOR BENEFICIARIES OVER 75 YEARS OLD
IF #AGE > 75
  MOVE 'S' TO #STATUS
END-IF
*
IF #ERR
  ESCAPE BOTTOM
END-IF
*
* ============================================
* CORPORATE REGISTRATION VALIDATION - VALBENEF
* TICKET 6620/2011 - WARNING MODE PENDING BENEFITS
* DEPARTMENT REVIEW - DOES NOT BLOCK
* ============================================
CALLNAT 'VALBENEF' #CPF-STR #NAME #DT-BIRTH #SEX #UF #CEP
                   #STATUS #RESULT #QTY-ERRS
                   #MSG-ERR(*)
IF #RESULT = 'I'
  WRITE 'WARNING - REGISTRATION VALIDATION:' #QTY-ERRS 'ERROR(S)'
END-IF
*
* SAVE / UPDATE - FILE 150
DECIDE ON FIRST VALUE OF #OPER
  VALUE 'I'
    MOVE #CPF-STR    TO BENEFICIARY-V.NUM-CPF
    MOVE #NAME       TO BENEFICIARY-V.FULL-NAME
    MOVE #DT-BIRTH    TO BENEFICIARY-V.DT-BIRTH
    MOVE #SEX       TO BENEFICIARY-V.SEX
* TICKET 4471/2003 - A80 ADDRESS SAVED IN
* A60 STREET FIELD - LAST 20 BYTES ARE LOST
    MOVE #ADDRESS   TO BENEFICIARY-V.STREET-ADDRESS
    MOVE #CITY  TO BENEFICIARY-V.CITY
    MOVE #UF         TO BENEFICIARY-V.UF
    MOVE #CEP        TO BENEFICIARY-V.CEP
    MOVE #PHONE   TO BENEFICIARY-V.PHONE-MOBILE
    MOVE #RG         TO BENEFICIARY-V.RG-NUMBER
    MOVE #STATUS     TO BENEFICIARY-V.STAT-BENEFICIARY
    MOVE EDITED #COD-PROG (EM=9999)
                     TO BENEFICIARY-V.COD-PROGRAM
    MOVE #FAMILY-INCOME  TO BENEFICIARY-V.AMT-FAMILY-INCOME
    MOVE #NUM-DEPEND    TO BENEFICIARY-V.QTY-DEPEND
    MOVE #DT-TODAY    TO BENEFICIARY-V.DT-REGISTRATION
    MOVE #DT-TODAY    TO BENEFICIARY-V.DT-LAST-UPDATE
    MOVE EDITED #COD-REGION (EM=99)
                     TO BENEFICIARY-V.COD-REGION
    MOVE #NIS        TO BENEFICIARY-V.NUM-NIS
    STORE BENEFICIARY-V
* AUDIT TRAIL - TICKET 5510/2012
    MOVE 'IN'                  TO #AUD-ACTION
    MOVE 'BENF'                TO #AUD-ENTITY
    MOVE #CPF-STR              TO #AUD-ID
    MOVE #CPF-STR              TO #AUD-CPF
    MOVE 'REGISTRATION CREATED' TO #AUD-DESCR
    PERFORM WRITE-AUDIT
    END TRANSACTION
    WRITE 'BENEFICIARY ADDED SUCCESSFULLY'
  VALUE 'A'
    FIND BENEFICIARY-V WITH NUM-CPF = #CPF-STR
      MOVE #NAME       TO BENEFICIARY-V.FULL-NAME
      MOVE #ADDRESS   TO BENEFICIARY-V.STREET-ADDRESS
      MOVE #CITY  TO BENEFICIARY-V.CITY
      MOVE #UF         TO BENEFICIARY-V.UF
      MOVE #CEP        TO BENEFICIARY-V.CEP
      MOVE #PHONE   TO BENEFICIARY-V.PHONE-MOBILE
      MOVE #RG         TO BENEFICIARY-V.RG-NUMBER
      MOVE #STATUS     TO BENEFICIARY-V.STAT-BENEFICIARY
      MOVE #FAMILY-INCOME  TO BENEFICIARY-V.AMT-FAMILY-INCOME
      MOVE #NUM-DEPEND    TO BENEFICIARY-V.QTY-DEPEND
      MOVE #DT-TODAY    TO BENEFICIARY-V.DT-LAST-UPDATE
      UPDATE BENEFICIARY-V
* AUDIT TRAIL - TICKET 5510/2012
      MOVE 'AL'                   TO #AUD-ACTION
      MOVE 'BENF'                 TO #AUD-ENTITY
      MOVE #CPF-STR               TO #AUD-ID
      MOVE #CPF-STR               TO #AUD-CPF
      MOVE 'REGISTRATION UPDATED' TO #AUD-DESCR
      PERFORM WRITE-AUDIT
      END TRANSACTION
    END-FIND
    WRITE 'BENEFICIARY UPDATED SUCCESSFULLY'
  NONE
    WRITE 'INVALID OPERATION'
END-DECIDE
*
* NORMAL EXIT - TICKET 6622/2011
ESCAPE BOTTOM
END-REPEAT
*
IF #ERR
  WRITE #MSG
END-IF
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* SUBROUTINE: CPF VALIDATION - MODULUS 11
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALID-CPF
  MOVE TRUE TO #CPF-VALID
  MOVE #CPF TO #CPF-STR
*
* EXTRACT DIGITS
  FOR #I = 1 TO 11
    DECIDE ON FIRST VALUE OF SUBSTR(#CPF-STR,#I,1)
      VALUE '0'
        MOVE 0 TO #DIG(#I)
      VALUE '1'
        MOVE 1 TO #DIG(#I)
      VALUE '2'
        MOVE 2 TO #DIG(#I)
      VALUE '3'
        MOVE 3 TO #DIG(#I)
      VALUE '4'
        MOVE 4 TO #DIG(#I)
      VALUE '5'
        MOVE 5 TO #DIG(#I)
      VALUE '6'
        MOVE 6 TO #DIG(#I)
      VALUE '7'
        MOVE 7 TO #DIG(#I)
      VALUE '8'
        MOVE 8 TO #DIG(#I)
      VALUE '9'
        MOVE 9 TO #DIG(#I)
      NONE VALUE
        MOVE FALSE TO #CPF-VALID
        ESCAPE ROUTINE
    END-DECIDE
  END-FOR
*
* FIRST CHECK DIGIT
  MOVE 0 TO #SUM
  MOVE 10 TO #WEIGHT
  FOR #I = 1 TO 9
    COMPUTE #SUM = #SUM + (#DIG(#I) * #WEIGHT)
    SUBTRACT 1 FROM #WEIGHT
  END-FOR
  COMPUTE #REMAIN = #SUM - ((#SUM / 11) * 11)
  IF #REMAIN < 2
    MOVE 0 TO #DV1
  ELSE
    COMPUTE #DV1 = 11 - #REMAIN
  END-IF
*
  IF #DV1 NE #DIG(10)
    MOVE FALSE TO #CPF-VALID
    ESCAPE ROUTINE
  END-IF
*
* SECOND CHECK DIGIT
  MOVE 0 TO #SUM
  MOVE 11 TO #WEIGHT
  FOR #I = 1 TO 10
    COMPUTE #SUM = #SUM + (#DIG(#I) * #WEIGHT)
    SUBTRACT 1 FROM #WEIGHT
  END-FOR
  COMPUTE #REMAIN = #SUM - ((#SUM / 11) * 11)
  IF #REMAIN < 2
    MOVE 0 TO #DV2
  ELSE
    COMPUTE #DV2 = 11 - #REMAIN
  END-IF
*
  IF #DV2 NE #DIG(11)
    MOVE FALSE TO #CPF-VALID
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* AUDIT TRAIL - IN-TCU 63/2010 - TICKET 5510
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
INCLUDE CCAUDIT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* NATURAL ERROR HANDLING - TICKET 5511/2012
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  WRITE 'NATURAL ERROR' *ERROR-NR 'LINE' *ERROR-LINE
  WRITE 'PGM' *PROGRAM 'LIB' *LIBRARY-ID
  BACKOUT TRANSACTION
  TERMINATE 12
END-ERROR
*
END
