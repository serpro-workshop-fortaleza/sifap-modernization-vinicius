* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* SUBPROGRAM: VALELEG
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   JOSE FERREIRA DOS SANTOS
* DATE:     03/02/1999
* CHANGED:  28/07/2004 - PATRICIA GOMES - NEW ELIGIBILITY RULES
* CHANGED:  11/10/2009 - FERNANDA COSTA - ADJUST AGE RANGE
* CHANGED:  18/08/2011 - ROBERTO MENDES - CONVERT TO SUBPROGRAM
* CHANGED:  05/04/2013 - ANDERSON LIMA  - ADD REGION 99
* PURPOSE:  VALIDATE BENEFICIARY ELIGIBILITY FOR A PROGRAM
*           CHECK REGISTRATION VS PROGRAM RULES - FILES 150/155
*           TICKET 6621/2011 - CALLED VIA CALLNAT BY
*           BATCHPGT. INPUT AND OUTPUT THROUGH PDACALC.
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
PARAMETER USING PDACALC
LOCAL USING LDASIFAP
LOCAL
  1 BENEFICIARY-V VIEW OF BENEFIC
    2 NUM-CPF            (A11)
    2 FULL-NAME          (A60)
    2 DT-BIRTH           (N8)
    2 STAT-BENEFICIARY   (A1)
    2 COD-PROGRAM        (A4)
    2 AMT-FAMILY-INCOME  (P9.2)
    2 QTY-DEPEND         (N2)
    2 GRP-ADDRESS
      3 UF               (A2)
      3 COD-REGION       (A2)
    2 NUM-NIS            (N11)
    2 IND-DOCS-OK        (A1)
*
  1 PROGRAM-V VIEW OF SOCPROG
    2 COD-PROGRAM        (A4)
    2 NAME-PROGRAM       (A60)
    2 TYPE-PROGRAM       (A1)
    2 AMT-BASE-INDIVIDUAL (P7.2)
    2 COD-ELIGIBILITY    (A5)
    2 STAT-PROGRAM       (A1)
    2 MAX-PERCAP-INCOME  (P7.2)
    2 AGE-MIN            (N3)
    2 AGE-MAX            (N3)
*
  1 #CPF-STR             (A11)
  1 #COD-PROG            (A4)
  1 #ELIGIBLE            (L)
  1 #REASON              (A60/1:10)
  1 #QTY-REASON          (N2)
  1 #ELIG-OK             (L)
  1 #AGE                 (N3)
  1 #YEAR-BIRTH          (N4)
  1 #YEAR-CURRENT        (N4)
  1 #INCOME              (P9.2)
  1 #NUM-DEP             (N2)
  1 #COD-REGION          (N2)
  1 #COD-ELIG            (A5)
  1 #TYPE-PROG           (A1)
  1 #STATUS-BENEF        (A1)
  1 #DOCS-OK             (A1)
  1 #STAT-PROG           (A1)
  1 #AGE-MIN             (N3)
  1 #AGE-MAX             (N3)
  1 #MAX-INCOME          (P7.2)
  1 #I                   (N2)
  1 #MSG                 (A78)
END-DEFINE
*
COMPUTE #YEAR-CURRENT = *DATN / 10000
MOVE 0 TO #QTY-REASON
MOVE TRUE TO #ELIGIBLE
*
* INPUT THROUGH PDACALC - TICKET 6621/2011
* INPUT REMOVED: ROUTINE IS NOW CALLED VIA
* CALLNAT FROM BATCHPGT.
MOVE #PC-CPF            TO #CPF-STR
MOVE #PC-COD-PROGRAM   TO #COD-PROG
COMPUTE #COD-REGION = VAL(#PC-COD-REGION)
MOVE #PC-FAMILY-INCOME TO #INCOME
MOVE #PC-QTY-DEPEND     TO #NUM-DEP
MOVE #PC-AGE          TO #AGE
MOVE #PC-STAT-BENEF      TO #STATUS-BENEF
*
* READ BENEFICIARY - FILE 150
FIND BENEFICIARY-V WITH NUM-CPF = #CPF-STR
  IF NO RECORDS FOUND
    MOVE 2001 TO #PC-COD-RETURN
    MOVE 'BENEFICIARY NOT FOUND' TO #PC-MSG
    ESCAPE ROUTINE
  END-NOREC
  COMPUTE #YEAR-BIRTH = BENEFICIARY-V.DT-BIRTH / 10000
  COMPUTE #AGE = #YEAR-CURRENT - #YEAR-BIRTH
  MOVE BENEFICIARY-V.AMT-FAMILY-INCOME TO #INCOME
  MOVE BENEFICIARY-V.QTY-DEPEND    TO #NUM-DEP
  COMPUTE #COD-REGION = VAL(BENEFICIARY-V.COD-REGION)
  MOVE BENEFICIARY-V.STAT-BENEFICIARY   TO #STATUS-BENEF
  MOVE BENEFICIARY-V.IND-DOCS-OK  TO #DOCS-OK
END-FIND
*
* READ PROGRAM - FILE 155
FIND PROGRAM-V WITH COD-PROGRAM = #COD-PROG
  IF NO RECORDS FOUND
    MOVE 2003 TO #PC-COD-RETURN
    MOVE 'PROGRAM NOT FOUND' TO #PC-MSG
    ESCAPE ROUTINE
  END-NOREC
  MOVE PROGRAM-V.COD-ELIGIBILITY TO #COD-ELIG
  MOVE PROGRAM-V.TYPE-PROGRAM     TO #TYPE-PROG
  MOVE PROGRAM-V.STAT-PROGRAM      TO #STAT-PROG
  MOVE PROGRAM-V.AGE-MIN         TO #AGE-MIN
  MOVE PROGRAM-V.AGE-MAX         TO #AGE-MAX
  MOVE PROGRAM-V.MAX-PERCAP-INCOME  TO #MAX-INCOME
END-FIND
*
IF #STAT-PROG NE 'A'
  MOVE 2004 TO #PC-COD-RETURN
  MOVE 'PROGRAM INACTIVE' TO #PC-MSG
  ESCAPE ROUTINE
END-IF
*
* ============================================
* REGION 99 - INTERNATIONAL/DIPLOMATIC
* ============================================
IF #COD-REGION = 99
  MOVE TRUE TO #ELIGIBLE
  MOVE 0 TO #PC-COD-RETURN
  MOVE 'ELIGIBLE - SPECIAL REGION' TO #PC-MSG
  ESCAPE ROUTINE
END-IF
*
* ============================================
* CHECK BENEFICIARY STATUS
* ============================================
IF #STATUS-BENEF NE 'A'
  IF #STATUS-BENEF = 'S'
    ADD 1 TO #QTY-REASON
    MOVE 'BENEFICIARY SUSPENDED' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
  ELSE
    IF #STATUS-BENEF = 'C' OR #STATUS-BENEF = 'D'
      ADD 1 TO #QTY-REASON
      MOVE 'BENEFICIARY CANCELED/REMOVED' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    ELSE
      IF #STATUS-BENEF = 'I'
        ADD 1 TO #QTY-REASON
        MOVE 'BENEFICIARY INACTIVE' TO #REASON(#QTY-REASON)
        MOVE FALSE TO #ELIGIBLE
      END-IF
    END-IF
  END-IF
END-IF
*
* ============================================
* CHECK AGE RANGE
* ============================================
IF #AGE-MIN > 0
  IF #AGE < #AGE-MIN
    ADD 1 TO #QTY-REASON
    MOVE 'AGE BELOW PROGRAM MINIMUM' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
  END-IF
END-IF
IF #AGE-MAX > 0
  IF #AGE > #AGE-MAX
    ADD 1 TO #QTY-REASON
    MOVE 'AGE ABOVE PROGRAM MAXIMUM' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
  END-IF
END-IF
*
* ============================================
* CHECK FAMILY INCOME
* ============================================
IF #MAX-INCOME > 0
  IF #INCOME > #MAX-INCOME
    ADD 1 TO #QTY-REASON
    MOVE 'FAMILY INCOME ABOVE PROGRAM CEILING' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
  END-IF
END-IF
*
* ============================================
* CHECK ELIGIBILITY BY PROGRAM TYPE
* ============================================
DECIDE ON FIRST VALUE OF #TYPE-PROG
  VALUE 'A'
* ASSISTANCE - REQUIRES LOW INCOME AND DOCUMENTATION
    IF #INCOME > 600.00
      IF #NUM-DEP < 1
        ADD 1 TO #QTY-REASON
        MOVE 'ASSISTANCE PROGRAM: INCOME > 600, NO DEPENDENTS'
          TO #REASON(#QTY-REASON)
        MOVE FALSE TO #ELIGIBLE
      END-IF
    END-IF
    IF #DOCS-OK NE 'S'
      ADD 1 TO #QTY-REASON
      MOVE 'INCOMPLETE DOCUMENTATION' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  VALUE 'P'
* PENSION - REQUIRES MINIMUM AGE 60
    IF #AGE < 60
      ADD 1 TO #QTY-REASON
      MOVE 'PENSION PROGRAM: AGE < 60' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  VALUE 'T'
* EMPLOYMENT - REQUIRES AGE BETWEEN 16 AND 65
    IF #AGE < 16 OR #AGE > 65
      ADD 1 TO #QTY-REASON
      MOVE 'EMPLOYMENT PROGRAM: AGE OUTSIDE 16-65' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  NONE
    ADD 1 TO #QTY-REASON
    MOVE 'UNKNOWN PROGRAM TYPE' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
END-DECIDE
*
* ============================================
* CHECK SPECIFIC ELIGIBILITY CODE
* ============================================
IF #COD-ELIG NE ' '
  PERFORM CHECK-ELIG-SPECIFIC
END-IF
*
* ============================================
* RESULT
* ============================================
IF #ELIGIBLE
  MOVE 0 TO #PC-COD-RETURN
  RESET #PC-MSG
ELSE
  MOVE 2010        TO #PC-COD-RETURN
  MOVE #REASON(1)  TO #PC-MSG
END-IF
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  MOVE 9999 TO #PC-COD-RETURN
  COMPRESS 'NATURAL ERROR' *ERROR-NR
           'LINE' *ERROR-LINE
           'PGM' *PROGRAM INTO #PC-MSG
  ESCAPE ROUTINE
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE CHECK-ELIG-SPECIFIC
  MOVE TRUE TO #ELIG-OK
  IF SUBSTR(#COD-ELIG,1,1) = 'R'
* REQUIRES VALID NIS
    IF BENEFICIARY-V.NUM-NIS = 0
      ADD 1 TO #QTY-REASON
      MOVE 'NIS NOT REGISTERED' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  END-IF
  IF SUBSTR(#COD-ELIG,2,1) = 'D'
* REQUIRES DEPENDENTS
    IF #NUM-DEP = 0
      ADD 1 TO #QTY-REASON
      MOVE 'PROGRAM REQUIRES DEPENDENTS' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  END-IF
END-SUBROUTINE
*
END
