* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM: BATCHCON
* SYSTEM:  SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:  MARCOS ANTONIO RIBEIRO
* DATE:    05/03/2000
* CHANGED: 18/09/2005 - MARCOS RIBEIRO - ADD BANCO REAL
* CHANGED: 22/06/2008 - ROBERTO MENDES - ADJUST CNAB 240
* CHANGED: 30/01/2014 - ANDERSON LIMA  - ADD AUDITING
* CHANGED: 11/05/2017 - SIFAP TEAM     - ADD CCAUDIT/ON ERROR
* PURPOSE: PAYMENT RECONCILIATION AGAINST BANK RETURN
*          BANCO DO BRASIL CNAB 240 PROCESS
*          GENERATES AUDIT RECORDS - FILES 160/170
*
* JOB.....: NOT AUTOMATED - MANUAL EXECUTION THROUGH NATURAL
*           TICKET 8110/2017 - DEDICATED JCL REQUESTED
* INPUT...: CMWKF01 - CNAB 240 RETURN (LRECL 240)
* OUTPUT..: CMPRINT - EXECUTION LOG
* RETURN..: 0=OK  4=WITH DISCREPANCIES  12=NATURAL ERROR
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 PAYMENT-V VIEW OF PAYMENT
    2 NUM-PAYMENT            (N15)
    2 NUM-CPF                (A11)
    2 COD-PROGRAM            (A4)
    2 YEAR-MONTH-REF         (N6)
    2 AMT-GROSS              (P9.2)
    2 AMT-NET                (P9.2)
    2 STAT-PAYMENT           (A1)
    2 DT-GENERATION          (N8)
    2 DT-CREDIT              (N8)
    2 COD-BANK               (A3)
    2 COD-BANK-RETURN        (A2)
*
  1 AUDIT-V VIEW OF AUDIT
    2 NUM-AUDIT              (N15)
    2 DT-EVENT               (N8)
    2 HR-EVENT               (N6)
    2 TS-EVENT               (N14)
    2 COD-ACTION             (A2)
    2 COD-MODULE             (A8)
    2 DESCR-ACTION           (A80)
    2 TYPE-ENTITY            (A4)
    2 ID-ENTITY              (A15)
    2 NUM-CPF-AFFECTED       (A11)
    2 USR-EVENT              (A8)
    2 NAME-JOB-BATCH         (A16)
    2 STAT-BATCH             (A1)
    2 AMT-PREV               (A60)
    2 AMT-NEW                (A60)
*
* CNAB 240 RECORD - BB LAYOUT
  1 #REC-CNAB              (A240)
  1 #CNAB-BANK            (A3)
  1 #CNAB-BATCH            (A4)
  1 #CNAB-TYPE-REC         (A1)
  1 #CNAB-CPF              (A11)
  1 #CNAB-AMT              (A15)
  1 #CNAB-DT-PAYMENT       (A8)
  1 #CNAB-COD-RETURN       (A2)
  1 #CNAB-NUM-DOC          (A10)
*
  1 #PERIOD                (N6)
  1 #PERIOD-A              (A6)
  1 #DT-TODAY              (N8)
  1 #HR-CURRENT            (N6)
  1 #TIMN-AUX              (N7)
  1 #FILE-RETURN           (A60)
*
* COUNTERS
  1 #QTY-READ              (N8)
  1 #QTY-RECONCILED        (N8)
  1 #QTY-DIVERGENT         (N8)
  1 #QTY-NOT-FOUND         (N8)
  1 #QTY-AUDIT             (N8)
*
* WORK VARIABLES
  1 #CPF-NUM               (N11)
  1 #AMT-RETURN            (P9.2)
  1 #AMT-STR               (A15)
  1 #AMT-CENT              (N15)
  1 #AMT-PAYMENT-SIFAP     (P9.2)
  1 #NUM-PAYMENT           (N15)
  1 #DT-PAYMENT-WK         (N8)
  1 #COD-RETURN            (A2)
  1 #FOUND                 (L)
  1 #SEQ-AUDIT             (N15)
  1 #MSG                   (A80)
  1 #DIFF                  (P9.2)
  1 #I                     (N2)
  1 #AMT-PREV-STR          (A60)
  1 #AMT-NEW-STR           (A60)
*
* FIELDS REQUIRED BY COPYCODE CCAUDIT
  1 #AUD-ACTION            (A2)
  1 #AUD-ENTITY            (A4)
  1 #AUD-ID                (A15)
  1 #AUD-CPF               (A11)
  1 #AUD-DESCR             (A80)
  1 #AUD-SEQ               (N15)
  1 #AUD-TIMN              (N7)
END-DEFINE
*
MOVE *DATN TO #DT-TODAY
* *TIMN RETURNS N7 (HHMMSST) - FILE 153 STORES N6
MOVE *TIMN TO #TIMN-AUX
DIVIDE 10 INTO #TIMN-AUX GIVING #HR-CURRENT
MOVE 0 TO #QTY-READ
MOVE 0 TO #QTY-RECONCILED
MOVE 0 TO #QTY-DIVERGENT
MOVE 0 TO #QTY-NOT-FOUND
MOVE 0 TO #QTY-AUDIT
*
* GET LAST AUDIT SEQUENCE - LIMIT (1) AVOIDS ESCAPE
READ (1) AUDIT-V BY NUM-AUDIT DESCENDING
  MOVE AUDIT-V.NUM-AUDIT TO #SEQ-AUDIT
END-READ
*
INPUT 'SIFAP - BANK RECONCILIATION' /
      '=============================' /
      'PERIOD..........:' #PERIOD /
      'RETURN FILE.....:' #FILE-RETURN
*
WRITE '================================================'
WRITE 'BATCHCON - PAYMENT RECONCILIATION'
WRITE 'PERIOD:' #PERIOD
WRITE 'FILE:' #FILE-RETURN
WRITE '================================================'
*
* READ CNAB 240 RETURN FILE
* IN Z/OS THE BINDING USES DD CMWKF01 - THE NAME PROVIDED
* ABOVE IS FOR DOCUMENTATION ONLY - TICKET 8111/2017
MOVE EDITED #PERIOD (EM=999999) TO #PERIOD-A
READ WORK FILE 1 #REC-CNAB
*
  ADD 1 TO #QTY-READ
*
* PARSE CNAB 240 RECORD
  MOVE SUBSTR(#REC-CNAB,1,3)     TO #CNAB-BANK
  MOVE SUBSTR(#REC-CNAB,4,4)     TO #CNAB-BATCH
  MOVE SUBSTR(#REC-CNAB,8,1)     TO #CNAB-TYPE-REC
*
* PROCESS DETAIL RECORDS ONLY (TYPE=3)
  IF #CNAB-TYPE-REC NE '3'
    ESCAPE TOP
  END-IF
*
  MOVE SUBSTR(#REC-CNAB,44,11)   TO #CNAB-CPF
  MOVE SUBSTR(#REC-CNAB,120,15)  TO #CNAB-AMT
  MOVE SUBSTR(#REC-CNAB,140,8)   TO #CNAB-DT-PAYMENT
  MOVE SUBSTR(#REC-CNAB,231,2)   TO #CNAB-COD-RETURN
  MOVE SUBSTR(#REC-CNAB,74,10)   TO #CNAB-NUM-DOC
*
  COMPUTE #CPF-NUM = VAL(#CNAB-CPF)
  COMPUTE #NUM-PAYMENT = VAL(#CNAB-NUM-DOC)
*
* CONVERT AMOUNT (CENTS -> BRL)
* UNTIL 2017 THE A15 WENT DIRECTLY TO THE DECIMAL FIELD
* TICKET 8112/2017
  MOVE #CNAB-AMT TO #AMT-STR
  COMPUTE #AMT-CENT = VAL(#AMT-STR)
  COMPUTE #AMT-RETURN = #AMT-CENT / 100
*
  COMPUTE #DT-PAYMENT-WK = VAL(#CNAB-DT-PAYMENT)
  MOVE #CNAB-COD-RETURN TO #COD-RETURN
*
* FIND MATCHING PAYMENT
  MOVE FALSE TO #FOUND
  RESET #AMT-PAYMENT-SIFAP
  FIND PAYMENT-V WITH NUM-PAYMENT = #NUM-PAYMENT
    IF PAYMENT-V.NUM-CPF = #CNAB-CPF
        AND PAYMENT-V.YEAR-MONTH-REF = #PERIOD
      MOVE TRUE TO #FOUND
      MOVE PAYMENT-V.AMT-NET TO #AMT-PAYMENT-SIFAP
    END-IF
  END-FIND
*
  IF NOT #FOUND
    ADD 1 TO #QTY-NOT-FOUND
    COMPRESS 'NOT FOUND: CPF=' #CNAB-CPF ' DOC=' #CNAB-NUM-DOC
        INTO #MSG
    WRITE #MSG (AL=78)
    ESCAPE TOP
  END-IF
*
* RECONCILE AMOUNTS
  COMPUTE #DIFF = #AMT-PAYMENT-SIFAP - #AMT-RETURN
  IF #DIFF < 0
    COMPUTE #DIFF = #DIFF * -1
  END-IF
*
  IF #DIFF > 0.01
    ADD 1 TO #QTY-DIVERGENT
    COMPRESS 'DISCREPANCY: CPF=' #CNAB-CPF
        ' SIFAP=' #AMT-PAYMENT-SIFAP
        ' BANK=' #AMT-RETURN INTO #MSG
    WRITE #MSG (AL=78)
*
    PERFORM WRITE-AUDIT-DIVERG
  ELSE
    ADD 1 TO #QTY-RECONCILED
* UPDATE PAYMENT STATUS
    DECIDE ON FIRST VALUE OF #COD-RETURN
      VALUE '00'
        FIND PAYMENT-V WITH NUM-PAYMENT = #NUM-PAYMENT
          MOVE 'P'     TO PAYMENT-V.STAT-PAYMENT
          MOVE #DT-PAYMENT-WK TO PAYMENT-V.DT-CREDIT
          MOVE 1        TO PAYMENT-V.COD-BANK
          MOVE #COD-RETURN TO PAYMENT-V.COD-BANK-RETURN
          UPDATE PAYMENT-V
          END TRANSACTION
        END-FIND
      VALUE '01'
        FIND PAYMENT-V WITH NUM-PAYMENT = #NUM-PAYMENT
          MOVE 'D'     TO PAYMENT-V.STAT-PAYMENT
          MOVE #COD-RETURN TO PAYMENT-V.COD-BANK-RETURN
          UPDATE PAYMENT-V
          END TRANSACTION
        END-FIND
      VALUE '02'
        FIND PAYMENT-V WITH NUM-PAYMENT = #NUM-PAYMENT
          MOVE 'E'     TO PAYMENT-V.STAT-PAYMENT
          MOVE #COD-RETURN TO PAYMENT-V.COD-BANK-RETURN
          UPDATE PAYMENT-V
          END TRANSACTION
        END-FIND
      NONE
        COMPRESS 'UNKNOWN RETURN CODE:' #COD-RETURN
            ' CPF=' #CNAB-CPF INTO #MSG
        WRITE #MSG (AL=78)
    END-DECIDE
*
    PERFORM WRITE-AUDIT-RECONC
  END-IF
*
END-WORK
*
* --------------------------------------------------------
* BANCO REAL INTEGRATION - DISCONTINUED
* BANCO REAL WAS ACQUIRED BY SANTANDER IN 2007
* KEEP CODE FOR HISTORICAL REFERENCE
* OWNER: MARCOS RIBEIRO - 18/09/2005
* --------------------------------------------------------
*  DEFINE WORK FILE 2 'RETURN_REAL.DAT' TYPE 'ASCII'
*  READ WORK FILE 2 #REC-CNAB
*    MOVE SUBSTR(#REC-CNAB,1,3) TO #CNAB-BANK
*    IF #CNAB-BANK NE '356'   /* BANCO REAL CODE */
*      ESCAPE TOP
*    END-IF
*    MOVE SUBSTR(#REC-CNAB,30,14) TO #CNAB-CPF
*    MOVE SUBSTR(#REC-CNAB,100,13) TO #CNAB-AMT
*    /* BANCO REAL LAYOUT DIFFERS FROM BB */
*    /* AMOUNT AT POSITION 100-112, CPF AT 30-43 */
*    PERFORM RECONCILE-REAL
*  END-WORK
* --------------------------------------------------------
*
* SUMMARY
WRITE '================================================' /
      'BATCHCON - RECONCILIATION SUMMARY' /
      '================================================' /
      'RECORDS READ...........:' #QTY-READ /
      'RECONCILED.............:' #QTY-RECONCILED /
      'DISCREPANCIES..........:' #QTY-DIVERGENT /
      'NOT FOUND..............:' #QTY-NOT-FOUND /
      'AUDIT RECORDS..........:' #QTY-AUDIT /
      '================================================'
*
* --------------------------------------------------------
* CYCLE AUDIT TRAIL - FILE 153
* IN-TCU 63/2010 - TICKET 8113/2017
* SEED INHERITED FROM #SEQ-AUDIT TO AVOID DUPLICATE KEY
* --------------------------------------------------------
MOVE #SEQ-AUDIT TO #AUD-SEQ
MOVE 'BT'       TO #AUD-ACTION
MOVE 'PGTO'     TO #AUD-ENTITY
MOVE #PERIOD-A  TO #AUD-ID
RESET #AUD-CPF
COMPRESS 'RECONCILIATION PERIOD' #PERIOD-A
    'READ' #QTY-READ 'DISCREP' #QTY-DIVERGENT
    INTO #AUD-DESCR
PERFORM WRITE-AUDIT
MOVE #AUD-SEQ TO #SEQ-AUDIT
END TRANSACTION
*
CLOSE WORK FILE 1
*
* RETURN CODE - TICKET 8114/2017
IF #QTY-DIVERGENT > 0 OR #QTY-NOT-FOUND > 0
  WRITE 'RECONCILIATION HAS PENDING ITEMS - CHECK LOG'
  TERMINATE 4
END-IF
TERMINATE 0
*
* --------------------------------------------------------
* NATURAL ERROR HANDLING - TICKET 8115/2017
* --------------------------------------------------------
ON ERROR
  WRITE 'NATURAL ERROR NO.:' *ERROR-NR
  WRITE 'LINE.............:' *ERROR-LINE
  WRITE 'PROGRAM..........:' *PROGRAM
  WRITE 'LAST CNAB DOC....:' #CNAB-NUM-DOC
  WRITE 'RECORDS READ.....:' #QTY-READ
  BACKOUT TRANSACTION
  CLOSE WORK FILE 1
  TERMINATE 12
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE WRITE-AUDIT-RECONC
  ADD 1 TO #SEQ-AUDIT
  ADD 1 TO #QTY-AUDIT
  MOVE #SEQ-AUDIT  TO AUDIT-V.NUM-AUDIT
  MOVE #DT-TODAY    TO AUDIT-V.DT-EVENT
  MOVE #HR-CURRENT   TO AUDIT-V.HR-EVENT
  MOVE 'BATCH'     TO AUDIT-V.USR-EVENT
  MOVE 'CO'        TO AUDIT-V.COD-ACTION
  MOVE 'PGTO'      TO AUDIT-V.TYPE-ENTITY
  MOVE #NUM-PAYMENT   TO AUDIT-V.ID-ENTITY
  COMPRESS 'RECONCILED RETURN CODE=' #COD-RETURN INTO AUDIT-V.DESCR-ACTION
  STORE AUDIT-V
  END TRANSACTION
END-SUBROUTINE
*
DEFINE SUBROUTINE WRITE-AUDIT-DIVERG
  ADD 1 TO #SEQ-AUDIT
  ADD 1 TO #QTY-AUDIT
  MOVE #SEQ-AUDIT  TO AUDIT-V.NUM-AUDIT
  MOVE #DT-TODAY    TO AUDIT-V.DT-EVENT
  MOVE #HR-CURRENT   TO AUDIT-V.HR-EVENT
  MOVE 'BATCH'     TO AUDIT-V.USR-EVENT
  MOVE 'DV'        TO AUDIT-V.COD-ACTION
  MOVE 'PGTO'      TO AUDIT-V.TYPE-ENTITY
  MOVE #NUM-PAYMENT   TO AUDIT-V.ID-ENTITY
  MOVE #AMT-PAYMENT-SIFAP TO #AMT-PREV-STR
  MOVE #AMT-RETURN TO #AMT-NEW-STR
  MOVE #AMT-PREV-STR TO AUDIT-V.AMT-PREV
  MOVE #AMT-NEW-STR TO AUDIT-V.AMT-NEW
  COMPRESS 'SIFAP VS BANK AMOUNT DISCREPANCY' INTO AUDIT-V.DESCR-ACTION
  STORE AUDIT-V
  END TRANSACTION
END-SUBROUTINE
*
INCLUDE CCAUDIT
*
END
