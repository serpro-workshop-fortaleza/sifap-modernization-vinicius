* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM:  CADPROG
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   MARCOS ANTONIO RIBEIRO
* DATE:     10/09/1997
* CHANGED:  05/07/2003 - MARCOS RIBEIRO - ADDED CORRECTION FACTOR
* CHANGED:  12/09/2012 - ANDERSON LIMA  - ADDED AUDIT TRAIL
* CHANGED:  18/11/2012 - FERNANDA COSTA - NEW ELIGIBILITY CODES
* PURPOSE:  SOCIAL PROGRAM REGISTRATION - ADD/QUERY
*           MAINTAIN PROGRAM TABLE IN FILE 155
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 PROGRAM-V VIEW OF SOCPROG
    2 COD-PROGRAM            (A4)
    2 NAME-PROGRAM           (A60)
    2 TYPE-PROGRAM           (A1)  /* A=ASSISTANCE P=PENSION T=WORK
    2 AMT-BASE-INDIVIDUAL    (P7.2)
    2 COD-ELIGIBILITY        (A5)
    2 DT-CREATION            (N8)
    2 DT-CLOSURE             (N8)
    2 STAT-PROGRAM           (A1)
    2 MAX-PERCAP-INCOME      (P7.2)
    2 AGE-MIN                (N3)
    2 AGE-MAX                (N3)
    2 FACTOR-ADJUST          (P3.4)
*
* AUDIT TRAIL - FILE 153 - IN-TCU 63/2010
  1 AUDIT-V VIEW OF AUDIT
    2 NUM-AUDIT              (N15)
    2 DT-EVENT               (N8)
    2 HR-EVENT               (N6)
    2 TS-EVENT               (N14)
    2 COD-ACTION             (A2)
    2 COD-MODULE             (A8)
    2 DESCR-ACTION           (A80)
    2 TYPE-ENTITY            (A4)
    2 ID-ENTITY              (A15)
    2 NUM-CPF-AFFECTED       (A11)
    2 USR-EVENT              (A8)
    2 NAME-JOB-BATCH         (A16)
    2 STAT-BATCH             (A1)
*
  1 #COD-PROG              (N4)
  1 #COD-PROG-A            (A4)
  1 #NAME-PROG             (A60)
  1 #TYPE                  (A1)
  1 #AMT-BASE              (P9.2)
  1 #COD-ELIG              (A5)
  1 #DT-START              (N8)
  1 #DT-END                (N8)
  1 #STATUS                (A1)
  1 #MAX-INCOME            (P9.2)
  1 #AGE-MIN               (N3)
  1 #AGE-MAX               (N3)
  1 #FACTOR-ADJUST         (N3.4)
  1 #FACTOR-K               (N5.6)
  1 #OPER                  (A1)
  1 #MSG                   (A60)
  1 #FOUND                 (L)
  1 #AMT-CALC              (P9.2)
*
* AUDIT TRAIL FIELDS - CCAUDIT
  1 #AUD-ACTION            (A2)
  1 #AUD-ENTITY            (A4)
  1 #AUD-ID                (A15)
  1 #AUD-CPF               (A11)
  1 #AUD-DESCR             (A80)
  1 #AUD-SEQ               (N15)
  1 #AUD-TIMN              (N7)
END-DEFINE
*
* FLOW CONTROL - TICKET 6622/2011
* OUTER REPEAT ENABLES EARLY EXIT
* (ESCAPE BOTTOM) WITHOUT REWRITING THE RULES
REPEAT
*
INPUT 'SIFAP - SOCIAL PROGRAM REGISTRATION' /
      '====================================' /
      'OPERATION (I/C):' #OPER /
      'PROGRAM CODE..:' #COD-PROG
*
IF #OPER NE 'I' AND #OPER NE 'C'
  WRITE 'INVALID OPERATION'
  ESCAPE BOTTOM
END-IF
*
IF #OPER = 'C'
  PERFORM QUERY-PROG
  ESCAPE BOTTOM
END-IF
*
* ADDITION
INPUT 'PROGRAM INFORMATION' /
      '===================' /
      'NAME..........:' #NAME-PROG /
      'TYPE..........:' #TYPE '(A/P/T)' /
      'BASE AMOUNT...:' #AMT-BASE /
      'ELIGIB. CODE..:' #COD-ELIG /
      'START DATE....:' #DT-START /
      'END DATE......:' #DT-END '(0=OPEN-ENDED)' /
      'MAX INCOME....:' #MAX-INCOME /
      'MINIMUM AGE...:' #AGE-MIN /
      'MAXIMUM AGE...:' #AGE-MAX /
      'ADJUST. FACTOR:' #FACTOR-ADJUST
*
* CHECK FOR EXISTING PROGRAM
* COD-PROGRAM IS ALPHANUMERIC IN FILE 151 (AA A4)
MOVE EDITED #COD-PROG (EM=9999) TO #COD-PROG-A
FIND PROGRAM-V WITH COD-PROGRAM = #COD-PROG-A
  IF NO RECORDS FOUND
    MOVE FALSE TO #FOUND
  END-NOREC
  MOVE TRUE TO #FOUND
END-FIND
*
IF #FOUND
  WRITE 'PROGRAM ALREADY REGISTERED'
  ESCAPE BOTTOM
END-IF
*
* CALCULATE BASE AMOUNT ADJUSTED BY FACTOR K
COMPUTE #FACTOR-K = 1.00 + (#FACTOR-ADJUST * 0.347215)
COMPUTE #AMT-CALC = #AMT-BASE * #FACTOR-K
*
MOVE #COD-PROG-A   TO PROGRAM-V.COD-PROGRAM
MOVE #NAME-PROG   TO PROGRAM-V.NAME-PROGRAM
MOVE #TYPE         TO PROGRAM-V.TYPE-PROGRAM
MOVE #AMT-CALC     TO PROGRAM-V.AMT-BASE-INDIVIDUAL
MOVE #COD-ELIG     TO PROGRAM-V.COD-ELIGIBILITY
MOVE #DT-START    TO PROGRAM-V.DT-CREATION
MOVE #DT-END       TO PROGRAM-V.DT-CLOSURE
MOVE 'A'           TO PROGRAM-V.STAT-PROGRAM
MOVE #MAX-INCOME    TO PROGRAM-V.MAX-PERCAP-INCOME
MOVE #AGE-MIN    TO PROGRAM-V.AGE-MIN
MOVE #AGE-MAX    TO PROGRAM-V.AGE-MAX
MOVE #FACTOR-ADJUST   TO PROGRAM-V.FACTOR-ADJUST
STORE PROGRAM-V
* AUDIT TRAIL - TICKET 5510/2012
MOVE 'IN'                   TO #AUD-ACTION
MOVE 'PROG'                 TO #AUD-ENTITY
MOVE #COD-PROG-A            TO #AUD-ID
RESET #AUD-CPF
MOVE 'SOCIAL PROGRAM ADDED'       TO #AUD-DESCR
PERFORM WRITE-AUDIT
END TRANSACTION
*
WRITE 'PROGRAM ADDED SUCCESSFULLY - ADJUSTED AMOUNT:' #AMT-CALC
*
* NORMAL EXIT - TICKET 6622/2011
ESCAPE BOTTOM
END-REPEAT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE QUERY-PROG
  MOVE EDITED #COD-PROG (EM=9999) TO #COD-PROG-A
  FIND PROGRAM-V WITH COD-PROGRAM = #COD-PROG-A
    WRITE 'PROGRAM CODE.:' PROGRAM-V.COD-PROGRAM /
          'NAME.........:' PROGRAM-V.NAME-PROGRAM /
          'TYPE.........:' PROGRAM-V.TYPE-PROGRAM /
          'BASE AMOUNT..:' PROGRAM-V.AMT-BASE-INDIVIDUAL /
          'ELIGIBILITY..:' PROGRAM-V.COD-ELIGIBILITY /
          'STATUS.......:' PROGRAM-V.STAT-PROGRAM
  END-FIND
* OLD 1997 STYLE - NOT STANDARDIZED FOR NO RECORDS
* FOUND. RETAINED - TICKET 3312/2004 IS OPEN
  IF *NUMBER(PROGRAM-V) = 0
    WRITE 'PROGRAM NOT FOUND'
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* AUDIT TRAIL - IN-TCU 63/2010 - TICKET 5510
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
INCLUDE CCAUDIT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* NATURAL ERROR HANDLING - TICKET 5511/2012
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  WRITE 'NATURAL ERROR' *ERROR-NR 'LINE' *ERROR-LINE
  WRITE 'PGM' *PROGRAM 'LIB' *LIBRARY-ID
  BACKOUT TRANSACTION
  TERMINATE 12
END-ERROR
*
END
