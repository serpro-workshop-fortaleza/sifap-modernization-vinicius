//*==================================================================
//* JOB......: SIFAPJ01
//* SYSTEM...: SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
//* PDS......: SIFAP.PROD.JCLLIB(SIFAPJ01)
//* AUTHOR...: CARLOS ROBERTO DA SILVA
//* DATE.....: 22/06/1997
//* CHANGED..: 15/01/2000 - CARLOS SILVA   - OPTIMIZE CPF ORDER
//* CHANGED..: 30/08/2004 - PATRICIA GOMES - ADD ERROR LOG STEP
//* CHANGED..: 25/05/2012 - FERNANDA COSTA - PERIOD BY PARAMETER
//* CHANGED..: 10/07/2015 - ANDERSON LIMA  - ADD AUDIT TRAIL
//* PURPOSE..: MONTHLY PAYROLL - RUNS BATCHPGT
//*==================================================================
//* SCHEDULING (CONTROL-M)
//*   TABLE.........: SIFAP-MENSAL
//*   JOB NAME......: SIFAPJ01
//*   GROUP.........: SIFAP-PGT
//*   FREQUENCY.....: MONTHLY - 1ST BUSINESS DAY
//*   TIME..........: 22:00  4H WINDOW
//*   PREDECESSOR...: NONE
//*   SUCCESSOR.....: SIFAPJ02 (COND RC=0)
//*   OUT CONDITION.: SIFAP-PGT-OK ODAT
//*   RESOURCE......: ADABAS-057 (QTY 1)
//*==================================================================
//* RESTART
//*   STEP010 IS RESTARTABLE. BATCHPGT CHECKS WHETHER A PAYMENT
//*   ALREADY EXISTS FOR THE PERIOD AND DOES NOT CREATE A DUPLICATE.
//*   IN CASE OF ABEND:
//*     1. CHECK RC AND CMPRINT
//*     2. CONFIRM THAT CMWKF01 WAS DEALLOCATED
//*     3. RERUN FROM STEP010 WITH THE SAME PERIOD
//*        PROVIDED IN CMSYNIN
//*   DO NOT RERUN WITH A DIFFERENT PERIOD WITHOUT OPENING
//*   A TICKET - SEE ITSM-SIFAP-002.
//*==================================================================
//SIFAPJ01 JOB (SIFAP,DESIF),'SIFAP MONTHLY PAYROLL',
//             CLASS=B,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//JOBLIB   DD DSN=SIFAP.PROD.LOADLIB,DISP=SHR
//         DD DSN=SAG.NAT426.LOAD,DISP=SHR
//         DD DSN=SAG.ADA614.LOAD,DISP=SHR
//*
//*------------------------------------------------------------------
//* STEP010 - PAYROLL GENERATION (BATCHPGT)
//*------------------------------------------------------------------
//STEP010  EXEC PGM=NATBATCH,
//             PARM='IM=D,MADIO=0,MT=0,MAXCL=0,DBID=57,FNR=150'
//STEPLIB  DD DSN=SAG.NAT426.LOAD,DISP=SHR
//         DD DSN=SAG.ADA614.LOAD,DISP=SHR
//DDCARD   DD DSN=SIFAP.PROD.PARMLIB(ADAPARM),DISP=SHR
//CMPRINT  DD SYSOUT=*
//*
//* CMWKF01 - PAYMENT EXTRACT FOR BANK TRANSMISSION
//CMWKF01  DD DSN=SIFAP.PROD.PGTO.EXTRACT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(500,100),RLSE),
//            DCB=(RECFM=FB,LRECL=240,BLKSIZE=27840)
//*
//* CMWKF02 - REJECTED RECORDS LOG (TICKET 4180/2004)
//CMWKF02  DD DSN=SIFAP.PROD.PGTO.REJEIT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27840)
//*
//* CMSYNIN - NATURAL COMMAND INPUT
//* LINE 3 = YYYYMM PERIOD READ BY BATCHPGT
//* BEFORE 05/2012 THE PROGRAM DERIVED THE PERIOD FROM
//* *DATN AND DID NOT ALLOW REPROCESSING - TICKET 5980
//CMSYNIN  DD *
LOGON SIFAPPRD
BATCHPGT
202601
FIN
/*
//*
//*------------------------------------------------------------------
//* STEP020 - COPY TRANSMISSION FILE TO TRANSFER AREA
//* RUNS ONLY IF STEP010 ENDED WITH RC LESS THAN OR EQUAL TO 4
//*------------------------------------------------------------------
//STEP020  EXEC PGM=IEBGENER,COND=(4,LT,STEP010)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=SIFAP.PROD.PGTO.EXTRACT(0),DISP=SHR
//SYSUT2   DD DSN=SIFAP.TRANSM.REMESSA(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(500,100),RLSE),
//            DCB=(RECFM=FB,LRECL=240,BLKSIZE=27840)
//*
//*------------------------------------------------------------------
//* STEP030 - FAILURE NOTICE (RUNS ONLY IF STEP010 FAILED)
//*------------------------------------------------------------------
//STEP030  EXEC PGM=IEFBR14,COND=(5,GT,STEP010)
//AVISO    DD DSN=SIFAP.PROD.ALERTA.PGTO,DISP=SHR
//*
//*==================================================================
//* EXPECTED RETURN CODES FROM STEP010
//*   RC=0  - PAYROLL GENERATED WITHOUT REJECTED RECORDS
//*   RC=4  - PAYROLL GENERATED WITH REJECTED RECORDS IN CMWKF02
//*   RC=8  - PERIOD ALREADY PROCESSED - NOTHING TO DO
//*   RC=12 - NATURAL ERROR - CHECK CMPRINT AND CONTACT ON-CALL
//*==================================================================
