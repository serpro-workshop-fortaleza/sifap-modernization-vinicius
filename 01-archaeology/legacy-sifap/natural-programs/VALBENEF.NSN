* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* SUBPROGRAM: VALBENEF
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   MARCIA HELENA OLIVEIRA
* DATE:     08/01/1998
* CHANGED:  17/05/2005 - MARCIA HELENA - ADJUST CPF VALIDATION
* CHANGED:  30/11/2010 - JOSE FERREIRA - ADD NAME VALIDATION
* CHANGED:  18/08/2011 - ROBERTO MENDES - CONVERT TO SUBPROGRAM
* PURPOSE:  VALIDATE BENEFICIARY REGISTRATION DATA
*           ROUTINE CALLED BEFORE WRITING - FILE 150
*           TICKET 6621/2011 - UNTIL 2011, INPUT VARIABLES
*           WERE NEVER POPULATED. IT NOW RECEIVES
*           EVERYTHING BY PARAMETER - SEE CALLNAT IN CADBENEF.
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
PARAMETER
  1 #CPF-STR             (A11)        /* IN
  1 #NAME                (A60)        /* IN
  1 #DT-BIRTH            (N8)         /* IN
  1 #SEX                 (A1)         /* IN
  1 #UF                  (A2)         /* IN
  1 #CEP                 (N8)         /* IN
  1 #STATUS              (A1)         /* IN
  1 #RESULT              (A1)         /* OUT V=VALID I=INVALID
  1 #QTY-ERRS            (N2)         /* OUT
  1 #MSG-ERR             (A60/1:10)   /* OUT
LOCAL USING LDASIFAP
LOCAL
* VIEW DECLARED SINCE 1998 AND NEVER READ - TICKET 4471/2003
  1 BENEFICIARY-V VIEW OF BENEFIC
    2 NUM-CPF            (A11)
    2 FULL-NAME          (A60)
    2 DT-BIRTH           (N8)
    2 SEX                (A1)
    2 GRP-ADDRESS
      3 UF               (A2)
      3 CEP              (N8)
    2 STAT-BENEFICIARY   (A1)
*
  1 #CPF                 (A11)
  1 #UF-OK               (L)
  1 #CPF-VALID           (L)
  1 #DT-VALID            (L)
  1 #NAME-VALID          (L)
*
* CPF VALIDATION VARIABLES
  1 #DIG                 (N1/1:11)
  1 #SUM                 (N5)
  1 #REMAIN              (N3)
  1 #DV1                 (N1)
  1 #DV2                 (N1)
  1 #WEIGHT              (N2)
  1 #I                   (N2)
  1 #ALL-EQUAL           (L)
*
* DATE VALIDATION VARIABLES
  1 #YEAR                (N4)
  1 #MONTH               (N2)
  1 #DAY                 (N2)
  1 #DAYS-MONTH          (N2/1:12)
  1 #YEAR-CURRENT        (N4)
*
* NAME VALIDATION VARIABLES
  1 #NAME-TEMP           (A60)
  1 #POS                 (N2)
  1 #HAS-SPACE           (L)
  1 #CHAR                (A1)
*
* VALID UF CODES
  1 #UF-TAB              (A2/1:27)
END-DEFINE
*
* LOAD UF TABLE
MOVE 'AC' TO #UF-TAB(1)
MOVE 'AL' TO #UF-TAB(2)
MOVE 'AM' TO #UF-TAB(3)
MOVE 'AP' TO #UF-TAB(4)
MOVE 'BA' TO #UF-TAB(5)
MOVE 'CE' TO #UF-TAB(6)
MOVE 'DF' TO #UF-TAB(7)
MOVE 'ES' TO #UF-TAB(8)
MOVE 'GO' TO #UF-TAB(9)
MOVE 'MA' TO #UF-TAB(10)
MOVE 'MG' TO #UF-TAB(11)
MOVE 'MS' TO #UF-TAB(12)
MOVE 'MT' TO #UF-TAB(13)
MOVE 'PA' TO #UF-TAB(14)
MOVE 'PB' TO #UF-TAB(15)
MOVE 'PE' TO #UF-TAB(16)
MOVE 'PI' TO #UF-TAB(17)
MOVE 'PR' TO #UF-TAB(18)
MOVE 'RJ' TO #UF-TAB(19)
MOVE 'RN' TO #UF-TAB(20)
MOVE 'RO' TO #UF-TAB(21)
MOVE 'RR' TO #UF-TAB(22)
MOVE 'RS' TO #UF-TAB(23)
MOVE 'SC' TO #UF-TAB(24)
MOVE 'SE' TO #UF-TAB(25)
MOVE 'SP' TO #UF-TAB(26)
MOVE 'TO' TO #UF-TAB(27)
*
* LOAD DAYS PER MONTH
MOVE 31 TO #DAYS-MONTH(1)
MOVE 29 TO #DAYS-MONTH(2)   /* ASSUMES LEAP YEAR */
MOVE 31 TO #DAYS-MONTH(3)
MOVE 30 TO #DAYS-MONTH(4)
MOVE 31 TO #DAYS-MONTH(5)
MOVE 30 TO #DAYS-MONTH(6)
MOVE 31 TO #DAYS-MONTH(7)
MOVE 31 TO #DAYS-MONTH(8)
MOVE 30 TO #DAYS-MONTH(9)
MOVE 31 TO #DAYS-MONTH(10)
MOVE 30 TO #DAYS-MONTH(11)
MOVE 31 TO #DAYS-MONTH(12)
*
MOVE 0 TO #QTY-ERRS
MOVE 'V' TO #RESULT
COMPUTE #YEAR-CURRENT = *DATN / 10000
*
* CPF ARRIVES THROUGH THE INTERFACE AS A11 - TICKET 6621/2011
MOVE #CPF-STR TO #CPF
*
* ============================================
* CPF VALIDATION - MODULUS 11
* ============================================
PERFORM VALID-CPF-COMPLETE
IF NOT #CPF-VALID
  ADD 1 TO #QTY-ERRS
  MOVE 'INVALID CPF - CHECK DIGIT' TO #MSG-ERR(#QTY-ERRS)
  MOVE 'I' TO #RESULT
END-IF
*
* ============================================
* BIRTH DATE VALIDATION
* ============================================
PERFORM VALID-DATE
IF NOT #DT-VALID
  ADD 1 TO #QTY-ERRS
  MOVE 'INVALID BIRTH DATE' TO #MSG-ERR(#QTY-ERRS)
  MOVE 'I' TO #RESULT
END-IF
*
* ============================================
* NAME VALIDATION
* ============================================
PERFORM VALID-NAME
IF NOT #NAME-VALID
  ADD 1 TO #QTY-ERRS
  MOVE 'INVALID NAME - FIRST AND LAST NAME REQUIRED' TO #MSG-ERR(#QTY-ERRS)
  MOVE 'I' TO #RESULT
END-IF
*
* ============================================
* UF VALIDATION
* ============================================
IF #UF NE ' '
  MOVE FALSE TO #UF-OK
  FOR #I = 1 TO 27
    IF #UF = #UF-TAB(#I)
      MOVE TRUE TO #UF-OK
      ESCAPE BOTTOM
    END-IF
  END-FOR
  IF NOT #UF-OK
    ADD 1 TO #QTY-ERRS
    MOVE 'INVALID UF' TO #MSG-ERR(#QTY-ERRS)
    MOVE 'I' TO #RESULT
  END-IF
END-IF
*
* ============================================
* STATUS VALIDATION
* ============================================
IF #STATUS NE 'A' AND #STATUS NE 'S' AND #STATUS NE 'C'
    AND #STATUS NE 'I' AND #STATUS NE 'D'
  ADD 1 TO #QTY-ERRS
  MOVE 'INVALID STATUS' TO #MSG-ERR(#QTY-ERRS)
  MOVE 'I' TO #RESULT
END-IF
*
* RESULT RETURNED THROUGH THE INTERFACE - TICKET 6621/2011
* WRITE REMOVED: VALIDATOR CALLED BY BATCH DOES NOT WRITE
* TO SCREEN. SEE #RESULT / #QTY-ERRS / #MSG-ERR.
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  ADD 1 TO #QTY-ERRS
  COMPRESS 'NATURAL ERROR' *ERROR-NR
           'LINE' *ERROR-LINE
           'PGM' *PROGRAM INTO #MSG-ERR(#QTY-ERRS)
  MOVE 'I' TO #RESULT
  ESCAPE ROUTINE
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALID-CPF-COMPLETE
  MOVE TRUE TO #CPF-VALID
  MOVE #CPF TO #CPF-STR
*
* EXTRACT DIGITS
  FOR #I = 1 TO 11
    DECIDE ON FIRST VALUE OF SUBSTR(#CPF-STR,#I,1)
      VALUE '0'
        MOVE 0 TO #DIG(#I)
      VALUE '1'
        MOVE 1 TO #DIG(#I)
      VALUE '2'
        MOVE 2 TO #DIG(#I)
      VALUE '3'
        MOVE 3 TO #DIG(#I)
      VALUE '4'
        MOVE 4 TO #DIG(#I)
      VALUE '5'
        MOVE 5 TO #DIG(#I)
      VALUE '6'
        MOVE 6 TO #DIG(#I)
      VALUE '7'
        MOVE 7 TO #DIG(#I)
      VALUE '8'
        MOVE 8 TO #DIG(#I)
      VALUE '9'
        MOVE 9 TO #DIG(#I)
      NONE VALUE
        MOVE FALSE TO #CPF-VALID
        ESCAPE ROUTINE
    END-DECIDE
  END-FOR
*
* CPF WITH ALL DIGITS EQUAL
  MOVE TRUE TO #ALL-EQUAL
  FOR #I = 2 TO 11
    IF #DIG(#I) NE #DIG(1)
      MOVE FALSE TO #ALL-EQUAL
      ESCAPE BOTTOM
    END-IF
  END-FOR
  IF #ALL-EQUAL
* EXCEPTION: CPF VALUES STARTING WITH 000 ARE VALID (GOVERNMENT TEST)
    IF #DIG(1) = 0 AND #DIG(2) = 0 AND #DIG(3) = 0
      MOVE TRUE TO #CPF-VALID
      ESCAPE ROUTINE
    END-IF
    MOVE FALSE TO #CPF-VALID
    ESCAPE ROUTINE
  END-IF
*
* FIRST CHECK DIGIT
  MOVE 0 TO #SUM
  MOVE 10 TO #WEIGHT
  FOR #I = 1 TO 9
    COMPUTE #SUM = #SUM + (#DIG(#I) * #WEIGHT)
    SUBTRACT 1 FROM #WEIGHT
  END-FOR
  COMPUTE #REMAIN = #SUM - ((#SUM / 11) * 11)
  IF #REMAIN < 2
    MOVE 0 TO #DV1
  ELSE
    COMPUTE #DV1 = 11 - #REMAIN
  END-IF
  IF #DV1 NE #DIG(10)
    MOVE FALSE TO #CPF-VALID
    ESCAPE ROUTINE
  END-IF
*
* SECOND CHECK DIGIT
  MOVE 0 TO #SUM
  MOVE 11 TO #WEIGHT
  FOR #I = 1 TO 10
    COMPUTE #SUM = #SUM + (#DIG(#I) * #WEIGHT)
    SUBTRACT 1 FROM #WEIGHT
  END-FOR
  COMPUTE #REMAIN = #SUM - ((#SUM / 11) * 11)
  IF #REMAIN < 2
    MOVE 0 TO #DV2
  ELSE
    COMPUTE #DV2 = 11 - #REMAIN
  END-IF
  IF #DV2 NE #DIG(11)
    MOVE FALSE TO #CPF-VALID
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALID-DATE
  MOVE TRUE TO #DT-VALID
  COMPUTE #YEAR = #DT-BIRTH / 10000
  COMPUTE #MONTH = (#DT-BIRTH - (#YEAR * 10000)) / 100
  COMPUTE #DAY = #DT-BIRTH - (#YEAR * 10000) - (#MONTH * 100)
*
* Y2K - REMEDIATION 08/1998 - BUG2000 PROJECT - R.SOUZA TEAM
* UNTIL 07/1998, BIRTH DATE ARRIVED AS YYMMDD (N6), AND THE
* CENTURY WAS RESOLVED BY THE LDA #L-CENTURY-WINDOW WINDOW.
* BLOCK RETAINED AS COMMENTS FOR HISTORICAL FILES - TICKET 2118
*    COMPUTE #L-AA-SHORT = #DT-BIRTH / 10000
*    IF #L-AA-SHORT < #L-CENTURY-WINDOW
*      COMPUTE #L-EXPANDED-YEAR = 2000 + #L-AA-SHORT
*    ELSE
*      COMPUTE #L-EXPANDED-YEAR = 1900 + #L-AA-SHORT
*    END-IF
*    MOVE #L-EXPANDED-YEAR TO #YEAR
*
  IF #YEAR < 1900 OR #YEAR > #YEAR-CURRENT
    MOVE FALSE TO #DT-VALID
    ESCAPE ROUTINE
  END-IF
  IF #MONTH < 1 OR #MONTH > 12
    MOVE FALSE TO #DT-VALID
    ESCAPE ROUTINE
  END-IF
  IF #DAY < 1 OR #DAY > #DAYS-MONTH(#MONTH)
    MOVE FALSE TO #DT-VALID
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALID-NAME
  MOVE TRUE TO #NAME-VALID
  IF #NAME = ' '
    MOVE FALSE TO #NAME-VALID
    ESCAPE ROUTINE
  END-IF
* CHECK FOR AT LEAST ONE SPACE (FIRST NAME + LAST NAME)
  MOVE FALSE TO #HAS-SPACE
  EXAMINE #NAME FOR ' ' GIVING POSITION #POS
  IF #POS > 1
    MOVE TRUE TO #HAS-SPACE
  END-IF
  IF NOT #HAS-SPACE
    MOVE FALSE TO #NAME-VALID
  END-IF
END-SUBROUTINE
*
END
