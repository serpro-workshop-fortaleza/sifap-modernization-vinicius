* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM: RELAUDIT
* SYSTEM:  SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:  ROBERTO MENDES JUNIOR
* DATE:    20/08/2002
* CHANGED: 12/12/2006 - ROBERTO MENDES - ADD FILTERS
* CHANGED: 30/04/2011 - ANDERSON LIMA  - ADJUST FORMAT
* CHANGED: 15/09/2014 - FERNANDA COSTA - CLEAN UP REPORT
* CHANGED: 18/06/2017 - PATRICIA GOMES - LOGICAL PRINTER 1
* CHANGED: 30/05/2018 - PATRICIA GOMES - ALIGN VIEW WITH DDM
* PURPOSE: SYSTEM AUDIT TRAIL REPORT
*          EVENT LIST WITH PERIOD/ACTION FILTERS
*          PRINTER/SCREEN OUTPUT - FILE 170
* EXECUTION: ON DEMAND - NOT SCHEDULED IN SIFAPJ02.
*            FOR OUTPUT=I THE JOB MUST ALLOCATE DD CMPRT01
*            USING THE SAME STANDARD AS SIFAPJ02 (LRECL=133).
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 AUDIT-V VIEW OF AUDIT
    2 NUM-AUDIT           (N15)
    2 DT-EVENT            (N8)
    2 HR-EVENT            (N6)
    2 USR-EVENT           (A8)
    2 COD-ACTION          (A2)
    2 TYPE-ENTITY         (A4)
    2 ID-ENTITY           (A15)
    2 AMT-PREV            (A60)
    2 AMT-NEW             (A60)
    2 DESCR-ACTION        (A80)
*
  1 #DT-START             (N8)
  1 #DT-END               (N8)
  1 #ACTION-FILTER        (A2)
  1 #USER-FILTER          (A8)
  1 #TABLE-FILTER         (A4)
  1 #DT-TODAY             (N8)
  1 #TYPE-OUTPUT          (A1)   /* T=SCREEN I=PRINTER */
*
* COUNTERS
  1 #QTY-TOTAL            (N8)
  1 #QTY-DISPLAYED        (N8)
  1 #QTY-FILTERED         (N8)
  1 #QTY-DAY              (N8)
*
* COUNTERS BY ACTION
  1 #QTY-INSERT           (N8)
  1 #QTY-UPDATE           (N8)
  1 #QTY-QUERY            (N8)
  1 #QTY-RECONCIL         (N8)
  1 #QTY-DIVERG           (N8)
  1 #QTY-OTHERS           (N8)
*
  1 #PAGE                 (N4)
  1 #LINE                 (N2)
  1 #MAX-LINES            (N2)
  1 #I                    (N2)
  1 #ACTION-DESCR         (A20)
  1 #HR-FORMAT            (A8)
  1 #HR-STR               (A6)
*
* PRINT SEPARATOR LINES
  1 #SEP-100              (A100)
  1 #SEP-120              (A120)
END-DEFINE
*
* LOGICAL PRINTER 1 - USED ONLY WHEN OUTPUT = I
DEFINE PRINTER (1) OUTPUT 'CMPRT01'
FORMAT (1) PS=66 LS=132
*
MOVE *DATN TO #DT-TODAY
MOVE 66 TO #MAX-LINES
MOVE 0 TO #PAGE
MOVE 99 TO #LINE
MOVE 0 TO #QTY-TOTAL
MOVE 0 TO #QTY-DISPLAYED
MOVE 0 TO #QTY-FILTERED
MOVE 0 TO #QTY-DAY
MOVE 0 TO #QTY-INSERT
MOVE 0 TO #QTY-UPDATE
MOVE 0 TO #QTY-QUERY
MOVE 0 TO #QTY-RECONCIL
MOVE 0 TO #QTY-DIVERG
MOVE 0 TO #QTY-OTHERS
*
MOVE ALL '-' TO #SEP-100
MOVE ALL '-' TO #SEP-120
*
INPUT 'SIFAP - AUDIT REPORT' /
      '============================' /
      'START DATE.......:' #DT-START /
      'END DATE.........:' #DT-END /
      'ACTION (BLANK=ALL):' #ACTION-FILTER /
      'USER (BLANK=ALL)..:' #USER-FILTER /
      'TABLE (BLANK=ALL).:' #TABLE-FILTER /
      'OUTPUT (T=SCREEN I=PRINT):' #TYPE-OUTPUT
*
IF #TYPE-OUTPUT = ' '
  MOVE 'T' TO #TYPE-OUTPUT
END-IF
*
IF #DT-START = 0
  MOVE 19970101 TO #DT-START
END-IF
IF #DT-END = 0
  MOVE #DT-TODAY TO #DT-END
END-IF
*
* PROCESSING
READ AUDIT-V BY DT-EVENT STARTING FROM #DT-START
     THRU #DT-END
*
  AT START OF DATA
    RESET #QTY-TOTAL #QTY-DISPLAYED #QTY-FILTERED #QTY-DAY
  END-START
*
  IF AUDIT-V.DT-EVENT < #DT-START
    ESCAPE TOP
  END-IF
  IF AUDIT-V.DT-EVENT > #DT-END
    ESCAPE BOTTOM
  END-IF
*
  ADD 1 TO #QTY-TOTAL
*
* ============================================
* ACTION FILTER - DELETIONS ARE NOT DISPLAYED
* ============================================
  IF AUDIT-V.COD-ACTION = 'EX'
    ADD 1 TO #QTY-FILTERED
    ESCAPE TOP
  END-IF
*
* ACTION FILTER (IF PROVIDED)
  IF #ACTION-FILTER NE ' '
    IF AUDIT-V.COD-ACTION NE #ACTION-FILTER
      ADD 1 TO #QTY-FILTERED
      ESCAPE TOP
    END-IF
  END-IF
*
* USER FILTER (IF PROVIDED)
  IF #USER-FILTER NE ' '
    IF AUDIT-V.USR-EVENT NE #USER-FILTER
      ADD 1 TO #QTY-FILTERED
      ESCAPE TOP
    END-IF
  END-IF
*
* TABLE FILTER (IF PROVIDED)
  IF #TABLE-FILTER NE ' '
    IF AUDIT-V.TYPE-ENTITY NE #TABLE-FILTER
      ADD 1 TO #QTY-FILTERED
      ESCAPE TOP
    END-IF
  END-IF
*
  ADD 1 TO #QTY-DISPLAYED
  ADD 1 TO #QTY-DAY
*
* COUNTERS BY ACTION TYPE
  DECIDE ON FIRST VALUE OF AUDIT-V.COD-ACTION
    VALUE 'IN'
      ADD 1 TO #QTY-INSERT
      MOVE 'INSERTION' TO #ACTION-DESCR
    VALUE 'AL'
      ADD 1 TO #QTY-UPDATE
      MOVE 'CHANGE' TO #ACTION-DESCR
    VALUE 'CO'
      ADD 1 TO #QTY-RECONCIL
      MOVE 'RECONCILIATION' TO #ACTION-DESCR
    VALUE 'CN'
      ADD 1 TO #QTY-QUERY
      MOVE 'QUERY' TO #ACTION-DESCR
    VALUE 'DV'
      ADD 1 TO #QTY-DIVERG
      MOVE 'DISCREPANCY' TO #ACTION-DESCR
    NONE
      ADD 1 TO #QTY-OTHERS
      MOVE 'OTHER' TO #ACTION-DESCR
  END-DECIDE
*
* FORMAT TIME
  MOVE EDITED AUDIT-V.HR-EVENT (EM=999999) TO #HR-STR
  COMPRESS SUBSTR(#HR-STR,1,2) ':' SUBSTR(#HR-STR,3,2) ':'
           SUBSTR(#HR-STR,5,2) INTO #HR-FORMAT LEAVING NO SPACE
*
* PAGINATION
  IF #LINE >= (#MAX-LINES - 5)
    PERFORM PRINT-AUDIT-HEADER
  END-IF
*
* PRINT DETAIL
  IF #TYPE-OUTPUT = 'T'
    WRITE AUDIT-V.DT-EVENT ' '
          #HR-FORMAT ' '
          AUDIT-V.USR-EVENT ' '
          #ACTION-DESCR ' '
          AUDIT-V.TYPE-ENTITY ' '
          AUDIT-V.ID-ENTITY
  ELSE
    WRITE (1) AUDIT-V.DT-EVENT ' '
          #HR-FORMAT ' '
          AUDIT-V.USR-EVENT ' '
          #ACTION-DESCR ' '
          AUDIT-V.TYPE-ENTITY ' '
          AUDIT-V.ID-ENTITY ' '
          AUDIT-V.DESCR-ACTION
  END-IF
  ADD 1 TO #LINE
*
* CONTROL BREAK BY DAY - TICKET 7734/2017
* SUBTOTAL ONLY ON PRINTER TO AVOID CHANGING THE SCREEN
  AT BREAK OF AUDIT-V.DT-EVENT
    IF #TYPE-OUTPUT NE 'T'
      WRITE (1) '   DAY SUBTOTAL' OLD(AUDIT-V.DT-EVENT)
                ':' #QTY-DAY 'EVENTS'
      ADD 1 TO #LINE
    END-IF
    MOVE 0 TO #QTY-DAY
  END-BREAK
*
* PRINTER GRAND TOTAL
  AT END OF DATA
    IF #TYPE-OUTPUT NE 'T'
      WRITE (1) #SEP-120
      WRITE (1) 'TOTAL EVENTS DISPLAYED:' #QTY-DISPLAYED
    END-IF
  END-ENDDATA
*
END-READ
*
* SUMMARY
WRITE ' ' /
      '====================================' /
      'AUDIT SUMMARY' /
      '====================================' /
      'TOTAL RECORDS......:' #QTY-TOTAL /
      'DISPLAYED..........:' #QTY-DISPLAYED /
      'FILTERED...........:' #QTY-FILTERED /
      ' ' /
      'BY ACTION TYPE:' /
      '  INSERTIONS.......:' #QTY-INSERT /
      '  CHANGES..........:' #QTY-UPDATE /
      '  QUERIES..........:' #QTY-QUERY /
      '  RECONCILIATIONS..:' #QTY-RECONCIL /
      '  DISCREPANCIES....:' #QTY-DIVERG /
      '  OTHER............:' #QTY-OTHERS /
      '===================================='
*
* ============================================
* EVENT DISTRIBUTION BY DAY (HISTOGRAM)
* PRINTER ONLY - TICKET 7734/2017
* ============================================
IF #TYPE-OUTPUT NE 'T'
  WRITE (1) ' '
  WRITE (1) 'EVENT DISTRIBUTION BY DAY'
  WRITE (1) #SEP-100
  HISTOGRAM AUDIT-V FOR DT-EVENT
            STARTING FROM #DT-START THRU #DT-END
    WRITE (1) 'DATE:' AUDIT-V.DT-EVENT
              '  OCCURRENCES:' *NUMBER
  END-HISTOGRAM
  WRITE (1) #SEP-100
END-IF
*
* ============================================
* NATURAL ERROR HANDLING - TICKET 5512/2005
* ============================================
ON ERROR
  WRITE 'NATURAL ERROR:' *ERROR-NR
        'LINE:' *ERROR-LINE
        'PGM:' *PROGRAM
  TERMINATE 12
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE PRINT-AUDIT-HEADER
  ADD 1 TO #PAGE
  IF #TYPE-OUTPUT = 'T'
    WRITE '/'
    WRITE 'SIFAP - AUDIT TRAIL'
          40X 'PAGE:' #PAGE
    WRITE 'PERIOD:' #DT-START 'TO' #DT-END
          40X 'DATE:' #DT-TODAY
    WRITE #SEP-100 (AL=78)
    WRITE 'DATE       TIME     USER     ACTION'
          20X 'TABLE          KEY'
    WRITE #SEP-100 (AL=78)
  ELSE
    NEWPAGE (1)
    WRITE (1) NOTITLE 'SIFAP - AUDIT TRAIL'
          40X 'PAGE:' #PAGE
    WRITE (1) 'PERIOD:' #DT-START 'TO' #DT-END
          40X 'DATE:' #DT-TODAY
    WRITE (1) #SEP-120
    WRITE (1) 'DATE       TIME     USER     ACTION'
          20X 'TABLE          KEY                 DESCRIPTION'
    WRITE (1) #SEP-120
  END-IF
  MOVE 7 TO #LINE
END-SUBROUTINE
*
END
