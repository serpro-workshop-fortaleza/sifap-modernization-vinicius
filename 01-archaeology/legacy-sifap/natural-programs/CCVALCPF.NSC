* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* COPYCODE: CCVALCPF
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   CARLOS ROBERTO DA SILVA
* DATE:     15/03/1997
* CHANGED:  17/05/2005 - MARCIA HELENA - ADD EQUAL-DIGIT CHECK
* CHANGED:  07/06/2011 - ROBERTO MENDES - DIVIDE WITH REMAINDER
* PURPOSE:  STANDARD CPF VALIDATION ROUTINE - MODULUS 11.
*           THIS IS THE SIFAP STANDARD VERSION (NT-SUPDE-014).
*           PROVIDES THE VALID-CPF-STANDARD SUBROUTINE.
*
* USE:      1. DECLARE REQUIRED FIELDS IN DEFINE DATA
*           2. MOVE THE CPF TO #CPF-STR
*           3. PERFORM VALID-CPF-STANDARD
*           4. TEST #CPF-OK
*           5. PLACE "INCLUDE CCVALCPF" AT THE END OF THE MODULE,
*              IN THE SUBROUTINE AREA, BEFORE "END"
*
* REQUIRED FIELDS IN THE INCLUDING MODULE'S DEFINE DATA:
*           1 #CPF-STR          (A11)       /* IN
*           1 #CPF-OK           (L)         /* OUT
*           1 #CPF-DIG          (N1/1:11)   /* WORK
*           1 #CPF-SUM          (N5)        /* WORK
*           1 #CPF-QUOT         (N5)        /* WORK
*           1 #CPF-REMAIN       (N2)        /* WORK
*           1 #CPF-DV1          (N1)        /* WORK
*           1 #CPF-DV2          (N1)        /* WORK
*           1 #CPF-WEIGHT       (N2)        /* WORK
*           1 #CPF-IDX          (N2)        /* WORK
*           1 #CPF-EQUAL        (L)         /* WORK
*
* NOTE:     INLINE COPIES OF THIS ROUTINE EXIST IN OTHER
*           SIFAP MODULES WITH DIFFERENT BEHAVIOR.
*           THE COPIES HAVE NOT BEEN REPLACED.
*           TICKET 6620/2011 - OPEN.
*           >>> DO NOT CHANGE THIS ROUTINE WITHOUT COMPARING THE
*           >>> COPIES - THEY ARE NOT EQUIVALENT.
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALID-CPF-STANDARD
*
  MOVE TRUE TO #CPF-OK
  RESET #CPF-SUM #CPF-QUOT #CPF-REMAIN #CPF-DV1 #CPF-DV2
*
* CPF MUST BE ENTIRELY NUMERIC
  IF #CPF-STR NE MASK(NNNNNNNNNNN)
    MOVE FALSE TO #CPF-OK
    ESCAPE ROUTINE
  END-IF
*
* EXTRACT THE 11 DIGITS
  FOR #CPF-IDX = 1 TO 11
    DECIDE ON FIRST VALUE OF SUBSTR(#CPF-STR,#CPF-IDX,1)
      VALUE '0'
        MOVE 0 TO #CPF-DIG(#CPF-IDX)
      VALUE '1'
        MOVE 1 TO #CPF-DIG(#CPF-IDX)
      VALUE '2'
        MOVE 2 TO #CPF-DIG(#CPF-IDX)
      VALUE '3'
        MOVE 3 TO #CPF-DIG(#CPF-IDX)
      VALUE '4'
        MOVE 4 TO #CPF-DIG(#CPF-IDX)
      VALUE '5'
        MOVE 5 TO #CPF-DIG(#CPF-IDX)
      VALUE '6'
        MOVE 6 TO #CPF-DIG(#CPF-IDX)
      VALUE '7'
        MOVE 7 TO #CPF-DIG(#CPF-IDX)
      VALUE '8'
        MOVE 8 TO #CPF-DIG(#CPF-IDX)
      VALUE '9'
        MOVE 9 TO #CPF-DIG(#CPF-IDX)
      NONE VALUE
        MOVE FALSE TO #CPF-OK
        ESCAPE ROUTINE
    END-DECIDE
  END-FOR
*
* REJECT CPF WITH ALL DIGITS EQUAL
  MOVE TRUE TO #CPF-EQUAL
  FOR #CPF-IDX = 2 TO 11
    IF #CPF-DIG(#CPF-IDX) NE #CPF-DIG(1)
      MOVE FALSE TO #CPF-EQUAL
      ESCAPE BOTTOM
    END-IF
  END-FOR
  IF #CPF-EQUAL
    MOVE FALSE TO #CPF-OK
    ESCAPE ROUTINE
  END-IF
*
* FIRST CHECK DIGIT - WEIGHTS 10 TO 2
  MOVE 10 TO #CPF-WEIGHT
  FOR #CPF-IDX = 1 TO 9
    COMPUTE #CPF-SUM = #CPF-SUM
                      + (#CPF-DIG(#CPF-IDX) * #CPF-WEIGHT)
    SUBTRACT 1 FROM #CPF-WEIGHT
  END-FOR
  DIVIDE 11 INTO #CPF-SUM GIVING #CPF-QUOT
                           REMAINDER #CPF-REMAIN
  IF #CPF-REMAIN < 2
    MOVE 0 TO #CPF-DV1
  ELSE
    COMPUTE #CPF-DV1 = 11 - #CPF-REMAIN
  END-IF
  IF #CPF-DV1 NE #CPF-DIG(10)
    MOVE FALSE TO #CPF-OK
    ESCAPE ROUTINE
  END-IF
*
* SECOND CHECK DIGIT - WEIGHTS 11 TO 2
  RESET #CPF-SUM
  MOVE 11 TO #CPF-WEIGHT
  FOR #CPF-IDX = 1 TO 10
    COMPUTE #CPF-SUM = #CPF-SUM
                      + (#CPF-DIG(#CPF-IDX) * #CPF-WEIGHT)
    SUBTRACT 1 FROM #CPF-WEIGHT
  END-FOR
  DIVIDE 11 INTO #CPF-SUM GIVING #CPF-QUOT
                           REMAINDER #CPF-REMAIN
  IF #CPF-REMAIN < 2
    MOVE 0 TO #CPF-DV2
  ELSE
    COMPUTE #CPF-DV2 = 11 - #CPF-REMAIN
  END-IF
  IF #CPF-DV2 NE #CPF-DIG(11)
    MOVE FALSE TO #CPF-OK
  END-IF
*
END-SUBROUTINE
