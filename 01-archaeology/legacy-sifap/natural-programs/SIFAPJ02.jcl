//*==================================================================
//* JOB......: SIFAPJ02
//* SYSTEM...: SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
//* PDS......: SIFAP.PROD.JCLLIB(SIFAPJ02)
//* AUTHOR...: PATRICIA GOMES DE SOUZA
//* DATE.....: 10/11/1999
//* CHANGED..: 25/03/2004 - ANA LUCIA     - ADD RELPGT STEP
//* CHANGED..: 20/04/2006 - ROBERTO MENDES - REGION SUBTOTALS
//* CHANGED..: 14/02/2013 - ANDERSON LIMA - ADJUST 132 FORMAT
//* PURPOSE..: MONTHLY REPORTS - BATCHREL (CONSOLIDATED) AND
//*            RELPGT (DETAIL BY PROGRAM)
//*==================================================================
//* SCHEDULING (CONTROL-M)
//*   TABLE.........: SIFAP-MENSAL
//*   JOB NAME......: SIFAPJ02
//*   GROUP.........: SIFAP-REL
//*   FREQUENCY.....: MONTHLY - 2ND BUSINESS DAY
//*   TIME..........: 06:00  1H WINDOW
//*   IN CONDITION..: SIFAP-PGT-OK ODAT
//*   PREDECESSOR...: SIFAPJ01 (RC=0)
//*   OUT CONDITION.: SIFAP-REL-OK ODAT
//*==================================================================
//* PRINTING
//*   THE PROGRAMS ALLOCATE LOGICAL PRINTERS WITH:
//*     DEFINE PRINTER (1) OUTPUT 'CMPRT01'
//*     DEFINE PRINTER (2) OUTPUT 'CMPRT02'
//*     FORMAT (1) PS=66 LS=132
//*     FORMAT (2) PS=66 LS=132
//*   EACH LOGICAL PRINTER REQUIRES A DD WITH THE SAME NAME IN THIS
//*   JCL. A LOGICAL PRINTER WITHOUT A CORRESPONDING DD CAUSES
//*   NAT1500 AT RUNTIME.
//*==================================================================
//* RESTART
//*   BOTH STEPS ARE READ-ONLY ON FILE 152.
//*   A FULL RERUN IS SAFE AND DOES NOT DUPLICATE DATA.
//*   SIMPLY RERUN THE JOB FROM THE BEGINNING.
//*==================================================================
//SIFAPJ02 JOB (SIFAP,DESIF),'SIFAP REPORTS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=60,NOTIFY=&SYSUID
//*
//JOBLIB   DD DSN=SIFAP.PROD.LOADLIB,DISP=SHR
//         DD DSN=SAG.NAT426.LOAD,DISP=SHR
//         DD DSN=SAG.ADA614.LOAD,DISP=SHR
//*
//*------------------------------------------------------------------
//* STEP010 - CONSOLIDATED REPORT (BATCHREL)
//*------------------------------------------------------------------
//STEP010  EXEC PGM=NATBATCH,
//             PARM='IM=D,MADIO=0,MT=0,DBID=57,FNR=152'
//STEPLIB  DD DSN=SAG.NAT426.LOAD,DISP=SHR
//         DD DSN=SAG.ADA614.LOAD,DISP=SHR
//DDCARD   DD DSN=SIFAP.PROD.PARMLIB(ADAPARM),DISP=SHR
//CMPRINT  DD SYSOUT=*
//*
//* LOGICAL PRINTER 1 - CONSOLIDATED REPORT FOR PRINT CENTER
//CMPRT01  DD SYSOUT=A,DEST=CENTRAL,
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=13300)
//*
//* FILE COPY FOR 10-YEAR RETENTION (LAW 8159 ART 14)
//CMWKF01  DD DSN=SIFAP.PROD.REL.CONSOL(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(50,20),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=27852)
//*
//CMSYNIN  DD *
LOGON SIFAPPRD
BATCHREL
202601
FIN
/*
//*
//*------------------------------------------------------------------
//* STEP020 - DETAIL REPORT (RELPGT)
//* RUNS ONLY IF STEP010 ENDED WITH RC LESS THAN OR EQUAL TO 4
//*------------------------------------------------------------------
//STEP020  EXEC PGM=NATBATCH,COND=(4,LT,STEP010),
//             PARM='IM=D,MADIO=0,MT=0,DBID=57,FNR=152'
//STEPLIB  DD DSN=SAG.NAT426.LOAD,DISP=SHR
//         DD DSN=SAG.ADA614.LOAD,DISP=SHR
//DDCARD   DD DSN=SIFAP.PROD.PARMLIB(ADAPARM),DISP=SHR
//CMPRINT  DD SYSOUT=*
//*
//* LOGICAL PRINTER 1 - DETAIL BY SOCIAL PROGRAM
//CMPRT01  DD SYSOUT=A,DEST=CENTRAL,
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=13300)
//*
//* LOGICAL PRINTER 2 - SUMMARY FOR COORDINATION (SENARC)
//CMPRT02  DD SYSOUT=A,DEST=SENARC,COPIES=2,
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=13300)
//*
//* CMSYNIN - START PERIOD, END PERIOD, AND PROGRAM FILTER
//* PROGRAM 0000 = ALL
//CMSYNIN  DD *
LOGON SIFAPPRD
RELPGT
202601
202601
0000
FIN
/*
//*
//*==================================================================
//* EXPECTED RETURN CODES
//*   RC=0  - REPORTS GENERATED
//*   RC=4  - GENERATED WITH NO ACTIVITY IN THE PERIOD
//*   RC=12 - NATURAL ERROR - CHECK CMPRINT AND CONTACT ON-CALL
//*==================================================================
