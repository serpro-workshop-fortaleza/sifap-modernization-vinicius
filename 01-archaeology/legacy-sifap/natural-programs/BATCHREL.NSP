* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM: BATCHREL
* SYSTEM:  SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:  PATRICIA GOMES DE SOUZA
* DATE:    10/11/1999
* CHANGED: 20/04/2006 - ROBERTO MENDES - ADD REGION SUBTOTALS
* CHANGED: 09/10/2006 - ROBERTO MENDES - CONTROL BREAK
* CHANGED: 14/02/2013 - ANDERSON LIMA  - ADJUST FORMAT
* CHANGED: 05/06/2014 - SIFAP TEAM     - COPY CMWKF01
* PURPOSE: GENERATE MONTHLY CONSOLIDATED REPORTS
*          SUMMARIZE BY REGION/PROGRAM/STATUS
*          FLAT-FILE OUTPUT FOR MAINFRAME PRINTING
*
* JOB.....: SIFAPJ02 - STEP010 - PGM=NATBATCH
* INPUT...: CMSYNIN - YYYYMM PERIOD
* OUTPUT..: CMPRT01 - PRINTED REPORT       (LRECL 133)
*           CMWKF01 - ARCHIVAL COPY        (LRECL 132)
*           CMPRINT - EXECUTION LOG
* RETURN..: 0=OK  4=NO ACTIVITY  12=NATURAL ERROR
* NOTE....: 10-YEAR RETENTION - LAW 8159 ART 14
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 PAYMENT-V VIEW OF PAYMENT
    2 NUM-PAYMENT            (N15)
    2 NUM-CPF                (A11)
    2 COD-PROGRAM            (A4)
    2 YEAR-MONTH-REF         (N6)
    2 AMT-GROSS              (P9.2)
    2 AMT-DISC-TOTAL         (P7.2)
    2 AMT-NET                (P9.2)
    2 STAT-PAYMENT           (A1)
    2 TYPE-PAYMENT           (A1)
    2 AMT-BONUS              (P9.2)
*
  1 BENEFICIARY-V VIEW OF BENEFIC
    2 NUM-CPF                (A11)
    2 COD-REGION             (A2)
    2 UF                     (A2)
*
  1 #PERIOD                (N6)
  1 #DT-TODAY              (N8)
*
* ACCUMULATORS BY REGION (5 REGIONS)
  1 #TOT-REGION-GROSS      (P13.2/1:5)
  1 #TOT-REGION-DISC       (P13.2/1:5)
  1 #TOT-REGION-NET        (P13.2/1:5)
  1 #QTY-REGION            (N8/1:5)
  1 #NAME-REGION           (A15/1:5)
*
* ACCUMULATORS BY STATUS
  1 #TOT-STS-GROSS         (P13.2/1:5)
  1 #QTY-STS               (N8/1:5)
  1 #NAME-STS              (A15/1:5)
*
* GRAND TOTALS
  1 #TOT-OVERALL-GROSS     (P15.2)
  1 #TOT-OVERALL-DISC      (P15.2)
  1 #TOT-OVERALL-NET       (P15.2)
  1 #QTY-OVERALL           (N8)
*
* AUXILIARY VARIABLES
  1 #IDX-REGION            (N2)
  1 #COD-REGION            (N2)
  1 #STATUS                (A1)
  1 #IDX-STS               (N2)
  1 #I                     (N2)
  1 #FOUND                 (L)
  1 #LINE-REPORT           (A132)
  1 #PAGE                  (N4)
  1 #LINE                  (N2)
  1 #MAX-LINES             (N2)
*
* REPORT ROUNDING
  1 #AMT-ROUND             (P13.2)
  1 #AMT-TEMP              (N15)
END-DEFINE
*
* SIFAPJ02 LOGICAL PRINTER - DD CMPRT01
DEFINE PRINTER (1) OUTPUT 'CMPRT01'
FORMAT (1) PS=66 LS=132
*
MOVE *DATN TO #DT-TODAY
MOVE 66 TO #MAX-LINES  /* MAINFRAME PRINTER STANDARD */
MOVE 0 TO #PAGE
MOVE 99 TO #LINE  /* FORCE HEADER ON FIRST PAGE */
*
* REGION NAMES
MOVE 'NORTH' TO #NAME-REGION(1)
MOVE 'NORTHEAST' TO #NAME-REGION(2)
MOVE 'SOUTHEAST' TO #NAME-REGION(3)
MOVE 'SOUTH' TO #NAME-REGION(4)
MOVE 'CENTRAL-WEST' TO #NAME-REGION(5)
*
* STATUS NAMES
MOVE 'GENERATED' TO #NAME-STS(1)
MOVE 'PAID' TO #NAME-STS(2)
MOVE 'CANCELED' TO #NAME-STS(3)
MOVE 'RETURNED' TO #NAME-STS(4)
MOVE 'REVERSED' TO #NAME-STS(5)
*
* INITIALIZE ACCUMULATORS
FOR #I = 1 TO 5
  MOVE 0 TO #TOT-REGION-GROSS(#I)
  MOVE 0 TO #TOT-REGION-DISC(#I)
  MOVE 0 TO #TOT-REGION-NET(#I)
  MOVE 0 TO #QTY-REGION(#I)
  MOVE 0 TO #TOT-STS-GROSS(#I)
  MOVE 0 TO #QTY-STS(#I)
END-FOR
MOVE 0 TO #TOT-OVERALL-GROSS
MOVE 0 TO #TOT-OVERALL-DISC
MOVE 0 TO #TOT-OVERALL-NET
MOVE 0 TO #QTY-OVERALL
*
* PERIOD PROVIDED BY SIFAPJ02 CMSYNIN
INPUT 'REPORT PERIOD:' #PERIOD
IF #PERIOD = 0
  WRITE 'PERIOD NOT PROVIDED IN CMSYNIN'
  TERMINATE 12
END-IF
*
* PROCESSING - READ PAYMENTS
READ PAYMENT-V BY YEAR-MONTH-REF = #PERIOD
*
* CONTROL BREAK BY PERIOD - TICKET 3990/2006
  AT BREAK OF PAYMENT-V.YEAR-MONTH-REF
    WRITE 'PERIOD BREAK - RECORDS READ SO FAR:' #QTY-OVERALL
  END-BREAK
*
  AT END OF DATA
    WRITE 'END OF FILE - TOTAL READ:' #QTY-OVERALL
  END-ENDDATA
*
  IF PAYMENT-V.YEAR-MONTH-REF NE #PERIOD
    ESCAPE BOTTOM
  END-IF
*
* FIND BENEFICIARY REGION
  MOVE 0 TO #COD-REGION
  FIND BENEFICIARY-V WITH NUM-CPF = PAYMENT-V.NUM-CPF
    COMPUTE #COD-REGION = VAL(BENEFICIARY-V.COD-REGION)
  END-FIND
*
* DETERMINE REGION INDEX
  IF #COD-REGION >= 1 AND #COD-REGION <= 5
    MOVE 1 TO #IDX-REGION
  ELSE
    IF #COD-REGION >= 6 AND #COD-REGION <= 10
      MOVE 2 TO #IDX-REGION
    ELSE
      IF #COD-REGION >= 11 AND #COD-REGION <= 15
        MOVE 3 TO #IDX-REGION
      ELSE
        IF #COD-REGION >= 16 AND #COD-REGION <= 20
          MOVE 4 TO #IDX-REGION
        ELSE
          MOVE 5 TO #IDX-REGION
        END-IF
      END-IF
    END-IF
  END-IF
*
* ACCUMULATE BY REGION
* NOTE: ROUNDING DIFFERS FROM CALCBENF (ROUND VS TRUNCATE)
  COMPUTE #AMT-ROUND = PAYMENT-V.AMT-GROSS + 0.005
  COMPUTE #AMT-TEMP = #AMT-ROUND * 100
  COMPUTE #AMT-ROUND = #AMT-TEMP / 100
  ADD #AMT-ROUND TO #TOT-REGION-GROSS(#IDX-REGION)
  ADD PAYMENT-V.AMT-DISC-TOTAL
      TO #TOT-REGION-DISC(#IDX-REGION)
  ADD PAYMENT-V.AMT-NET  TO #TOT-REGION-NET(#IDX-REGION)
  ADD 1 TO #QTY-REGION(#IDX-REGION)
*
* ACCUMULATE BY STATUS
  DECIDE ON FIRST VALUE OF PAYMENT-V.STAT-PAYMENT
    VALUE 'G'
      MOVE 1 TO #IDX-STS
    VALUE 'P'
      MOVE 2 TO #IDX-STS
    VALUE 'C'
      MOVE 3 TO #IDX-STS
    VALUE 'D'
      MOVE 4 TO #IDX-STS
    VALUE 'E'
      MOVE 5 TO #IDX-STS
    NONE
      MOVE 1 TO #IDX-STS
  END-DECIDE
  ADD PAYMENT-V.AMT-GROSS TO #TOT-STS-GROSS(#IDX-STS)
  ADD 1 TO #QTY-STS(#IDX-STS)
*
* ACCUMULATE GRAND TOTALS
  ADD #AMT-ROUND TO #TOT-OVERALL-GROSS
  ADD PAYMENT-V.AMT-DISC-TOTAL TO #TOT-OVERALL-DISC
  ADD PAYMENT-V.AMT-NET  TO #TOT-OVERALL-NET
  ADD 1 TO #QTY-OVERALL
*
END-READ
*
* NO ACTIVITY IN PERIOD - RC=4 IN SIFAPJ02
IF #QTY-OVERALL = 0
  WRITE 'NO PAYMENTS IN PERIOD' #PERIOD
  TERMINATE 4
END-IF
*
* PRINT REPORT
PERFORM PRINT-HEADER
*
WRITE (1) 'SUMMARY BY REGION'
WRITE (1) '=========================================='
FOR #I = 1 TO 5
  WRITE (1) #NAME-REGION(#I) '  QTY:' #QTY-REGION(#I)
        '  GROSS:' #TOT-REGION-GROSS(#I)
        '  DEDUCT:' #TOT-REGION-DISC(#I)
        '  NET:' #TOT-REGION-NET(#I)
* ARCHIVAL COPY CMWKF01 - TICKET 7120/2014
  RESET #LINE-REPORT
  COMPRESS 'REG' #NAME-REGION(#I) #QTY-REGION(#I)
      #TOT-REGION-GROSS(#I) #TOT-REGION-DISC(#I)
      #TOT-REGION-NET(#I) INTO #LINE-REPORT
  WRITE WORK FILE 1 #LINE-REPORT
END-FOR
*
WRITE (1) ' '
WRITE (1) 'SUMMARY BY STATUS'
WRITE (1) '=========================================='
FOR #I = 1 TO 5
  WRITE (1) #NAME-STS(#I) '  QTY:' #QTY-STS(#I)
        '  GROSS:' #TOT-STS-GROSS(#I)
  RESET #LINE-REPORT
  COMPRESS 'STS' #NAME-STS(#I) #QTY-STS(#I)
      #TOT-STS-GROSS(#I) INTO #LINE-REPORT
  WRITE WORK FILE 1 #LINE-REPORT
END-FOR
*
WRITE (1) ' '
WRITE (1) '=========================================='
WRITE (1) 'GRAND TOTAL  QTY:' #QTY-OVERALL
      '  GROSS:' #TOT-OVERALL-GROSS
      '  DEDUCT:' #TOT-OVERALL-DISC
      '  NET:' #TOT-OVERALL-NET
WRITE (1) '=========================================='
*
RESET #LINE-REPORT
COMPRESS 'TOT' #PERIOD #QTY-OVERALL #TOT-OVERALL-GROSS
    #TOT-OVERALL-DISC #TOT-OVERALL-NET INTO #LINE-REPORT
WRITE WORK FILE 1 #LINE-REPORT
CLOSE WORK FILE 1
*
WRITE 'BATCHREL COMPLETED - RECORDS:' #QTY-OVERALL
TERMINATE 0
*
* --------------------------------------------------------
* NATURAL ERROR HANDLING - TICKET 4182/2004
* --------------------------------------------------------
ON ERROR
  WRITE 'NATURAL ERROR NO.:' *ERROR-NR
  WRITE 'LINE.............:' *ERROR-LINE
  WRITE 'PROGRAM..........:' *PROGRAM
  WRITE 'PERIOD...........:' #PERIOD
  BACKOUT TRANSACTION
  CLOSE WORK FILE 1
  TERMINATE 12
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE PRINT-HEADER
  ADD 1 TO #PAGE
  WRITE (1) '/' /* FORM FEED */
  WRITE (1) 'SIFAP - MONTHLY CONSOLIDATED REPORT'
        52X 'PAGE:' #PAGE
  WRITE (1) 'PERIOD:' #PERIOD
        52X 'DATE:' #DT-TODAY
  WRITE (1) '------------------------------------------------------------'
  MOVE 5 TO #LINE
END-SUBROUTINE
*
END
