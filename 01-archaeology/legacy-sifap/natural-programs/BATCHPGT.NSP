* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM: BATCHPGT
* SYSTEM:  SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:  CARLOS ROBERTO DA SILVA
* DATE:    22/06/1997
* CHANGED: 12/08/1998 - R.SOUZA        - Y2K CENTURY WINDOW
* CHANGED: 15/01/2000 - CARLOS SILVA   - OPTIMIZE CPF ORDER
* CHANGED: 30/08/2004 - PATRICIA GOMES - ADD ERROR LOG
* CHANGED: 18/12/2009 - JOSE FERREIRA  - ADJUST 13TH/BONUS
* CHANGED: 30/09/2011 - ROBERTO MENDES - ADD CALLNAT CHAIN
* CHANGED: 25/05/2012 - FERNANDA COSTA - NEW BRACKETS
* CHANGED: 10/07/2015 - ANDERSON LIMA  - ADD AUDITING
* CHANGED: 18/03/2016 - SIFAP TEAM     - CMWKF01 EXTRACT
* PURPOSE: MONTHLY BATCH PAYMENT GENERATION
*          CRITICAL BATCH - RUNS ON 1ST BUSINESS DAY
*          PROCESSES ALL ACTIVE BENEFICIARIES ORDERED BY CPF
*          CALLS CALCBENF AND CALCDSCT - FILES 150/160/155
*
* JOB.....: SIFAPJ01 - STEP010 - PGM=NATBATCH
* INPUT...: CMSYNIN - YYYYMM PERIOD (TICKET 5980)
* OUTPUT..: CMWKF01 - TRANSMISSION EXTRACT (LRECL 240)
*           CMWKF02 - REJECTED RECORDS LOG (LRECL 120)
*           CMPRINT - EXECUTION LOG
* RETURN..: 0=OK  4=WITH REJECTED RECORDS  8=NOTHING TO DO
*           12=NATURAL ERROR - CONTACT ON-CALL
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING PDAVALID
LOCAL USING PDACALC
LOCAL USING LDASIFAP
LOCAL
  1 BENEFICIARY-V VIEW OF BENEFIC
    2 NUM-CPF                (A11)
    2 FULL-NAME              (A60)
    2 DT-BIRTH               (N8)
    2 STAT-BENEFICIARY       (A1)
    2 COD-PROGRAM            (A4)
    2 AMT-FAMILY-INCOME      (P9.2)
    2 QTY-DEPEND             (N2)
    2 COD-REGION             (A2)
    2 UF                     (A2)
    2 NUM-NIS                (N11)
*
  1 PAYMENT-V VIEW OF PAYMENT
    2 NUM-PAYMENT            (N15)
    2 NUM-CPF                (A11)
    2 COD-PROGRAM            (A4)
    2 YEAR-MONTH-REF         (N6)
    2 AMT-GROSS              (P9.2)
    2 AMT-DISC-TOTAL         (P7.2)
    2 AMT-NET                (P9.2)
    2 DT-GENERATION          (N8)
    2 STAT-PAYMENT           (A1)
    2 TYPE-PAYMENT           (A1)
    2 AMT-BONUS              (P9.2)
    2 NUM-BATCH              (N8)
    2 SEQ-BATCH              (N6)
*
  1 PROGRAM-V VIEW OF SOCPROG
    2 COD-PROGRAM            (A4)
    2 TYPE-PROGRAM           (A1)
    2 AMT-BASE-INDIVIDUAL    (P7.2)
    2 FACTOR-ADJUST          (P3.4)
    2 STAT-PROGRAM           (A1)
    2 MAX-PERCAP-INCOME      (P7.2)
*
* AUDIT TRAIL - FILE 153 - REQUIRED BY CCAUDIT
  1 AUDIT-V VIEW OF AUDIT
    2 NUM-AUDIT              (N15)
    2 DT-EVENT               (N8)
    2 HR-EVENT               (N6)
    2 TS-EVENT               (N14)
    2 COD-ACTION             (A2)
    2 COD-MODULE             (A8)
    2 DESCR-ACTION           (A80)
    2 TYPE-ENTITY            (A4)
    2 ID-ENTITY              (A15)
    2 NUM-CPF-AFFECTED       (A11)
    2 USR-EVENT              (A8)
    2 NAME-JOB-BATCH         (A16)
    2 STAT-BATCH             (A1)
*
* COUNTERS AND ACCUMULATORS
  1 #QTY-PROCESSED         (N8)
  1 #QTY-ERRS              (N8)
  1 #QTY-IGNORED           (N8)
  1 #QTY-GENERATED         (N8)
  1 #QTY-REJECT            (N8)
  1 #AMT-TOT-GROSS         (P13.2)
  1 #AMT-TOT-DISC          (P13.2)
  1 #AMT-TOT-NET           (P13.2)
  1 #AMT-TOT-BONUS         (P13.2)
*
* CALCULATION VARIABLES
  1 #PERIOD                (N6)
  1 #PERIOD-A              (A6)
  1 #MONTH                 (N2)
  1 #YEAR                  (N4)
  1 #DT-TODAY              (N8)
  1 #AMT-BASE              (P9.2)
  1 #AMT-BENF              (P9.2)
  1 #AMT-GROSS             (P9.2)
  1 #AMT-DISC              (P9.2)
  1 #AMT-NET               (P9.2)
  1 #AMT-BONUS             (P9.2)
  1 #AMT-13                (P9.2)
  1 #AMT-TEMP              (N11)
  1 #FACTOR-REGION         (N3.4)
  1 #FACTOR-FAMILY         (N3.4)
  1 #FACTOR-INCOME         (N3.4)
  1 #FACTOR-AGE            (N3.4)
  1 #FACTOR-ADJUST         (N3.4)
  1 #AGE                   (N3)
  1 #YEAR-BIRTH            (N4)
  1 #NUM-DEPEND            (N2)
  1 #COD-REGION            (N2)
  1 #INCOME                (P9.2)
  1 #TYPE-PROG             (A1)
  1 #TYPE-PAYMENT          (A1)
  1 #STAT-PROG             (A1)
  1 #ERR-CALC              (L)
  1 #SEQ-PAYMENT           (N15)
  1 #MSG-LOG               (A120)
  1 #CPF-PREV              (A11)
  1 #KEY-CPF-PERIOD        (A17)
  1 #SEQ-PAYMENT-A         (A15)
  1 #AMT-NET-A             (A9)
  1 #QTY-QUOT              (N9)
  1 #QTY-REMAIN            (N4)
  1 #J                     (N2)
*
* REGIONAL FACTOR TABLE
  1 #TAB-REGION            (N3.4/1:27)
*
* INCOME BRACKETS
  1 #INCOME-BAND           (P9.2/1:5)
  1 #BAND-FACTOR           (N3.4/1:5)
*
* BATCH CONTROL - TICKET 3315/1999
  1 #NUM-BATCH             (N8)
  1 #SEQ-BATCH             (N6)
*
* WORK FILE AREA - DDS ALLOCATED IN SIFAPJ01
* CMWKF01 TRANSMISSION EXTRACT 240 - CMWKF02 REJECTS 120
  1 #REC-EXTRACT           (A240)
  1 #LOG-ERR               (A120)
*
* FIELDS REQUIRED BY COPYCODE CCAUDIT
  1 #AUD-ACTION            (A2)
  1 #AUD-ENTITY            (A4)
  1 #AUD-ID                (A15)
  1 #AUD-CPF               (A11)
  1 #AUD-DESCR             (A80)
  1 #AUD-SEQ               (N15)
  1 #AUD-TIMN              (N7)
END-DEFINE
*
MOVE *DATN TO #DT-TODAY
*
* CALCULATE PERIOD
COMPUTE #YEAR = #DT-TODAY / 10000
COMPUTE #MONTH = (#DT-TODAY - (#YEAR * 10000)) / 100
COMPUTE #PERIOD = (#YEAR * 100) + #MONTH
*
* --------------------------------------------------------
* PERIOD PROVIDED BY SIFAPJ01 CMSYNIN
* UNTIL 05/2012 IT WAS ALWAYS DERIVED FROM *DATN AND THERE WAS
* NO WAY TO REPROCESS A PREVIOUS MONTH - TICKET 5980/2012
* --------------------------------------------------------
INPUT #PERIOD
IF #PERIOD = 0
  COMPUTE #PERIOD = (#YEAR * 100) + #MONTH
END-IF
COMPUTE #YEAR = #PERIOD / 100
COMPUTE #MONTH = #PERIOD - (#YEAR * 100)
MOVE EDITED #PERIOD (EM=999999) TO #PERIOD-A
*
* INITIALIZE COUNTERS
MOVE 0 TO #QTY-PROCESSED
MOVE 0 TO #QTY-ERRS
MOVE 0 TO #QTY-IGNORED
MOVE 0 TO #QTY-GENERATED
MOVE 0 TO #QTY-REJECT
MOVE 0 TO #AMT-TOT-GROSS
MOVE 0 TO #AMT-TOT-DISC
MOVE 0 TO #AMT-TOT-NET
MOVE 0 TO #AMT-TOT-BONUS
MOVE 0 TO #SEQ-PAYMENT
MOVE 0 TO #SEQ-BATCH
MOVE #PERIOD TO #NUM-BATCH
*
* INITIALIZE REGIONAL FACTOR TABLE (SAME AS CALCBENF)
MOVE 1.3500 TO #TAB-REGION(1)
MOVE 1.3200 TO #TAB-REGION(2)
MOVE 1.3000 TO #TAB-REGION(3)
MOVE 1.2800 TO #TAB-REGION(4)
MOVE 1.3100 TO #TAB-REGION(5)
MOVE 1.4000 TO #TAB-REGION(6)
MOVE 1.3800 TO #TAB-REGION(7)
MOVE 1.3500 TO #TAB-REGION(8)
MOVE 1.3200 TO #TAB-REGION(9)
MOVE 1.3600 TO #TAB-REGION(10)
MOVE 1.1000 TO #TAB-REGION(11)
MOVE 1.1200 TO #TAB-REGION(12)
MOVE 1.0800 TO #TAB-REGION(13)
MOVE 1.0500 TO #TAB-REGION(14)
MOVE 1.0000 TO #TAB-REGION(15)
MOVE 1.0500 TO #TAB-REGION(16)
MOVE 1.0700 TO #TAB-REGION(17)
MOVE 1.0300 TO #TAB-REGION(18)
MOVE 1.1500 TO #TAB-REGION(19)
MOVE 1.2000 TO #TAB-REGION(20)
MOVE 1.1800 TO #TAB-REGION(21)
MOVE 1.2500 TO #TAB-REGION(22)
MOVE 1.1000 TO #TAB-REGION(23)
MOVE 1.2200 TO #TAB-REGION(24)
MOVE 1.3300 TO #TAB-REGION(25)
MOVE 1.0000 TO #TAB-REGION(26)
MOVE 1.0000 TO #TAB-REGION(27)
*
* INCOME BRACKETS
MOVE 300.00  TO #INCOME-BAND(1)
MOVE 1.0000  TO #BAND-FACTOR(1)
MOVE 600.00  TO #INCOME-BAND(2)
MOVE 0.8500  TO #BAND-FACTOR(2)
MOVE 1000.00 TO #INCOME-BAND(3)
MOVE 0.7000  TO #BAND-FACTOR(3)
MOVE 1500.00 TO #INCOME-BAND(4)
MOVE 0.5500  TO #BAND-FACTOR(4)
MOVE 9999.99 TO #INCOME-BAND(5)
MOVE 0.4000  TO #BAND-FACTOR(5)
*
WRITE '====================================='
WRITE 'BATCHPGT - MONTHLY PAYMENT GENERATION'
WRITE 'PERIOD:' #PERIOD
WRITE 'EXECUTION DATE:' #DT-TODAY
WRITE '====================================='
*
* GET LAST PAYMENT NUMBER - LIMIT (1) AVOIDS ESCAPE
READ (1) PAYMENT-V BY NUM-PAYMENT DESCENDING
  MOVE PAYMENT-V.NUM-PAYMENT TO #SEQ-PAYMENT
END-READ
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* MAIN PROCESSING
* READ IN CPF ALPHABETICAL ORDER (1999 OPTIMIZATION)
* NOTE: DOWNSTREAM SYSTEMS DEPEND ON THIS ORDERING
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
RESET #CPF-PREV
READ BENEFICIARY-V BY NUM-CPF
*
  ADD 1 TO #QTY-PROCESSED
  MOVE FALSE TO #ERR-CALC
*
* AVOID DUPLICATES
  IF BENEFICIARY-V.NUM-CPF = #CPF-PREV
    ADD 1 TO #QTY-IGNORED
    ESCAPE TOP
  END-IF
  MOVE BENEFICIARY-V.NUM-CPF TO #CPF-PREV
*
* CHECK ACTIVE STATUS
  IF BENEFICIARY-V.STAT-BENEFICIARY NE 'A'
    ADD 1 TO #QTY-IGNORED
    ESCAPE TOP
  END-IF
*
* ============================================
* CPF VALIDATION BY CORPORATE ROUTINE
* UNTIL 2011 THE PAYROLL DID NOT VALIDATE THE CPF READ FROM
* FILE 150 - TICKET 6620/2011
* ============================================
  MOVE 'C' TO #PV-TYPE-DOC
  MOVE BENEFICIARY-V.NUM-CPF TO #PV-CPF
  RESET #PV-NIS
  CALLNAT 'SUBVALCP' #PV-TYPE-DOC #PV-CPF #PV-NIS
                     #PV-COD-RETURN #PV-MSG
                     #PV-IND-SPECIAL
  IF #PV-COD-RETURN NE 0
    COMPRESS 'INVALID CPF:' BENEFICIARY-V.NUM-CPF
        #PV-MSG INTO #MSG-LOG
    WRITE #MSG-LOG (AL=78)
    MOVE #MSG-LOG TO #LOG-ERR
    WRITE WORK FILE 2 #LOG-ERR
    ADD 1 TO #QTY-ERRS
    ADD 1 TO #QTY-REJECT
    ESCAPE TOP
  END-IF
*
* CHECK WHETHER ALREADY GENERATED IN THIS PERIOD
* USES SUPERDESCRIPTOR S1 - CPF + YEAR-MONTH-REF
  COMPRESS BENEFICIARY-V.NUM-CPF #PERIOD-A
      INTO #KEY-CPF-PERIOD LEAVING NO SPACE
  FIND NUMBER PAYMENT-V WITH SUPER-CPF-PERIOD = #KEY-CPF-PERIOD
  IF *NUMBER > 0
    ADD 1 TO #QTY-IGNORED
    ESCAPE TOP
  END-IF
*
* FIND PROGRAM - FILE 151
  RESET #STAT-PROG #AMT-BASE #TYPE-PROG #FACTOR-ADJUST
  FIND PROGRAM-V WITH COD-PROGRAM = BENEFICIARY-V.COD-PROGRAM
    IF NO RECORDS FOUND
      COMPRESS 'ERROR: PROGRAM NOT FOUND CPF='
          BENEFICIARY-V.NUM-CPF 'PROG='
          BENEFICIARY-V.COD-PROGRAM INTO #MSG-LOG
      WRITE #MSG-LOG (AL=78)
      MOVE #MSG-LOG TO #LOG-ERR
      WRITE WORK FILE 2 #LOG-ERR
      ADD 1 TO #QTY-ERRS
      ADD 1 TO #QTY-REJECT
      MOVE 'X' TO #STAT-PROG
    END-NOREC
    MOVE PROGRAM-V.AMT-BASE-INDIVIDUAL TO #AMT-BASE
    MOVE PROGRAM-V.TYPE-PROGRAM       TO #TYPE-PROG
    MOVE PROGRAM-V.FACTOR-ADJUST      TO #FACTOR-ADJUST
    MOVE PROGRAM-V.STAT-PROGRAM        TO #STAT-PROG
  END-FIND
  IF #STAT-PROG = 'X'
    ESCAPE TOP
  END-IF
  IF #STAT-PROG NE 'A'
    ADD 1 TO #QTY-IGNORED
    ESCAPE TOP
  END-IF
*
* PREPARE DATA FOR CALCULATION
  MOVE BENEFICIARY-V.QTY-DEPEND    TO #NUM-DEPEND
  COMPUTE #COD-REGION = VAL(BENEFICIARY-V.COD-REGION)
  MOVE BENEFICIARY-V.AMT-FAMILY-INCOME TO #INCOME
  COMPUTE #YEAR-BIRTH = BENEFICIARY-V.DT-BIRTH / 10000
*
* --------------------------------------------------------
* CENTURY WINDOW - Y2K REMEDIATION 08/1998
* BUG2000 PROJECT - R.SOUZA TEAM - TICKET 1998/0442
* HISTORICAL LOADS BEFORE 07/1998 STORED YYMMDD.
* UNCONVERTED RECORDS STILL ARRIVE WITH YEAR < 100.
* --------------------------------------------------------
  IF #YEAR-BIRTH < 100
    MOVE #YEAR-BIRTH TO #L-AA-SHORT
    IF #L-AA-SHORT < #L-CENTURY-WINDOW
      COMPUTE #L-EXPANDED-YEAR = 2000 + #L-AA-SHORT
    ELSE
      COMPUTE #L-EXPANDED-YEAR = 1900 + #L-AA-SHORT
    END-IF
    MOVE #L-EXPANDED-YEAR TO #YEAR-BIRTH
  END-IF
  COMPUTE #AGE = #YEAR - #YEAR-BIRTH
*
* ============================================
* CORPORATE CALCULATION CHAIN - TICKET 6621/2011
* VALELEG AND CALCBENF ARE NOW CALLED FROM HERE.
* THE INLINE CALCULATION BELOW REMAINS ACTIVE PENDING A DECISION
* FROM BENEFITS COORDINATION - TICKET 6622/2011 OPEN.
* ============================================
  MOVE BENEFICIARY-V.NUM-CPF      TO #PC-CPF
  MOVE BENEFICIARY-V.COD-PROGRAM TO #PC-COD-PROGRAM
  MOVE BENEFICIARY-V.COD-REGION   TO #PC-COD-REGION
  MOVE #PERIOD                TO #PC-PERIOD
  MOVE #INCOME                      TO #PC-FAMILY-INCOME
  MOVE #NUM-DEPEND                    TO #PC-QTY-DEPEND
  MOVE #AGE                      TO #PC-AGE
  MOVE #AMT-BASE                   TO #PC-AMT-BASE
  MOVE BENEFICIARY-V.STAT-BENEFICIARY TO #PC-STAT-BENEF
  RESET #PC-AMT-GROSS #PC-AMT-DISC
        #PC-AMT-BONUS #PC-AMT-NET
        #PC-TYPE-PAYMENT #PC-COD-RETURN #PC-MSG
*
  CALLNAT 'VALELEG'  #PC-CPF #PC-COD-PROGRAM #PC-PERIOD
                     #PC-COD-REGION #PC-FAMILY-INCOME
                     #PC-QTY-DEPEND #PC-AGE #PC-STAT-BENEF
                     #PC-AMT-BASE #PC-AMT-GROSS
                     #PC-AMT-DISC #PC-AMT-BONUS
                     #PC-AMT-NET #PC-TYPE-PAYMENT
                     #PC-COD-RETURN #PC-MSG
  IF #PC-COD-RETURN NE 0
    ADD 1 TO #QTY-IGNORED
    ESCAPE TOP
  END-IF
*
  CALLNAT 'CALCBENF' #PC-CPF #PC-COD-PROGRAM #PC-PERIOD
                     #PC-COD-REGION #PC-FAMILY-INCOME
                     #PC-QTY-DEPEND #PC-AGE #PC-STAT-BENEF
                     #PC-AMT-BASE #PC-AMT-GROSS
                     #PC-AMT-DISC #PC-AMT-BONUS
                     #PC-AMT-NET #PC-TYPE-PAYMENT
                     #PC-COD-RETURN #PC-MSG
*
* CALCULATE REGIONAL FACTOR
  IF #COD-REGION >= 1 AND #COD-REGION <= 25
    MOVE #TAB-REGION(#COD-REGION) TO #FACTOR-REGION
  ELSE
    MOVE 1.0000 TO #FACTOR-REGION
  END-IF
*
* CALCULATE FAMILY FACTOR
  IF #NUM-DEPEND = 0
    MOVE 1.0000 TO #FACTOR-FAMILY
  ELSE
    IF #NUM-DEPEND <= 2
      COMPUTE #FACTOR-FAMILY = 1.0000 + (#NUM-DEPEND * 0.0500)
    ELSE
      IF #NUM-DEPEND <= 4
        COMPUTE #FACTOR-FAMILY = 1.1000 + ((#NUM-DEPEND - 2) * 0.0300)
      ELSE
        COMPUTE #FACTOR-FAMILY = 1.1600 + ((#NUM-DEPEND - 4) * 0.0200)
      END-IF
    END-IF
  END-IF
*
* CALCULATE INCOME FACTOR
  PERFORM DET-INCOME-BAND-BATCH
*
* CALCULATE AGE FACTOR
  IF #AGE >= 65
    MOVE 1.1500 TO #FACTOR-AGE
  ELSE
    IF #AGE >= 60
      MOVE 1.1000 TO #FACTOR-AGE
    ELSE
      IF #AGE < 18
        MOVE 1.0500 TO #FACTOR-AGE
      ELSE
        MOVE 1.0000 TO #FACTOR-AGE
      END-IF
    END-IF
  END-IF
*
* MAIN CALCULATION
  COMPUTE #AMT-BENF = #AMT-BASE * #FACTOR-REGION * #FACTOR-FAMILY
                       * #FACTOR-INCOME * #FACTOR-AGE
  COMPUTE #AMT-BENF = #AMT-BENF * (1 + #FACTOR-ADJUST)
* TRUNCATE
  COMPUTE #AMT-TEMP = #AMT-BENF * 100
  COMPUTE #AMT-BENF = #AMT-TEMP / 100
  MOVE #AMT-BENF TO #AMT-GROSS
  MOVE 0 TO #AMT-BONUS
  MOVE 0 TO #AMT-13
  MOVE 'N' TO #TYPE-PAYMENT
*
* 13TH PAYMENT AND BONUS - DECEMBER
  IF #MONTH = 12
    MOVE 'D' TO #TYPE-PAYMENT
    COMPUTE #AMT-13 = #AMT-BASE * #FACTOR-REGION * #FACTOR-AGE
    COMPUTE #AMT-TEMP = #AMT-13 * 100
    COMPUTE #AMT-13 = #AMT-TEMP / 100
    COMPUTE #AMT-GROSS = #AMT-BENF + #AMT-13
    IF #TYPE-PROG = 'A'
      COMPUTE #AMT-BONUS = #AMT-BENF * 0.15
      COMPUTE #AMT-TEMP = #AMT-BONUS * 100
      COMPUTE #AMT-BONUS = #AMT-TEMP / 100
      COMPUTE #AMT-GROSS = #AMT-GROSS + #AMT-BONUS
    END-IF
  END-IF
*
* CALCULATE SIMPLIFIED DEDUCTIONS
  MOVE 0 TO #AMT-DISC
  IF #AMT-GROSS > 500.00
    COMPUTE #AMT-DISC = #AMT-GROSS * 0.03
    COMPUTE #AMT-TEMP = #AMT-DISC * 100
    COMPUTE #AMT-DISC = #AMT-TEMP / 100
  END-IF
*
* CALCULATE NET AMOUNT
  COMPUTE #AMT-NET = #AMT-GROSS - #AMT-DISC
  IF #AMT-NET < 0
    MOVE 0 TO #AMT-NET
  END-IF
  COMPUTE #AMT-TEMP = #AMT-NET * 100
  COMPUTE #AMT-NET = #AMT-TEMP / 100
*
* STORE PAYMENT
  ADD 1 TO #SEQ-PAYMENT
  ADD 1 TO #SEQ-BATCH
  MOVE #SEQ-PAYMENT              TO PAYMENT-V.NUM-PAYMENT
  MOVE BENEFICIARY-V.NUM-CPF TO PAYMENT-V.NUM-CPF
  MOVE BENEFICIARY-V.COD-PROGRAM TO PAYMENT-V.COD-PROGRAM
  MOVE #PERIOD            TO PAYMENT-V.YEAR-MONTH-REF
  MOVE #AMT-GROSS              TO PAYMENT-V.AMT-GROSS
  MOVE #AMT-DISC               TO PAYMENT-V.AMT-DISC-TOTAL
  MOVE #AMT-NET                TO PAYMENT-V.AMT-NET
  MOVE #DT-TODAY                TO PAYMENT-V.DT-GENERATION
  MOVE 'G'                     TO PAYMENT-V.STAT-PAYMENT
  MOVE #TYPE-PAYMENT              TO PAYMENT-V.TYPE-PAYMENT
  MOVE #AMT-BONUS              TO PAYMENT-V.AMT-BONUS
  MOVE #NUM-BATCH               TO PAYMENT-V.NUM-BATCH
  MOVE #SEQ-BATCH               TO PAYMENT-V.SEQ-BATCH
  STORE PAYMENT-V
  END TRANSACTION
*
* EXTRACT FOR BANK TRANSMISSION - CMWKF01 LRECL 240
* DD ALLOCATED IN SIFAPJ01 - TICKET 7905/2016
  RESET #REC-EXTRACT
  MOVE EDITED #SEQ-PAYMENT (EM=999999999999999)
       TO #SEQ-PAYMENT-A
  COMPUTE #AMT-TEMP = #AMT-NET * 100
  MOVE EDITED #AMT-TEMP (EM=999999999)
       TO #AMT-NET-A
  COMPRESS '3' BENEFICIARY-V.NUM-CPF BENEFICIARY-V.COD-PROGRAM
           #PERIOD-A #SEQ-PAYMENT-A #AMT-NET-A
      INTO #REC-EXTRACT LEAVING NO SPACE
  WRITE WORK FILE 1 #REC-EXTRACT
*
  ADD 1 TO #QTY-GENERATED
  ADD #AMT-GROSS TO #AMT-TOT-GROSS
  ADD #AMT-DISC  TO #AMT-TOT-DISC
  ADD #AMT-NET   TO #AMT-TOT-NET
  ADD #AMT-BONUS TO #AMT-TOT-BONUS
*
* LOG EVERY 1000 RECORDS
  DIVIDE 1000 INTO #QTY-GENERATED GIVING #QTY-QUOT
                                REMAINDER #QTY-REMAIN
  IF #QTY-REMAIN = 0
    WRITE 'PROCESSED:' #QTY-GENERATED
          'LAST CPF:' BENEFICIARY-V.NUM-CPF
  END-IF
*
END-READ
*
* FINAL SUMMARY
WRITE '=====================================' /
      'BATCHPGT - PROCESSING SUMMARY' /
      '=====================================' /
      'PERIOD...........:' #PERIOD /
      'TOTAL PROCESSED..:' #QTY-PROCESSED /
      'PAYMENTS GENERATED:' #QTY-GENERATED /
      'IGNORED..........:' #QTY-IGNORED /
      'ERRORS...........:' #QTY-ERRS /
      'TOTAL GROSS AMT..:' #AMT-TOT-GROSS /
      'TOTAL DEDUCTIONS.:' #AMT-TOT-DISC /
      'TOTAL NET AMOUNT.:' #AMT-TOT-NET /
      'TOTAL BONUS......:' #AMT-TOT-BONUS /
      '====================================='
*
* --------------------------------------------------------
* CYCLE AUDIT TRAIL - FILE 153
* IN-TCU 63/2010 - TICKET 7741/2015
* --------------------------------------------------------
MOVE 'BT'      TO #AUD-ACTION
MOVE 'PGTO'    TO #AUD-ENTITY
MOVE #PERIOD-A TO #AUD-ID
RESET #AUD-CPF
COMPRESS 'PAYROLL GENERATED PERIOD' #PERIOD-A
    'QTY' #QTY-GENERATED INTO #AUD-DESCR
PERFORM WRITE-AUDIT
END TRANSACTION
*
CLOSE WORK FILE 1
CLOSE WORK FILE 2
*
* --------------------------------------------------------
* RETURN CODE FOR JCL SIFAPJ01
*   0 = PAYROLL GENERATED WITHOUT REJECTED RECORDS
*   4 = PAYROLL GENERATED WITH REJECTED RECORDS IN CMWKF02
*   8 = PERIOD ALREADY PROCESSED - NOTHING TO DO
* TICKET 4180/2004
* --------------------------------------------------------
IF #QTY-GENERATED = 0
  WRITE 'NO PAYMENT GENERATED FOR THE PERIOD'
  TERMINATE 8
END-IF
IF #QTY-REJECT > 0
  WRITE 'CMWKF02 HAS REJECTED RECORDS - CHECK'
  TERMINATE 4
END-IF
TERMINATE 0
*
* --------------------------------------------------------
* NATURAL ERROR HANDLING - TICKET 4181/2004
* RC=12 TRIGGERS NOTICE STEP030 IN SIFAPJ01
* --------------------------------------------------------
ON ERROR
  WRITE 'NATURAL ERROR NO.:' *ERROR-NR
  WRITE 'LINE.............:' *ERROR-LINE
  WRITE 'PROGRAM..........:' *PROGRAM
  WRITE 'LAST CPF READ....:' #CPF-PREV
  WRITE 'PERIOD...........:' #PERIOD
  BACKOUT TRANSACTION
  CLOSE WORK FILE 1
  CLOSE WORK FILE 2
  TERMINATE 12
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE DET-INCOME-BAND-BATCH
  FOR #J = 1 TO 5
    IF #INCOME <= #INCOME-BAND(#J)
      MOVE #BAND-FACTOR(#J) TO #FACTOR-INCOME
      ESCAPE BOTTOM
    END-IF
  END-FOR
END-SUBROUTINE
*
INCLUDE CCAUDIT
*
END
