* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* SUBPROGRAM: CALCBENF
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   CARLOS ROBERTO DA SILVA
* DATE:     18/04/1997
* CHANGED:  30/11/2001 - CARLOS SILVA   - ADD 13TH SALARY
* CHANGED:  15/06/2004 - PATRICIA GOMES - ADJUST REGIONAL FACTOR
* CHANGED:  22/12/2009 - JOSE FERREIRA  - HOLIDAY BONUS
* CHANGED:  09/05/2011 - SUPDE TEAM     - TICKET 6210 CONVERT SUBP
* CHANGED:  08/03/2013 - FERNANDA COSTA - NEW INCOME BRACKETS
* CHANGED:  14/06/2016 - SUPDE TEAM     - TICKET 7210 STANDARD DDM
* PURPOSE:  CALCULATE MONTHLY BENEFIT AMOUNT
*           MAIN CALCULATION PROCESS - FILES 150/160/155
* CALLED BY: BATCHPGT VIA CALLNAT - PDACALC INTERFACE
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
PARAMETER USING PDACALC
LOCAL USING LDASIFAP
LOCAL
  1 BENEFICIARY-V VIEW OF BENEFIC
    2 NUM-CPF            (A11)
    2 FULL-NAME          (A60)
    2 DT-BIRTH           (N8)
    2 STAT-BENEFICIARY   (A1)
    2 COD-PROGRAM        (A4)
    2 AMT-FAMILY-INCOME  (P9.2)
    2 QTY-DEPEND         (N2)
    2 COD-REGION         (A2)
    2 UF                 (A2)
    2 NUM-NIS            (N11)
*
  1 PAYMENT-V VIEW OF PAYMENT
    2 NUM-PAYMENT        (N15)
    2 NUM-CPF            (A11)
    2 COD-PROGRAM        (A4)
    2 YEAR-MONTH-REF     (N6)     /* YYYYMM */
    2 AMT-GROSS          (P9.2)
    2 AMT-DISC-TOTAL     (P7.2)
    2 AMT-NET            (P9.2)
    2 DT-GENERATION      (N8)
    2 STAT-PAYMENT       (A1)
    2 TYPE-PAYMENT       (A1)     /* N=NORMAL D=THIRTEENTH T=THIRD */
    2 AMT-BONUS          (P9.2)
*
  1 PROGRAM-V VIEW OF SOCPROG
    2 COD-PROGRAM         (A4)
    2 TYPE-PROGRAM        (A1)
    2 AMT-BASE-INDIVIDUAL (P7.2)
    2 FACTOR-ADJUST       (P3.4)
    2 STAT-PROGRAM        (A1)
*
* WORK VARIABLES
  1 #CPF                 (N11)
  1 #CPF-STR             (A11)
  1 #PERIOD              (N6)
  1 #MONTH               (N2)
  1 #YEAR                (N4)
  1 #YEAR-BIRTH          (N4)
  1 #AGE                 (N3)
  1 #AMT-BASE            (P9.2)
  1 #AMT-BENF            (P9.2)
  1 #AMT-GROSS           (P9.2)
  1 #AMT-DISC            (P9.2)
  1 #AMT-NET             (P9.2)
  1 #AMT-BONUS           (P9.2)
  1 #AMT-13              (P9.2)
  1 #AMT-TOTAL           (P9.2)
  1 #AMT-TEMP            (N11)
  1 #FACTOR-REGION       (N3.4)
  1 #FACTOR-FAMILY       (N3.4)
  1 #FACTOR-INCOME       (N3.4)
  1 #FACTOR-AGE          (N3.4)
  1 #NUM-DEP             (N2)
  1 #COD-REGION          (N2)
  1 #COD-PROG            (A4)
  1 #INCOME              (P9.2)
  1 #TYPE-PROG           (A1)
  1 #FACTOR-ADJUST       (N3.4)
  1 #MSG                 (A78)
  1 #ERR                 (L)
  1 #DT-TODAY            (N8)
  1 #DT-BIRTH            (N8)
  1 #STATUS-BENEF        (A1)
  1 #TYPE-PAYMENT        (A1)
  1 #J                   (N2)
*
* REGIONAL FACTOR TABLE
  1 #TAB-REGION          (N3.4/1:27)
*
* INCOME BRACKETS
  1 #INCOME-BAND         (P9.2/1:5)
  1 #BAND-FACTOR         (N3.4/1:5)
END-DEFINE
*
MOVE *DATN TO #DT-TODAY
*
* INITIALIZE REGIONAL FACTOR TABLE
* REGIONS: 01-05=NORTH 06-10=NORTHEAST 11-15=SOUTHEAST 16-20=SOUTH 21-25=C.WEST 99=SPECIAL
MOVE 1.3500 TO #TAB-REGION(1)   /* AC */
MOVE 1.3200 TO #TAB-REGION(2)   /* AM */
MOVE 1.3000 TO #TAB-REGION(3)   /* AP */
MOVE 1.2800 TO #TAB-REGION(4)   /* PA */
MOVE 1.3100 TO #TAB-REGION(5)   /* RO */
MOVE 1.4000 TO #TAB-REGION(6)   /* MA */
MOVE 1.3800 TO #TAB-REGION(7)   /* PI */
MOVE 1.3500 TO #TAB-REGION(8)   /* CE */
MOVE 1.3200 TO #TAB-REGION(9)   /* BA */
MOVE 1.3600 TO #TAB-REGION(10)  /* PE */
MOVE 1.1000 TO #TAB-REGION(11)  /* SP */
MOVE 1.1200 TO #TAB-REGION(12)  /* RJ */
MOVE 1.0800 TO #TAB-REGION(13)  /* MG */
MOVE 1.0500 TO #TAB-REGION(14)  /* ES */
MOVE 1.0000 TO #TAB-REGION(15)  /* REF */
MOVE 1.0500 TO #TAB-REGION(16)  /* PR */
MOVE 1.0700 TO #TAB-REGION(17)  /* SC */
MOVE 1.0300 TO #TAB-REGION(18)  /* RS */
MOVE 1.1500 TO #TAB-REGION(19)  /* MS */
MOVE 1.2000 TO #TAB-REGION(20)  /* MT */
MOVE 1.1800 TO #TAB-REGION(21)  /* GO */
MOVE 1.2500 TO #TAB-REGION(22)  /* TO */
MOVE 1.1000 TO #TAB-REGION(23)  /* DF */
MOVE 1.2200 TO #TAB-REGION(24)  /* RR */
MOVE 1.3300 TO #TAB-REGION(25)  /* SE */
MOVE 1.0000 TO #TAB-REGION(26)  /* RESERVED */
MOVE 1.0000 TO #TAB-REGION(27)  /* RESERVED */
*
* INCOME BRACKETS - CEILING AND MULTIPLIER
MOVE 300.00  TO #INCOME-BAND(1)
MOVE 1.0000  TO #BAND-FACTOR(1)
MOVE 600.00  TO #INCOME-BAND(2)
MOVE 0.8500  TO #BAND-FACTOR(2)
MOVE 1000.00 TO #INCOME-BAND(3)
MOVE 0.7000  TO #BAND-FACTOR(3)
MOVE 1500.00 TO #INCOME-BAND(4)
MOVE 0.5500  TO #BAND-FACTOR(4)
MOVE 9999.99 TO #INCOME-BAND(5)
MOVE 0.4000  TO #BAND-FACTOR(5)
*
* PARAMETER INPUT - VIA PDACALC
* TICKET 6210/2011 - CONVERTED FROM ONLINE PROGRAM TO
* SUBPROGRAM. THE CALL NOW COMES FROM BATCHPGT VIA CALLNAT.
* INPUT BLOCK BELOW DISABLED - DO NOT REMOVE (HISTORICAL)
*  INPUT 'SIFAP - BENEFIT CALCULATION' /
*        '=========================' /
*        'BENEFICIARY CPF.:' #CPF /
*        'PERIOD..........:' #PERIOD '(YYYYMM)'
*
COMPUTE #CPF = VAL(#PC-CPF)
MOVE #PC-PERIOD TO #PERIOD
RESET #PC-COD-RETURN #PC-MSG
RESET #PC-AMT-GROSS #PC-AMT-DISC
RESET #PC-AMT-BONUS #PC-AMT-NET
*
* EXTRACT MONTH/YEAR FROM PERIOD
COMPUTE #YEAR = #PERIOD / 100
COMPUTE #MONTH = #PERIOD - (#YEAR * 100)
*
IF #MONTH < 1 OR #MONTH > 12
  MOVE 2020 TO #PC-COD-RETURN
  MOVE 'INVALID PERIOD' TO #PC-MSG
  ESCAPE ROUTINE
END-IF
*
* READ BENEFICIARY - FILE 150
MOVE EDITED #CPF (EM=99999999999) TO #CPF-STR
FIND BENEFICIARY-V WITH NUM-CPF = #CPF-STR
  IF NO RECORDS FOUND
    MOVE 2001 TO #PC-COD-RETURN
    MOVE 'BENEFICIARY NOT FOUND' TO #PC-MSG
    ESCAPE ROUTINE
  END-NOREC
  MOVE BENEFICIARY-V.QTY-DEPEND    TO #NUM-DEP
  COMPUTE #COD-REGION = VAL(BENEFICIARY-V.COD-REGION)
  MOVE BENEFICIARY-V.AMT-FAMILY-INCOME TO #INCOME
  MOVE BENEFICIARY-V.DT-BIRTH      TO #DT-BIRTH
  MOVE BENEFICIARY-V.STAT-BENEFICIARY   TO #STATUS-BENEF
  MOVE BENEFICIARY-V.COD-PROGRAM       TO #COD-PROG
END-FIND
*
IF #STATUS-BENEF NE 'A'
  MOVE 2002 TO #PC-COD-RETURN
  COMPRESS 'BENEFICIARY NOT ACTIVE - STATUS:' #STATUS-BENEF
           INTO #PC-MSG
  ESCAPE ROUTINE
END-IF
*
* READ PROGRAM - FILE 155
FIND PROGRAM-V WITH COD-PROGRAM = #COD-PROG
  IF NO RECORDS FOUND
    MOVE 2003 TO #PC-COD-RETURN
    MOVE 'PROGRAM NOT FOUND' TO #PC-MSG
    ESCAPE ROUTINE
  END-NOREC
  MOVE PROGRAM-V.AMT-BASE-INDIVIDUAL TO #AMT-BASE
  MOVE PROGRAM-V.TYPE-PROGRAM       TO #TYPE-PROG
  MOVE PROGRAM-V.FACTOR-ADJUST      TO #FACTOR-ADJUST
END-FIND
*
* CALCULATE REGIONAL FACTOR
IF #COD-REGION >= 1 AND #COD-REGION <= 25
  MOVE #TAB-REGION(#COD-REGION) TO #FACTOR-REGION
ELSE
  MOVE 1.0000 TO #FACTOR-REGION
END-IF
*
* CALCULATE FAMILY FACTOR - ADDITION PER DEPENDENT
IF #NUM-DEP = 0
  MOVE 1.0000 TO #FACTOR-FAMILY
ELSE
  IF #NUM-DEP <= 2
    COMPUTE #FACTOR-FAMILY = 1.0000 + (#NUM-DEP * 0.0500)
  ELSE
    IF #NUM-DEP <= 4
      COMPUTE #FACTOR-FAMILY = 1.1000 + ((#NUM-DEP - 2) * 0.0300)
    ELSE
      COMPUTE #FACTOR-FAMILY = 1.1600 + ((#NUM-DEP - 4) * 0.0200)
    END-IF
  END-IF
END-IF
*
* CALCULATE INCOME FACTOR - DETERMINE BRACKET
PERFORM DET-BAND-INCOME
*
* CALCULATE AGE FACTOR
* --------------------------------------------------------
* Y2K - REMEDIATION 08/1998 - BUG2000 PROJECT
* TEAM: R.SOUZA / C.SILVA - TICKET 1998/0147
* UNTIL 07/1998, BIRTH DATE WAS READ AS YYMMDD AND THE
* CENTURY WAS DEDUCED USING THE WINDOW BELOW (PIVOT 50).
* THE FIELD CHANGED TO YYYYMMDD IN THE 08/1998 LOAD.
*    COMPUTE #AA = #DT-BIRTH / 10000
*    IF #AA < 50
*      COMPUTE #YEAR-BIRTH = 2000 + #AA
*    ELSE
*      COMPUTE #YEAR-BIRTH = 1900 + #AA
*    END-IF
* --------------------------------------------------------
COMPUTE #YEAR-BIRTH = #DT-BIRTH / 10000
COMPUTE #AGE = #YEAR - #YEAR-BIRTH
IF #AGE >= 65
  MOVE 1.1500 TO #FACTOR-AGE
ELSE
  IF #AGE >= 60
    MOVE 1.1000 TO #FACTOR-AGE
  ELSE
    IF #AGE < 18
      MOVE 1.0500 TO #FACTOR-AGE
    ELSE
      MOVE 1.0000 TO #FACTOR-AGE
    END-IF
  END-IF
END-IF
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* MAIN CALCULATION - MONTHLY BENEFIT AMOUNT
* AMT = BASE * FACTOR_REGION * FACTOR_FAMILY * FACTOR_INCOME * FACTOR_AGE
* * * * * * * * * * * * * * * * * * * * * * * * * * * * *
COMPUTE #AMT-BENF = #AMT-BASE * #FACTOR-REGION * #FACTOR-FAMILY
                     * #FACTOR-INCOME * #FACTOR-AGE
*
* APPLY PROGRAM ADJUSTMENT
COMPUTE #AMT-BENF = #AMT-BENF * (1 + #FACTOR-ADJUST)
*
* TRUNCATE TO 2 DECIMAL PLACES - MAINFRAME STANDARD
COMPUTE #AMT-TEMP = #AMT-BENF * 100
COMPUTE #AMT-BENF = #AMT-TEMP / 100
*
MOVE #AMT-BENF TO #AMT-GROSS
MOVE 'N' TO #TYPE-PAYMENT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* CALCULATE 13TH SALARY - DECEMBER
* DIFFERENT FORMULA: AMT_13 = AMT_BASE * FACTOR_REGION * (ACTIVE_MONTHS/12)
* * * * * * * * * * * * * * * * * * * * * * * * * * * * *
IF #MONTH = 12
  MOVE 'D' TO #TYPE-PAYMENT
  COMPUTE #AMT-13 = #AMT-BASE * #FACTOR-REGION * #FACTOR-AGE
* TRUNCATE 13TH SALARY
  COMPUTE #AMT-TEMP = #AMT-13 * 100
  COMPUTE #AMT-13 = #AMT-TEMP / 100
  COMPUTE #AMT-GROSS = #AMT-BENF + #AMT-13
*
* HOLIDAY BONUS - 15% ADDITION FOR TYPE 'A' PROGRAMS
  IF #TYPE-PROG = 'A'
    COMPUTE #AMT-BONUS = #AMT-BENF * 0.15
* TRUNCATE BONUS
    COMPUTE #AMT-TEMP = #AMT-BONUS * 100
    COMPUTE #AMT-BONUS = #AMT-TEMP / 100
    COMPUTE #AMT-GROSS = #AMT-GROSS + #AMT-BONUS
  ELSE
    MOVE 0 TO #AMT-BONUS
  END-IF
END-IF
*
* CALL DEDUCTION CALCULATION
PERFORM CALC-DISC
*
* CALCULATE NET AMOUNT
COMPUTE #AMT-NET = #AMT-GROSS - #AMT-DISC
IF #AMT-NET < 0
  MOVE 0 TO #AMT-NET
END-IF
*
* TRUNCATE NET AMOUNT
COMPUTE #AMT-TEMP = #AMT-NET * 100
COMPUTE #AMT-NET = #AMT-TEMP / 100
*
* WRITE PAYMENT - FILE 160
MOVE #CPF-STR      TO PAYMENT-V.NUM-CPF
MOVE #COD-PROG     TO PAYMENT-V.COD-PROGRAM
MOVE #PERIOD  TO PAYMENT-V.YEAR-MONTH-REF
MOVE #AMT-GROSS    TO PAYMENT-V.AMT-GROSS
MOVE #AMT-DISC     TO PAYMENT-V.AMT-DISC-TOTAL
MOVE #AMT-NET      TO PAYMENT-V.AMT-NET
MOVE #DT-TODAY      TO PAYMENT-V.DT-GENERATION
MOVE 'G'           TO PAYMENT-V.STAT-PAYMENT
MOVE #TYPE-PAYMENT    TO PAYMENT-V.TYPE-PAYMENT
MOVE #AMT-BONUS    TO PAYMENT-V.AMT-BONUS
STORE PAYMENT-V
END TRANSACTION
*
* RETURN AMOUNTS VIA PDACALC - TICKET 6210/2011
MOVE #AMT-GROSS TO #PC-AMT-GROSS
MOVE #AMT-DISC  TO #PC-AMT-DISC
MOVE #AMT-BONUS TO #PC-AMT-BONUS
MOVE #AMT-NET   TO #PC-AMT-NET
MOVE #TYPE-PAYMENT TO #PC-TYPE-PAYMENT
MOVE 0          TO #PC-COD-RETURN
*
* SCREEN OUTPUT DISABLED DURING SUBPROGRAM CONVERSION
*  WRITE 'CALCULATION COMPLETED SUCCESSFULLY' /
*        '==============================' /
*        'CPF............:' #CPF /
*        'PERIOD.........:' #PERIOD /
*        'GROSS AMOUNT...:' #AMT-GROSS /
*        'DEDUCTION......:' #AMT-DISC /
*        'NET AMOUNT.....:' #AMT-NET /
*        'PAYMENT TYPE...:' #TYPE-PAYMENT
*  IF #MONTH = 12
*    WRITE '13TH SALARY AMT:' #AMT-13 /
*          'BONUS AMOUNT...:' #AMT-BONUS
*  END-IF
*
ESCAPE ROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE DET-BAND-INCOME
  FOR #J = 1 TO 5
    IF #INCOME <= #INCOME-BAND(#J)
      MOVE #BAND-FACTOR(#J) TO #FACTOR-INCOME
      ESCAPE BOTTOM
    END-IF
  END-FOR
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* CALCULATE DEDUCTIONS - SIMPLIFIED (SEE CALCDSCT FOR FULL VERSION)
DEFINE SUBROUTINE CALC-DISC
  MOVE 0 TO #AMT-DISC
* BASIC DEDUCTION - 3% SOCIAL CONTRIBUTION
  IF #AMT-GROSS > 500.00
    COMPUTE #AMT-DISC = #AMT-GROSS * 0.03
    COMPUTE #AMT-TEMP = #AMT-DISC * 100
    COMPUTE #AMT-DISC = #AMT-TEMP / 100
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* NATURAL ERROR HANDLING - TICKET 7210
ON ERROR
  WRITE 'NATURAL ERROR' *ERROR-NR
        'LINE'          *ERROR-LINE
        'PGM'          *PROGRAM
  BACKOUT TRANSACTION
  TERMINATE 12
END-ERROR
*
END
