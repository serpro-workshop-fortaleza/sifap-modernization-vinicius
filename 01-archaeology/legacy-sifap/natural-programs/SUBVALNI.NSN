* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* SUBPROGRAM: SUBVALNI
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   ROBERTO MENDES JUNIOR
* DATE:     07/06/2011
* CHANGED:  30/09/2015 - ANDERSON LIMA - ADJUST RETURN MESSAGE
* PURPOSE:  NIS/PIS/PASEP VALIDATION SUBPROGRAM.
*           MODULUS 11 WITH WEIGHTS 3,2,9,8,7,6,5,4,3,2.
*           DOES NOT INPUT OR WRITE - RETURNS EVERYTHING VIA PDA.
*
* ORIGIN:   UNTIL 2011, SIFAP DID NOT VALIDATE NIS IN ANY
*           MODULE - IT ONLY CHECKED AGAINST ZERO.
*           TICKET 6621/2011 - DEFIS.
*
* INVOCATION:
*   CALLNAT 'SUBVALNI' #PV-TYPE-DOC #PV-CPF #PV-NIS
*                      #PV-COD-RETURN #PV-MSG
*                      #PV-IND-SPECIAL
*
* PRECONDITION:
*   #PV-TYPE-DOC = 'N'
*   #PV-NIS      = NIS WITH 11 POSITIONS, LEFT-PADDED WITH ZEROS
*
* POSTCONDITION:
*   #PV-COD-RETURN = 0 WHEN THE NIS IS VALID
*
* ALGORITHM:
*   SUM = SUM(DIGIT(I) * WEIGHT(I)) FOR I = 1 TO 10
*   REMAINDER = SUM MOD 11
*   IF REMAINDER < 2 THEN DV = 0
*                    ELSE DV = 11 - REMAINDER
*   NIS IS VALID WHEN DV = DIGIT(11)
*
* NOTE:     PARAMETER #PV-CPF IS NOT USED HERE. THE PDA IS
*           SHARED WITH SUBVALCP PER INTERNAL STANDARD
*           (NT-SUPDE-011/1998). DO NOT REMOVE IT FROM THE LIST.
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
PARAMETER USING PDAVALID
LOCAL
  1 #NIS-STR             (A11)
  1 #NIS-DIG             (N1/1:11)
  1 #NIS-WEIGHT          (N1/1:10)
    INIT <3,2,9,8,7,6,5,4,3,2>
  1 #NIS-SUM             (N5)
  1 #NIS-QUOT            (N5)
  1 #NIS-REMAIN          (N2)
  1 #NIS-DV              (N1)
  1 #NIS-IDX             (N2)
END-DEFINE
*
RESET #PV-COD-RETURN #PV-MSG
MOVE 'N' TO #PV-IND-SPECIAL
*
* ============================================
* INPUT PARAMETER CONSISTENCY
* ============================================
IF #PV-TYPE-DOC NE 'N'
  MOVE 1004 TO #PV-COD-RETURN
  MOVE 'INVALID DOCUMENT TYPE FOR SUBVALNI' TO #PV-MSG
  ESCAPE ROUTINE
END-IF
*
IF #PV-NIS = ' ' OR #PV-NIS = '00000000000'
  MOVE 1010 TO #PV-COD-RETURN
  MOVE 'NIS NOT PROVIDED' TO #PV-MSG
  ESCAPE ROUTINE
END-IF
*
IF #PV-NIS NE MASK(NNNNNNNNNNN)
  MOVE 1012 TO #PV-COD-RETURN
  MOVE 'NIS CONTAINS NONNUMERIC CHARACTER' TO #PV-MSG
  ESCAPE ROUTINE
END-IF
*
* ============================================
* MODULUS 11 VALIDATION - WEIGHTS 3 2 9 8 7 6 5 4 3 2
* ============================================
MOVE #PV-NIS TO #NIS-STR
PERFORM VALID-NIS-MOD11
*
IF #NIS-DV NE #NIS-DIG(11)
  MOVE 1011 TO #PV-COD-RETURN
  MOVE 'INVALID NIS - CHECK DIGIT' TO #PV-MSG
  ESCAPE ROUTINE
END-IF
*
* VALID NIS
MOVE 0 TO #PV-COD-RETURN
RESET #PV-MSG
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  MOVE 9999 TO #PV-COD-RETURN
  COMPRESS 'NATURAL ERROR' *ERROR-NR
           'LINE' *ERROR-LINE
           'PGM' *PROGRAM INTO #PV-MSG
  ESCAPE ROUTINE
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALID-NIS-MOD11
*
  RESET #NIS-SUM #NIS-QUOT #NIS-REMAIN #NIS-DV
*
* EXTRACT THE 11 DIGITS
  FOR #NIS-IDX = 1 TO 11
    DECIDE ON FIRST VALUE OF SUBSTR(#NIS-STR,#NIS-IDX,1)
      VALUE '0'
        MOVE 0 TO #NIS-DIG(#NIS-IDX)
      VALUE '1'
        MOVE 1 TO #NIS-DIG(#NIS-IDX)
      VALUE '2'
        MOVE 2 TO #NIS-DIG(#NIS-IDX)
      VALUE '3'
        MOVE 3 TO #NIS-DIG(#NIS-IDX)
      VALUE '4'
        MOVE 4 TO #NIS-DIG(#NIS-IDX)
      VALUE '5'
        MOVE 5 TO #NIS-DIG(#NIS-IDX)
      VALUE '6'
        MOVE 6 TO #NIS-DIG(#NIS-IDX)
      VALUE '7'
        MOVE 7 TO #NIS-DIG(#NIS-IDX)
      VALUE '8'
        MOVE 8 TO #NIS-DIG(#NIS-IDX)
      VALUE '9'
        MOVE 9 TO #NIS-DIG(#NIS-IDX)
      NONE VALUE
        MOVE 0 TO #NIS-DIG(#NIS-IDX)
    END-DECIDE
  END-FOR
*
* WEIGHTED SUM OF THE FIRST 10 DIGITS
  FOR #NIS-IDX = 1 TO 10
    COMPUTE #NIS-SUM = #NIS-SUM
                      + (#NIS-DIG(#NIS-IDX)
                      *  #NIS-WEIGHT(#NIS-IDX))
  END-FOR
*
* CHECK DIGIT
  DIVIDE 11 INTO #NIS-SUM GIVING #NIS-QUOT
                           REMAINDER #NIS-REMAIN
  IF #NIS-REMAIN < 2
    MOVE 0 TO #NIS-DV
  ELSE
    COMPUTE #NIS-DV = 11 - #NIS-REMAIN
  END-IF
*
END-SUBROUTINE
*
END
