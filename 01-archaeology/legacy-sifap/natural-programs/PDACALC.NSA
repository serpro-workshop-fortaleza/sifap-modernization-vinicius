* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PDA:      PDACALC
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   CARLOS ROBERTO DA SILVA
* DATE:     22/06/1997
* CHANGED:  30/11/2001 - CARLOS SILVA   - ADD 13TH SALARY
* CHANGED:  28/07/2004 - PATRICIA GOMES - ADD ELIGIBILITY FIELDS
* CHANGED:  22/12/2009 - JOSE FERREIRA  - ADD BONUS VALUE
* CHANGED:  30/09/2015 - ANDERSON LIMA  - ADD PAYMENT TYPE
* PURPOSE:  PARAMETER AREA FOR THE SIFAP PAYMENT CHAIN.
*           CARRIES BENEFICIARY/PERIOD CONTEXT
*           FROM THE START TO THE END OF THE CHAIN:
*             VALELEG  - ELIGIBILITY
*             CALCBENF - GROSS AMOUNT
*             CALCDSCT - DEDUCTIONS
*             CALCCORR - MONETARY ADJUSTMENT
*
* USE IN CALLER:
*           DEFINE DATA
*             LOCAL USING PDACALC
*             LOCAL
*               1 ... PROGRAM-SPECIFIC FIELDS ...
*           END-DEFINE
*
* USE IN CALLEE:
*           DEFINE DATA
*             PARAMETER USING PDACALC
*             LOCAL
*               1 ... WORK FIELDS ...
*           END-DEFINE
*
* NOTE:     KEY FIELDS FOLLOW THE DDM FORMAT
*           (CPF A11, COD-PROGRAM A4, COD-REGION A2), NOT
*           THE NUMERIC FORMAT USED IN PROGRAM VIEWS.
*           CONVERSION IS THE CALLER'S RESPONSIBILITY VIA
*           MOVE EDITED. SEE TICKET 4471/2004.
*
* RETURN CODES (#PC-COD-RETURN):
*           0000 - OK / ELIGIBLE
*           2001 - BENEFICIARY NOT FOUND
*           2002 - BENEFICIARY NOT ACTIVE
*           2003 - PROGRAM NOT FOUND
*           2004 - PROGRAM INACTIVE
*           2010 - NOT ELIGIBLE - SEE #PC-MSG
*           2020 - INVALID PERIOD
*           2030 - PAYMENT ALREADY GENERATED FOR PERIOD
*           9999 - NATURAL ERROR - SEE CMPRINT
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA PARAMETER
*
* --- INPUT - KEY ---
*
1 #PC-CPF                 (A11)   /* IN  UNMASKED CPF (DDM AB)
1 #PC-COD-PROGRAM         (A4)    /* IN  SOCIAL PROGRAM CODE (DDM AA)
1 #PC-PERIOD              (N6)    /* IN  YYYYMM
*
* --- INPUT - BENEFICIARY CONTEXT ---
*
1 #PC-COD-REGION          (A2)    /* IN  01-27 OR 99 (DDM BJ)
1 #PC-FAMILY-INCOME       (P9.2)  /* IN  DECLARED INCOME
1 #PC-QTY-DEPEND          (N2)    /* IN  NUMBER OF ACTIVE DEPENDENTS
1 #PC-AGE                 (N3)    /* IN  AGE IN COMPLETED YEARS
1 #PC-STAT-BENEF          (A1)    /* IN  A/S/C/I/D
1 #PC-AMT-BASE            (P9.2)  /* IN  PROGRAM BASE AMOUNT
*
* --- OUTPUT - AMOUNTS ---
*
1 #PC-AMT-GROSS           (P9.2)  /* OUT CALCULATED GROSS AMOUNT
1 #PC-AMT-DISC            (P9.2)  /* OUT TOTAL DEDUCTIONS
1 #PC-AMT-BONUS           (P9.2)  /* OUT HOLIDAY BONUS
1 #PC-AMT-NET             (P9.2)  /* OUT GROSS - DEDUCTION + BONUS
*
* --- OUTPUT - CONTROL ---
*
1 #PC-TYPE-PAYMENT        (A1)    /* OUT N=NORMAL D=THIRTEENTH T=THIRD
1 #PC-COD-RETURN          (N4)    /* OUT 0000 = OK
1 #PC-MSG                 (A60)   /* OUT BLANK WHEN OK
*
END-DEFINE
