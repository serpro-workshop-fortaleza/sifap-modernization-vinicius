* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM:  CADDEPEN 
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   ANA LUCIA PEREIRA
* DATE:     20/06/1998
* CHANGED:  14/03/2008 - ROBERTO MENDES - ADJUSTED PE GROUP
* CHANGED:  07/06/2011 - ROBERTO MENDES - ADDED DEPENDENT CPF VALIDATION
* CHANGED:  12/09/2012 - ANDERSON LIMA  - ADDED AUDIT TRAIL
* PURPOSE:  BENEFICIARY DEPENDENT REGISTRATION
*           LINK TO PRIMARY BENEFICIARY - FILE 150
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 BENEFICIARY-V VIEW OF BENEFIC
    2 NUM-CPF                (A11)
    2 FULL-NAME              (A60)
    2 STAT-BENEFICIARY       (A1)
    2 QTY-DEPEND             (N2)
    2 GRP-DEPEND             (1:10)
      3 NAME-DEPEND            (A60)
      3 DT-BIRTH-DEPEND        (N8)
      3 RELATION               (A2)  /* FI=CHILD CO=SPOUSE IR=SIBLING
      3 CPF-DEPEND             (A11)
      3 STAT-DEPEND            (A1)
      3 IND-DISABILITY         (A1)
*
* AUDIT TRAIL - FILE 153 - IN-TCU 63/2010
  1 AUDIT-V VIEW OF AUDIT
    2 NUM-AUDIT              (N15)
    2 DT-EVENT               (N8)
    2 HR-EVENT               (N6)
    2 TS-EVENT               (N14)
    2 COD-ACTION             (A2)
    2 COD-MODULE             (A8)
    2 DESCR-ACTION           (A80)
    2 TYPE-ENTITY            (A4)
    2 ID-ENTITY              (A15)
    2 NUM-CPF-AFFECTED       (A11)
    2 USR-EVENT              (A8)
    2 NAME-JOB-BATCH         (A16)
    2 STAT-BATCH             (A1)
*
  1 #CPF-HOLDER            (N11)
  1 #CPF-HOLDER-STR        (A11)
  1 #NAME-DEPEND           (A60)
  1 #DT-BIRTH-DEPEND       (N8)
  1 #RELATION              (A2)
  1 #CPF-DEPEND            (N11)
  1 #CPF-DEPEND-STR        (A11)
  1 #DOC-DEPEND            (A15)
  1 #SEX-DEPEND            (A1)
  1 #NUM-DEPEND            (N2)
  1 #STAT-BENEF            (A1)
  1 #MSG                   (A60)
  1 #FOUND                 (L)
  1 #ERR                   (L)
  1 #IDX                   (N2)
  1 #COUNT                 (A1)
*
* FIELDS REQUIRED BY COPYCODE CCVALCPF
  1 #CPF-STR               (A11)
  1 #CPF-OK                (L)
  1 #CPF-DIG               (N1/1:11)
  1 #CPF-SUM               (N5)
  1 #CPF-QUOT              (N5)
  1 #CPF-REMAIN            (N2)
  1 #CPF-DV1               (N1)
  1 #CPF-DV2               (N1)
  1 #CPF-WEIGHT            (N2)
  1 #CPF-IDX               (N2)
  1 #CPF-EQUAL             (L)
*
* AUDIT TRAIL FIELDS - CCAUDIT
  1 #AUD-ACTION            (A2)
  1 #AUD-ENTITY            (A4)
  1 #AUD-ID                (A15)
  1 #AUD-CPF               (A11)
  1 #AUD-DESCR             (A80)
  1 #AUD-SEQ               (N15)
  1 #AUD-TIMN              (N7)
END-DEFINE
*
* FLOW CONTROL - TICKET 6622/2011
* OUTER REPEAT ENABLES EARLY EXIT
* (ESCAPE BOTTOM) WITHOUT REWRITING THE RULES
REPEAT
*
INPUT 'SIFAP - DEPENDENT REGISTRATION' /
      '===============================' /
      'PRIMARY CPF...:' #CPF-HOLDER
*
* READ FILE 150 - FIND BENEFICIARY
* CPF IS ALPHANUMERIC IN FILE 150 (AB NUM-CPF A11)
MOVE EDITED #CPF-HOLDER (EM=99999999999) TO #CPF-HOLDER-STR
FIND BENEFICIARY-V WITH NUM-CPF = #CPF-HOLDER-STR
  IF NO RECORDS FOUND
    MOVE FALSE TO #FOUND
  END-NOREC
  MOVE TRUE TO #FOUND
  MOVE BENEFICIARY-V.QTY-DEPEND  TO #NUM-DEPEND
  MOVE BENEFICIARY-V.STAT-BENEFICIARY TO #STAT-BENEF
END-FIND
*
IF NOT #FOUND
  WRITE 'BENEFICIARY NOT FOUND'
  ESCAPE BOTTOM
END-IF
*
IF #STAT-BENEF = 'C' OR #STAT-BENEF = 'D'
  WRITE 'CANCELED/TERMINATED BENEFICIARY - ADDITION NOT ALLOWED'
  ESCAPE BOTTOM
END-IF
*
* DEPENDENT ADDITION LOOP
REPEAT
  IF #NUM-DEPEND > 5
    WRITE 'DEPENDENT LIMIT REACHED'
    ESCAPE BOTTOM
  END-IF
*
  INPUT 'DEPENDENT INFORMATION' /
        '=====================' /
        'NAME..........:' #NAME-DEPEND /
        'BIRTH DATE....:' #DT-BIRTH-DEPEND /
        'RELATIONSHIP..:' #RELATION '(FI/CO/IR/OU)' /
        'DEPENDENT CPF.:' #CPF-DEPEND /
        'DOCUMENT......:' #DOC-DEPEND /
        'SEX...........:' #SEX-DEPEND
*
* ============================================
* Y2K - REMEDIATION 08/1998 - BUG2000 PROJECT
* TEAM: R.SOUZA - TICKET 1998/0442
* DT-BIRTH-DEPEND ARRIVED AS YYMMDD UNTIL 07/1998.
* EXPANSION USED THE CENTURY WINDOW (PIVOT 50)
* NOW IN #L-CENTURY-WINDOW IN LDASIFAP:
*    IF #L-AA-SHORT < #L-CENTURY-WINDOW
*      COMPUTE #L-EXPANDED-YEAR = 2000 + #L-AA-SHORT
*    ELSE
*      COMPUTE #L-EXPANDED-YEAR = 1900 + #L-AA-SHORT
*    END-IF
* SCREEN CONVERTED TO YYYYMMDD IN 08/1998
* ============================================
*
  MOVE FALSE TO #ERR
*
  IF #NAME-DEPEND = ' '
    WRITE 'DEPENDENT NAME IS REQUIRED'
    MOVE TRUE TO #ERR
  END-IF
*
  IF #RELATION NE 'FI' AND #RELATION NE 'CO'
      AND #RELATION NE 'IR' AND #RELATION NE 'OU'
    WRITE 'INVALID RELATIONSHIP'
    MOVE TRUE TO #ERR
  END-IF
*
  IF #ERR
    ESCAPE TOP
  END-IF
*
* ============================================
* DEPENDENT CPF VALIDATION - TICKET 6620/2011
* WARNING MODE - DOES NOT BLOCK ADDITION PENDING
* BENEFITS DEPARTMENT REVIEW
* ============================================
  MOVE EDITED #CPF-DEPEND (EM=99999999999) TO #CPF-STR
  PERFORM VALID-CPF-STANDARD
  IF NOT #CPF-OK
    MOVE 'INVALID DEPENDENT CPF' TO #MSG
  END-IF
*
* CHECK FOR DUPLICATE DEPENDENT
  MOVE EDITED #CPF-DEPEND (EM=99999999999) TO #CPF-DEPEND-STR
  FIND BENEFICIARY-V WITH NUM-CPF = #CPF-HOLDER-STR
    FOR #IDX = 1 TO BENEFICIARY-V.QTY-DEPEND
      IF BENEFICIARY-V.CPF-DEPEND(#IDX) = #CPF-DEPEND-STR
          AND #CPF-DEPEND NE 0
        WRITE 'DEPENDENT ALREADY REGISTERED (DUPLICATE CPF)'
        MOVE TRUE TO #ERR
        ESCAPE BOTTOM
      END-IF
    END-FOR
  END-FIND
*
  IF #ERR
    ESCAPE TOP
  END-IF
*
* ADD TO PE GROUP
  FIND BENEFICIARY-V WITH NUM-CPF = #CPF-HOLDER-STR
    ADD 1 TO #NUM-DEPEND
    MOVE #NUM-DEPEND TO #IDX
    MOVE #NAME-DEPEND    TO BENEFICIARY-V.NAME-DEPEND(#IDX)
    MOVE #DT-BIRTH-DEPEND TO BENEFICIARY-V.DT-BIRTH-DEPEND(#IDX)
    MOVE #RELATION   TO BENEFICIARY-V.RELATION(#IDX)
    MOVE #CPF-DEPEND-STR  TO BENEFICIARY-V.CPF-DEPEND(#IDX)
* TICKET 4471/2003 - DOC-DEPEND AND SEX-DEPEND DO NOT EXIST
* IN FILE 150. FIELDS REMAIN ON SCREEN BUT ARE NOT SAVED.
*   MOVE #DOC-DEPEND      TO BENEFICIARY-V.DOC-DEPEND(#IDX)
*   MOVE #SEX-DEPEND     TO BENEFICIARY-V.SEX-DEPEND(#IDX)
    MOVE #NUM-DEPEND      TO BENEFICIARY-V.QTY-DEPEND
    UPDATE BENEFICIARY-V
* AUDIT TRAIL - TICKET 5510/2012
    MOVE 'AL'                    TO #AUD-ACTION
    MOVE 'BENF'                  TO #AUD-ENTITY
    MOVE #CPF-HOLDER-STR            TO #AUD-ID
    MOVE #CPF-HOLDER-STR            TO #AUD-CPF
    MOVE 'DEPENDENT ADDED'         TO #AUD-DESCR
    PERFORM WRITE-AUDIT
    END TRANSACTION
  END-FIND
  WRITE 'DEPENDENT ADDED - TOTAL:' #NUM-DEPEND
*
  INPUT 'ADD ANOTHER DEPENDENT? (S/N):' #COUNT
  IF #COUNT NE 'S'
    ESCAPE BOTTOM
  END-IF
END-REPEAT
*
WRITE 'PROCESSING COMPLETED'
*
* NORMAL EXIT - TICKET 6622/2011
ESCAPE BOTTOM
END-REPEAT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* CPF VALIDATION - STANDARD ROUTINE NT-SUPDE-014
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
INCLUDE CCVALCPF
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* AUDIT TRAIL - IN-TCU 63/2010 - TICKET 5510
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
INCLUDE CCAUDIT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* NATURAL ERROR HANDLING - TICKET 5511/2012
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  WRITE 'NATURAL ERROR' *ERROR-NR 'LINE' *ERROR-LINE
  WRITE 'PGM' *PROGRAM 'LIB' *LIBRARY-ID
  BACKOUT TRANSACTION
  TERMINATE 12
END-ERROR
*
END
